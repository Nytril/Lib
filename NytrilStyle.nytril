using Format;

//======================================================================

readonly namespace NytrilData {
      WebSite      = "www.nytril.com";
      SupportEMail = new Email("support@nytril.com");
  URL RedditSite   = new("www.reddit.com/r/nytril"),
      GitHubSite   = new URL("www.github.com/Nytril/Lib"),
      YouTubeSite  = new URL("www.youtube.com/@Nytril");
}

readonly namespace NytrilPalette {
  Color          Hyperlink      = #7D2AE8#,
                 EmailLink      = #0000C8#,
                 Logo1          = #4A6D9D#, // powder blue
                 Charcoal       = #505050#,
                 Logo2          = Logo1.Scale(75%),
                 LogoVideo      = Logo1,
                 LogoVideo2     = Logo2.Scale(80%),
                 Title          = Logo1.Scale(75%),
                 TagLine        = #C0A3B0#,
                 IconText       = TagLine,
                 Icon           = Logo1,
                 Arrow          = Title,
                 Bullet         = Title,
                 ChapterBack    = Color.GrayScale(90%),
                 ChapterFore    = Title,
                 SectionBack    = Logo1.Scale(70%),
                 TableTitleBack = Logo1,
                 TableTitleFore = Colors.White,
                 SourceBack     = Color.GrayScale(97%),
                 ListOdd        = Color.GrayScale(96%),
                 IconLine       = #DCC7AA#;
  RadialGradient IconBack       = SphericalFill(Logo1),
                 IconFore       = LightFill(Logo1);

  RadialGradient TitlePageBack = new(0.5, 0.5, 0.5, 0.5, 1.2, 1.2, [
    new(0.2, Logo1),
    new(1, Logo1.Scale(2))
  ]);

  RadialGradient LogoGradient = new(0.36, 0.54, 0.36, 0.54, 0.7, 0.7, [
    new(0.0, Logo1.Scale(2)),
    new(0.3, Logo1),
    new(1, Logo2)
  ]);

  RadialGradient SphericalFill(Color c) = new(0.25, 0.25, 0.25, 0.25, 0.75, 0.75,
    [new(0.2, c.Scale(1.1)), new(0.9, c.Scale(0.8))]
  );

  RadialGradient LightFill(Color c) = new(0.1, 0.1, 0.1, 0.1, 0.75, 0.75,
    [new(0.3, c.Scale(1.1)), new(0.9, c.Scale(0.9))]
  );

  VideoBack(in Size size) {
    if (size.Width > size.Height)
      return new RadialGradient(0.4, 0.7, 0.5, 0.5, 1, 1, [new(0.5, NytrilPalette.Logo2), new(1, #051229#)]);
    else
      return new LinearGradient(0.5, 0.0, 0.5, 1, [new(0.6, NytrilPalette.Logo2), new(1, #051229#)]);
  }
}

//======================================================================

readonly namespace NytrilStyle {
  PropText(Attribute prop, text) = Span {
    Span {
      TipAction: new Action(Actions.ToDocument, prop);
      text;
    };
    Space;
    prop.Prototype(true);
   };

  Formatter(Attribute prop) = Span {
    TextColor: #74531F#;
    TipAction: new Action(Actions.ToDocument, prop);
    prop.Name;
  };

  PropName(Attribute prop) = Span {
    TextColor: #5384BD#;
    TipAction: new Action(Actions.ToDocument, prop);
    prop.OperatorText ?? prop.Name;
  };

  Menu(name) = Span {
    name;
    TextColor: Colors.Green;
  };

  Function(Attribute prop, text) = Span {
    text;
    Space;
    "using the ";

    Span {
      TipAction: new Action(Actions.ToDocument, prop);
      prop.Name;
    };

    " function. ";
  };


  Operator(text, x)      = Span {text; Space; Span {TextColor: Colors.Blue; x}};
  Class(Attribute x)     = Span {x.Name; TipAction: x; TextColor: #2b91af#};
  NameSpace(Attribute s) = "{0} namespace "(s.Prototype);

  OpAttribute(Attribute prop) = Span {
    "using the ";
    PropName(prop);
     " operator.";
  };

  KW(Attribute prop) = Span {
    TipAction: prop;
    TextColor: Colors.Blue;
    prop.Name;
  };

  Keyword(Attribute prop) = Span {
    " using the keyword ";
    KW(prop);
  };

  OpText(x)  = Operator("using the operator", x);

  ArrayIndex = Operator("square brackets", "[]");

  StandardLogo = Shape(NytrilPalette.LogoGradient) {
    AppIcons.NytrilLogo;
  };

  LogoTight(size) = Canvas(null, size * 0.89) {
    Baseline: 93%;
    Shape(NytrilPalette.LogoGradient) {
      Y: -size*0.2;
      TextHeight: size;
      AppIcons.NytrilLogo;
    }
  };

  BugTight(size) = Canvas(null, size) {
    Shape(NytrilPalette.Logo1) {
      Y: -size*0.27;
      TextHeight: size;
      AppIcons.NytrilBug;
    }
  };

  SiteIcon(Icon icon) = Canvas {
    Baseline: 75%;
    Shape(NytrilPalette.IconFore, new(0.5, NytrilPalette.IconLine)) {
      icon;
    };
  };

  LogoText(text, size) = Canvas {
    HAlign: Center;
    TextColor: NytrilPalette.Logo2;
    Paragraph {
      Y: -size*0.2;
      TextHeight: size;
      NytrilStyle.StandardLogo;
    };
    if (text is valid) {
      Paragraph {
        Y: size*0.8;
        TextColor: NytrilPalette.IconText;
        TextHeight: size * 0.4;
        text;
      };
    }
  };

  EquationPar = Paragraph {
    SpaceBefore: 4pt;
    TextEquation: true;
    TextStacked: true;
  };

  HeaderRow = Row {
    Background: Colors.DarkBlue;
    TextColor: Colors.White;
  };

  ShowArraySpan(a) = Span {
    Begin: "[";
    End: "]";
    Separator: CommaSpace;
    a;
  };

  ShowArray(a) = HBox {
    Bracket: Brackets.Square;
    TextStacked: true;
    TextEquation: true;
    Separator: CommaSpace;
    a;
  };

  ListRow(i) = Row {
    if ((i mod 2) == 1)
      Background: NytrilPalette.ListOdd;
  };

  ShowMarker(marker) = HBox(null, null, BorderT(new(0, 5pt))) {marker};

  LinkSpan = Span {
    TextColor: NytrilPalette.Hyperlink;
  };

  TextLink(text, link) = LinkSpan {
    Action: new URL(link);
    Underline;
    text;
  };

  EmailLink(text, Email link) = LinkSpan {
    Action: link;
    Underline;
    text;
  };

  FormatBullet = ListBlock {
    ParAlignment: Justify;
    LeftIndent: 14pt;
    FirstIndent: -12pt;
    SpaceAfter: 4pt;
  };

  SubHeader = Paragraph {
    SpaceBefore:12pt;
    Bold;
    TextHeight: 120%;
  };

  CodeExample = TextBlock {
    FileFormat: IO.FileFormats.Nytril;
    ParBackground: NytrilPalette.SourceBack;
  };

  BlockBody = Paragraph {
    ParAlignment: Justify;
    FirstIndent: 8pt;
    SpaceAfter: 8pt;
  };

  Heading1 = Paragraph {
    SpaceAfter: 20pt;
    Bold;
    TextHeight: 32pt;
    ParAlignment: Center;
    ParBackground: NytrilPalette.ChapterBack;
    TextColor: NytrilPalette.ChapterFore;
    KeepWithNext: true;
  };

  Heading2 = Paragraph {
    TextHeight: 18pt;
    ParBackground: NytrilPalette.SectionBack;
    TextColor: NytrilPalette.SectionBack.TextCompliment;
    SpaceAfter: 8pt;
    KeepWithNext: true;
  };

  Heading3 = Paragraph {
    TextHeight: 14pt;
    SpaceAfter: 4pt;
    KeepWithNext: true;
  };

  CodeSelection(code, SourceSelectOptions options=null) {
    var selection;
    foreach (var c in code) {
      var s = SourceSelection(c, options);
      if (selection is null)
        selection = s;
      else
        selection = selection.Union(s);
    }
    return selection;
  }

  YouTubeArrow(URL url, height) = Canvas(height * 1.4, height) {
    HAlign: Center;
    VAlign: Center;
    BorderRadius: 3;
    Background: #FF0033#;
    TextColor: Colors.White;
    TextHeight: height*0.85;
    TextOffset: 0.5;
    Icons.play_arrow;
    Baseline: 90%;
    TipAction: url;
  };
}

//======================================================================

NytrilGlyphs.CheckMark(height, fill=Colors.Black, line=null, ratio=1.2) = Canvas(height * ratio, height) {
  Baseline: 85%;

  Shape(fill, line) {
    ClosedPath(1%, 50%) {
      CurveTo(new(0, 48%), new(18%, 40%), new(20%, 43%));        // Upper edge of the short arm
      CurveTo(new(25%, 47%), new(33%, 58%), new(36%, 69%));      // Curve down into the inside corner
      CurveTo(new(53%, 40%), new(75%, 17%), new(99%, 5%));       // Upper edge of the long sweeping arm
      CurveTo(new(97%, 6%), new(87%, 14%), new(85%, 17%));       // Sharp pointed tip
      CurveTo(new(63%, 39%), new(48%, 71%), new(37%, 98%));      // Lower edge of the long arm
      CurveTo(new(35%, 100%), new(34%, 100%), new(32%, 98%));    // Rounded bottom point
      CurveTo(new(29%, 94%), new(14%, 54%), new(1%, 50%));       // Lower edge of the short arm
    };
  };
};
//====================================================================================

NytrilGlyphs.QuestionMark(height, fill=Colors.Black, line=null, ratio=0.53) = Canvas(height * ratio, height) {
  Baseline: 85%;

  Shape(fill, line) {
  ClosedPath(11.6%, 18.5%) {
    CurveTo(new(11%, 9%), new(29%, 1.5%), new(49.5%, 0.6%));
    CurveTo(new(55%, 0.5%), new(68%, 0%), new(79.5%, 3.5%));

    CurveTo(new(88.5%, 5.5%), new(108%, 16.5%), new(92%, 31%));
    CurveTo(new(87%, 34.5%), new(85%, 36.5%), new(69.3%, 42%));

    CurveTo(new(68.5%, 42.5%), new(54.5%, 46.5%), new(54.1%, 54.5%));
    CurveTo(new(54%, 55.5%), new(53.6%, 58.5%), new(53.8%, 64%));

    CurveTo(new(53.8%, 64.3%), new(53%, 65.5%), new(48%, 65.1%));      //bottom right corner
    CurveTo(new(46.5%, 65%), new(45.7%, 64.5%), new(45.5%, 64%));      //bottom left corner

    CurveTo(new(45.6%, 58.5%), new(45.2%, 53.5%), new(46.7%, 50.5%));
    CurveTo(new(48%, 46.9%), new(54%, 40.3%), new(63%, 36.3%));

    CurveTo(new(69%, 33.5%), new(85.5%, 25%), new(71.5%, 10.5%));
    CurveTo(new(68.8%, 8.5%), new(63%, 2.5%), new(40%, 5.9%));

    CurveTo(new(35%, 6.7%), new(30%, 9%), new(29.2%, 10.5%));
    CurveTo(new(28%, 12%), new(28.8%, 14.5%), new(30%, 15.5%));

    CurveTo(new(31%, 15.8%), new(35.5%, 21.6%), new(24.5%, 23.3%));
    CurveTo(new(23%, 23.3%), new(13%, 24.5%), new(11.6%, 18.5%));
  };

  EllipsePath(new(new(36%, 75.5%), new(27%, 14%)));
  };
};
//====================================================================================

NytrilGlyphs.ProductMachine(height, lineColor=Colors.Black, ratio=1.35) = Canvas(height * ratio, height) {
  Baseline: 90%;

  var line = new Stroke(3pt, lineColor, LineStyles.Solid, LineCaps.Round, LineJoins.Round);

  Shape(null, line) {                                                  // Base
    ClosedPath(13%, 87%) {
      LineTo(87%, 87%);
      LineTo(87%, 95%);
      LineTo(13%, 95%);
      LineTo(13%, 87%);
    };
  };

  Shape(null, line) {                                                  // Left support
    OpenPath(29%, 77%) {
      LineTo(29%, 87%);
      LineTo(39%, 87%);
      LineTo(39%, 77%);
    };
  };

  Shape(null, line) {                                                 // Right support
    OpenPath(70%, 77%) {
      LineTo(70%, 87%);
      LineTo(80%, 87%);
      LineTo(80%, 77%);
    };
  };

  Shape(null, line) {                                                 // Left rear rounded housing
    ClosedPath(20%, 40%) {
      CurveTo(new(14%, 40%), new(10%, 45%), new(10%, 53%));
      LineTo(10%, 68%);
      CurveTo(new(10%, 76%), new(14%, 80%), new(20%, 80%));
      LineTo(25%, 80%);
      LineTo(25%, 40%);
      LineTo(20%, 40%);
    };
  };

  Shape(null, line) {                                                // Main motor housing
    ClosedPath(25%, 40%) {
      CurveTo(new(25%, 37%), new(27%, 36%), new(30%, 36%));
      LineTo(55%, 36%);
      CurveTo(new(58%, 36%), new(60%, 38%), new(60%, 41%));
      LineTo(60%, 75%);
      CurveTo(new(60%, 78%), new(58%, 80%), new(55%, 80%));
      LineTo(30%, 80%);
      CurveTo(new(27%, 80%), new(25%, 78%), new(25%, 75%));
      LineTo(25%, 40%);
    };
  };

  Shape(null, line) {                                                // Small box top of motor
    ClosedPath(31%, 29%) {
      CurveTo(new(31%, 27%), new(32%, 26%), new(34%, 26%));
      LineTo(49%, 26%);
      CurveTo(new(51%, 26%), new(52%, 27%), new(52%, 29%));
      LineTo(52%, 36%);
      LineTo(31%, 36%);
      LineTo(31%, 29%);
    };
  };

  Shape(null, line) {                                                // Connection between motor and right housing
    ClosedPath(60%, 45%) {
      LineTo(68%, 45%);
      LineTo(68%, 72%);
      LineTo(60%, 72%);
      LineTo(60%, 45%);
    };
  };

  Shape(null, line) {                                                // Right square housing
    ClosedPath(68%, 39%) {
      CurveTo(new(68%, 36%), new(70%, 35%), new(73%, 35%));
      LineTo(84%, 35%);
      CurveTo(new(87%, 35%), new(89%, 37%), new(89%, 40%));
      LineTo(89%, 75%);
      CurveTo(new(89%, 78%), new(87%, 80%), new(84%, 80%));
      LineTo(73%, 80%);
      CurveTo(new(70%, 80%), new(68%, 78%), new(68%, 75%));
      LineTo(68%, 39%);
    };
  };

  Shape(lineColor) {                                                 // Four bolt heads
    EllipsePath(new(new(73%, 42%), new(2.5%, 2.5%)));
    EllipsePath(new(new(83%, 42%), new(2.5%, 2.5%)));
    EllipsePath(new(new(73%, 69%), new(2.5%, 2.5%)));
    EllipsePath(new(new(83%, 69%), new(2.5%, 2.5%)));
  };

  Shape(null, line) {                                                // Vertical risers to upper tank
    OpenPath(75%, 35%) {
      LineTo(75%, 27%);
    };
    OpenPath(80%, 35%) {
      LineTo(80%, 27%);
    };
  };

  Shape(null, line) {                                               // Upper tank
    ClosedPath(69%, 7%) {
      CurveTo(new(69%, 4%), new(71%, 3%), new(74%, 3%));
      LineTo(88%, 3%);
      CurveTo(new(91%, 3%), new(93%, 5%), new(93%, 8%));
      LineTo(93%, 24%);
      CurveTo(new(93%, 27%), new(91%, 29%), new(88%, 29%));
      LineTo(74%, 29%);
      CurveTo(new(71%, 29%), new(69%, 27%), new(69%, 24%));
      LineTo(69%, 7%);
    };

    OpenPath(69%, 16%) {
      LineTo(93%, 16%);
    };
  };

  Shape(null, line) {                                              // Pipe from motor top to tank
    OpenPath(41%, 26%) {
      LineTo(41%, 16%);
      CurveTo(new(41%, 12%), new(44%, 11%), new(47%, 11%));
      LineTo(65%, 11%);
    };
  };

  Shape(null, line) {                                              // Small connector before tank
    ClosedPath(65%, 8%) {
      LineTo(69%, 8%);
      LineTo(69%, 19%);
      LineTo(65%, 19%);
      LineTo(65%, 8%);
    };
  };
};
//====================================================================================

NytrilGlyphs.ProductInfoSource(height, lineColor=Colors.Black, ratio=1.0) = Canvas(height * ratio, height) {
  Baseline: 90%;

  var line = new Stroke(3pt, lineColor, LineStyles.Solid, LineCaps.Round, LineJoins.Round);

  Shape(null, line) {                                            // Outer source container
    ClosedPath(16%, 10%) {
      CurveTo(new(16%, 7%), new(18%, 6%), new(21%, 6%));
      LineTo(79%, 6%);
      CurveTo(new(82%, 6%), new(84%, 8%), new(84%, 11%));
      LineTo(84%, 89%);
      CurveTo(new(84%, 92%), new(82%, 94%), new(79%, 94%));
      LineTo(21%, 94%);
      CurveTo(new(18%, 94%), new(16%, 92%), new(16%, 89%));
      LineTo(16%, 10%);
    };
  };

  Shape(lineColor) {                                            // Image / visual element
    ClosedPath(28%, 24%) {
      LineTo(42%, 24%);
      LineTo(42%, 42%);
      LineTo(28%, 42%);
      LineTo(28%, 24%);
    };
  };

  Shape(null, line) {                                           // Product title / description lines
    OpenPath(50%, 27%) {
      LineTo(72%, 27%);
    };

    OpenPath(50%, 36%) {
      LineTo(68%, 36%);
    };

    OpenPath(28%, 54%) {
      LineTo(72%, 54%);
    };

    OpenPath(28%, 64%) {
      LineTo(63%, 64%);
    };
  };

  Shape(null, line) {                                           // Small structured/specification symbol
    ClosedPath(66%, 70%) {
      LineTo(73%, 82%);
      LineTo(59%, 82%);
      LineTo(66%, 70%);
    };
  };

  Shape(null, line) {                                           // Final short data line
    OpenPath(28%, 78%) {
      LineTo(51%, 78%);
    };
  };
};
