using LinkTypes, CitationLib;

//=========================================================================

namespace CitationLib {
  State USState(id, name, abreviation, GeoCoordinate c=null) = new(id, name, abreviation, c) {
    Link to Countries.USA;
  };

  StreetAddress(address, city, zip) = Link to (new PostalAddress(address, zip) {Link to city});
}

