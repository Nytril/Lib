ShowClosedPath = Canvas(LessonExample.FontHeight*10, LessonExample.FontHeight*10) {
  Shape(Colors.Green) {
    ClosedPath(10%, 10%) {
      LineTo(90%, 90%);
      LineTo(10%, 90%);
      // Line to origin is added automatically
    };
  };
};

readonly LessonExample Content.ClosedPathEx = new(#29d4d668-8ed4-4e84-86f1-b119d8393b19#, "Closed paths") {
  Text: Span {
    "Use the {0} formatter to create a closed, fillable path. "(NytrilStyle.Formatter(attribute ClosedPath));
    "A final line segment to the origin of the path is automatically added to the end of the path. ";
  };
  Code: [attribute ShowClosedPath];
  Sel: new(2, 4, 10);
};

//======================================================================

CutoutFigure = Canvas(LessonExample.FontHeight*10, LessonExample.FontHeight*10) {
  Shape(Colors.Green) {
    ClosedPath(10%, 10%) {
      LineTo(90%, 90%);
      LineTo(10%, 90%);
    };
    EllipsePath(new(new(15%, 40%), new(20%))); // Cutout
  };
};

readonly LessonExample Content.TrianglePathEx = new(#ac17d815-db96-4b45-8555-d5da7a7236f6#, "Cutouts") {
  Text: "Adding a second closed path in the same shape will 'cut a hole' in the first shape. ";
  Code: [attribute CutoutFigure];
  Sel: new(6, 4, 11);
};

//======================================================================

Saw = Canvas(90%, LessonExample.FontHeight*3) {
  Shape(Colors.Silver) {
    ClosedPath(0) {
      foreach (var x in 0%..100% step 10%) {
        LineTo(x, 100%);
        LineTo(x, 50%);
      }
      LineTo(100%, 0);
    };
  };
};

readonly LessonExample Content.RepeatedPatternsEx = new(#20b51a63-1ff6-4392-b75e-6feb33c85aaa#, "Repeated segments") {
  Text: "Use a loop to make a shape with a repeated set of line segments. ";
  Code: [attribute Saw];
  Sel: new(3, 6, 36);
};

//======================================================================

NGon(radius, n) = VBox(radius*2+6) {
  HAlign: Center;
  Span {TextColor: Colors.Red; n};

  Shape(Colors.Yellow, 3) {
    PolygonPath(new(0, radius*2), n, -90 degrees);
  };
};

NGons = HBox {
  VAlign: Top;
  var sep = LessonExample.FontHeight * 0.5;
  Separation: sep;
  NGon(ExtentWidth / 16 - sep, each 3..10);
};

readonly LessonExample Content.PolygonsEx = new(#c0339f84-f0f6-4c5c-a7c7-5894ec76a584#, "PolygonPath") {
  Text: NytrilStyle.Function(attribute PolygonPath, "Make a regular n-sided polygon");
  Code: [attribute NGon, attribute NGons];
  Sel: new(5, 4, 11);
  Options: NoShort;
};

//======================================================================

CheckMark = Canvas(LessonExample.FontHeight*7, LessonExample.FontHeight*5) {
  Shape(Colors.LightGreen, Colors.DarkGreen) {
    ClosedPath(1%, 50%) {
      QuadTo(new(9%, 44%), new(20%, 43%));
      QuadTo(new(31%, 52%), new(36%, 69%));
      QuadTo(new(60%, 28%), new(99%, 5%));
      QuadTo(new(55%, 39%), new(36%, 96%));
      QuadTo(new(34.5%, 100%), new(33%, 96%));
      QuadTo(new(21%, 60%), new(1%, 50%));
    };
  };
};

readonly LessonExample Content.CombinedFigureEx = new(#2cdbd9f3-d45f-47e5-b748-8dc858b26c51#, "QuadTo formatter") {
  Text: "Make a quadratic curve with two endpoints and a control point using the {0} function. "(NytrilStyle.Formatter(attribute QuadTo));
  Code: [attribute CheckMark];
  Sel: new(3, 6, 6);
};

//======================================================================

Dots(Point[] points) = {
  foreach (var p in points) {
    Shape(each0 > 0 and each1 < points.Length ? Colors.Blue : Colors.Green) {
      EllipsePath(new(p-1, new(2)));
    };
  }
};

QuadExamples = [
  [10,  10,  50,  20,  50,  10],
  [70,  10,  90,  30,  120, 10],
  [140, 10,  130, 20,  180, 10],
  [10,  60,  20,  50,  50,  60],
  [70,  60,  80,  40,  110, 60],
  [140, 60,  180, 40,  180, 60],
];

ShowQAll(Point[] p) = Canvas {
  Transform: Transform.Scale(ExtentWidth * 0.004);
  TransformFit: true;
  Shape(null, new(1, 80%)) {
    OpenPath(p[0]) {
      p[1]; //Control Point
    };
    OpenPath(p[1]) {
      p[2]; //Right End Point
    };
  };
  Shape(null, new(1, Colors.Red)) {
    OpenPath(p[0]) {
      QuadTo(p[1], p[2]);
    };
  };
  Dots(p);
};

ShowQExample(e) = ShowQAll([new(e[0], e[1]), new(e[2], e[3]), new(e[4], e[5])]);

ShowQuads = Canvas {
  Margin: LineSize;
  ShowQExample(each QuadExamples);
};

readonly LessonExample Content.QuadraticExamplesEx = new(#d6f69534-6e22-4dc7-a169-1c769abb2dce#, "Quadratic Examples") {
  Text: "Here are some examples of how the position of the control point affects the shape of a quadratic curve. ";
  Code: [attribute ShowQuads];
};

