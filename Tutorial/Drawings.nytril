using Format;
//======================================================================

namespace Chapters.Formatting.Sections.Drawings;

readonly TutorialLesson Lesson = new(#7d95b214-b935-43d5-861d-b20bef12c39d#, "Drawings", "Drawings", "drw", "https://youtu.be/iy-4S5-Jlk8") {
  Description: Span {
    "Create drawings using canvases and shapes. ";
    "You can combine lines and curves with fill patterns using a variety of colors and styles. ";
  };
};

//======================================================================

LineSize = LessonExample.FontHeight * 0.5;
readonly Stroke Stroke1 = new(LineSize);

LineSeg = Canvas(ExtentWidth * 50%, ExtentWidth * 10%) {
  Margin: LineSize;
  Shape(null, Stroke1) {
    OpenPath(0, 0) {
      LineTo(33%, 100%);
    };
  };
};

readonly LessonExample Content.SimpleLineShapeEx = new(#a2f85e0f-46bb-4d96-9b85-67280596a379#, "Shapes") {
  Text: Span {
    "A {0} formatter holds a group of open or closed paths. "(NytrilStyle.Formatter(attribute Shape));
    "Here the path is a simple line segment. ";
  };
  Code: [attribute LineSize, attribute LineSeg];
  Sel: new(5, 2, 5);
};

//======================================================================

ZigZag(Stroke stroke) = Canvas(ExtentWidth * 50%, ExtentWidth * 10%) {
  Margin: LineSize;
  Shape(null, stroke) {
    OpenPath(0, 0) {
      LineTo(33%, 100%);
      LineTo(66%, 0);
      LineTo(100%, 100%);
    }
  };
};

BlackZigZag = ZigZag(Stroke1);

readonly LessonExample Content.OpenPathsEx = new(#bd5d2dae-3738-488e-856c-b1262434f7ff#, "Open Paths") {
  Text: Span {
    "Make an open line path using the {0} formatter"(NytrilStyle.Formatter(attribute OpenPath));
    "The arguments are the starting point of the shape. ";
  };
  Code: [attribute  ZigZag, attribute BlackZigZag];
  Sel: new(3, 4, 8);
};

//======================================================================

Stroke LS1 = new(LineSize, Colors.Red);

Line1 = ZigZag(LS1);

readonly LessonExample Content.ColorOptionsEx = new(#6f481e80-d600-4ceb-a607-a81dd5fb5a7a#, "Color options") {
  Text: "Change the color of the line with the 2nd parameter of the {0} constructor. "(NytrilStyle.Class(attribute Stroke));
  Code: [attribute LS1, attribute Line1];
  Sel: new(0, 27, 10);
  Options: NoShort;
};

//======================================================================

Stroke LS2 = new(LineSize, Colors.Red, Dotted);

Line2 = ZigZag(LS2);

readonly LessonExample Content.LineStyleOptionsEx = new(#5939574f-45a5-4609-8a26-097197175f91#, "Line Styles") {
  Text: "Change the style of the line using LineStyles, the 3rd parameter of the {0} constructor. "(NytrilStyle.Class(attribute Stroke));
  Code: [attribute LS2, attribute Line2];
  Sel: new(0, 39, 6);
  Options: NoShort;
};

//======================================================================

TwoColumTable = Table(null, PadAll(LineSize * 0.5) + PadR(LineSize), [Column.Fit(ExtentWidth), Column.Fit(ExtentWidth)]) {
  VAlign: Center;
};

DrawLineStyle(LineStyles linestyle) = Canvas(40%, LessonExample.FontHeight) {
  Shape(null, new(LineSize, Colors.Black, linestyle, Flat)) {
    OpenPath(0, 50%) {LineTo(100%, 50%)};
  };
};

LineStyleList = TwoColumTable {
  foreach (var style in LineStyles)
    Row {style.Name; DrawLineStyle(style)};
};

readonly LessonExample Content.LineStylesListEx = new(#c26e89ec-eacc-4ede-b0d4-b836fb67a2f4#, "Line Style Gallery") {
  Text: "Use a loop to enumerate the different {0} options. "(NytrilStyle.Class(attribute LineStyles));
  Code: [attribute DrawLineStyle, attribute LineStyleList];
  Sel: new(7, 2, 33);
  Options: NoShort;
};

//======================================================================

Stroke LS3 = new(LineSize, Colors.Red, Dotted, Round);

Line3 = ZigZag(LS3);

readonly LessonExample Content.LineCapsOptionsEx = new(#1589afe1-f9c6-4234-a8f5-4c071c740665#, "Line Caps") {
  Text: "Change the LineCap style using the 4th parameter of the {0} constructor. "(NytrilStyle.Class(attribute Stroke));
  Code: [attribute LS3, attribute Line3];
  Sel: new(0, 47, 5);
  Options: NoShort;
};

//======================================================================

DrawLineCap(LineCaps cap) = Canvas(10%, LessonExample.FontHeight*2) {
  Shape(null, new(LineSize*2, Colors.Black, LineStyles.Solid, cap)) {
    OpenPath(0, 50%) { LineTo(100%, 50%);}
  };
  Shape(null, new(LineSize*0.25, Colors.Red, LineStyles.Solid, cap)) {
    OpenPath(0, 50%) {LineTo(100%, 50%);}
  };
};

LineCapTable = TwoColumTable {
  foreach (var cap in LineCaps)
    Row {cap.Name; DrawLineCap(cap)};
};

readonly LessonExample Content.LineCapListEx = new(#c64bfe90-faaf-46fa-a2d9-b63759553a93#, "Line Cap Gallery") {
  Text: "Iterate over the different {0} options. "(NytrilStyle.Class(attribute LineCaps));
  Code: [attribute DrawLineCap, attribute LineCapTable];
  Sel: new(10, 2, 29);
  Options: NoShort;
};

//======================================================================

Stroke LS4 = new(LineSize*2, Colors.Blue, Solid, Flat, Round);
Line4 = ZigZag(LS4);

readonly LessonExample Content.LineJoinEx = new(#df6cf766-9061-454e-8d61-fa84d3de769c#, "Line Joins") {
  Text: "Change the LineJoin style using the 5th parameter of the {0} constructor. "(NytrilStyle.Class(attribute Stroke));
  Code: [attribute LS4, attribute Line4];
  Sel: new(0, 55, 5);
  Options: NoShort;
};

//======================================================================

DrawLineJoin(LineJoins linejoin) = Canvas(7%, LessonExample.FontHeight*2) {
  VAlign: Center;
  Shape(null, new(LineSize, Colors.Black, Solid, Flat, linejoin)) {
    OpenPath(0) {LineTo(50%, 70%); LineTo(100%, 0)};
  };
};

LineJoinTable = TwoColumTable {
  foreach (var linejoin in LineJoins)
    Row {linejoin.Name; DrawLineJoin(linejoin)};
};

readonly LessonExample Content.LineJoinListEx = new(#496a5865-04d8-4047-8f14-c7b591d8a64e#, "Line Join Gallery") {
  Text: "Loop over the different {0} options. "(NytrilStyle.Class(attribute LineJoins));
  Code: [attribute DrawLineJoin, attribute LineJoinTable];
  Sel: new(2, 55, 8);
  Options: NoShort;
};

//======================================================================

DrawMiterJoin(miter) = Canvas(6%, LessonExample.FontHeight*1.5) {
  VAlign: Center;
  Shape(null, new(LineSize*0.25, Colors.Black, Solid, Flat, Miter, miter)) {
    OpenPath(0, 30%) {LineTo(100%, 50%); LineTo(0, 70%)};
  };
};

MiterTable = TwoColumTable {
  Row {Bold; "Miter Limit"; "Effect"};
  foreach (var m in [50, 1])
    Row {TextDigits: 0; m; DrawMiterJoin(m)};
};

readonly LessonExample Content.MiterListEx = new(#18d90f7f-7bdf-47ca-aae0-9efb19e70370#, "Miter limit") {
  Text: "Use the miterlimit parameter to limit the ratio of the extent of a miter join to the stroke size (default: 4.0).";
  Code: [attribute DrawMiterJoin, attribute MiterTable];
  Sel: new(2, 67, 5);
  Options: NoShort;
};

