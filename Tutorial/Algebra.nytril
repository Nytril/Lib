  Text: NytrilStyle.Function(attribute Math.Max, "Get the maximum of two values");
  Code: [attribute CheckMax1, attribute CheckMax2];
  Show: [CheckMax1, CheckMax2];
};

//======================================================================

CheckAbs1  = Math.Abs(5);
CheckAbs2  = Math.Abs(-10);
CheckAbs3  = Math.Abs(-x);

readonly LessonExample Content.AbsFunctionEx = new(#230b4d2b-1977-437b-8f4f-9af7ae6cd29d#) {
  Text: NytrilStyle.Function(attribute Math.Abs, "Get the absolute value of a number");
  Code: [attribute CheckAbs1, attribute CheckAbs2, attribute CheckAbs3];
  Show: [CheckAbs1, CheckAbs2, CheckAbs3];
};

//======================================================================

CheckLog1  = {TextDigits: 5} Math.Log(5.345);
CheckLog2  = Math.Log(Math.E);
CheckLog3  = Math.Log(Math.E * 2);
CheckLog4  = Math.Log(1000, 10);
CheckLog5  = Math.Log(16, 2);

readonly LessonExample Content.LogFunctionEx = new(#cc198484-ebe9-42d6-845b-933ccf4c903c#) {
  Text: NytrilStyle.Function(attribute Math.Log, "Get the logarithm of a number");
  Code: [attribute CheckLog1, attribute CheckLog2, attribute CheckLog3, attribute CheckLog4, attribute CheckLog5];
  Show: [CheckLog1, CheckLog2, CheckLog3, CheckLog4, CheckLog5];
};

//======================================================================

FactArray = Span {Separator: ", "; Math.Factorial(each 1..6)};

readonly LessonExample Content.FactorialFunctionEx = new(#db69a26a-58fb-449e-aa43-99417a268094#) {
  Text: NytrilStyle.Function(attribute Math.Factorial, "Get the factorial of a number");
