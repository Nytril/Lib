};

//======================================================================

x          = Symbol("x");
y          = Symbol("y");
a          = Symbol("a");
b          = Symbol("b");
c          = Symbol("c");
Polynomial = a x^2 + b x + c;

readonly LessonExample Content.AlgebraEx = new(#4f49bde2-9ed6-47fa-a3b6-b6fe161a5474#) {
  Text: "Symbols obey the rules of algebra when combined with other symbols and numbers. ";
  Code: [attribute Polynomial];
};

//======================================================================

AddX = 2 x + 5 x + 3;

readonly LessonExample Content.Symbols= new(#0d38b5c5-b95a-4d4c-9d59-d2dd1a300f6e#, "Algebra") {
  Text: "Basic algebra is performed automatically when symbols are multipled or added. ";
  Code: [attribute AddX];
};

//======================================================================

CompareEquations(f) = Paragraph(null, [1"]) {
  f;
  Tab;
  "=> ";
  f.GetExpandedTerms;
};

CompareAll = [
  CompareEquations(14),
  CompareEquations((3 x + y) * x * y),
  CompareEquations(2 * (6 + y) * y),
  CompareEquations((3 x + 1) * 1 * x),
];

readonly LessonExample Content.ExpressionEx = new(#79b06a51-7abb-4cfd-937b-90d80e2aced7#) {
  Text: NytrilStyle.Function(attribute(object.GetExpandedTerms), "Combined terms can be expanded");
  Code: [attribute CompareAll];
};

//======================================================================

ThreeX     = 3 x;
g          = 9.8 meters per second^2;
Palindrome = "was it " "a car " "or a cat I saw";

readonly LessonExample Content.Affinity = new(#69c41efc-cddb-40bf-99e9-4bd8dba899ea#, "Operand Affinity") {
  Text: "The operator between common types can be ommited in simple expressions";
  Code: [attribute ThreeX, attribute g, attribute Palindrome];
  Show: [ThreeX, g, Palindrome];
};

