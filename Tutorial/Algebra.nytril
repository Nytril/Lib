Number = 1 + 3;
Sum    = Number + x;

readonly LessonExample Content.AdditionEx = new(#2c6d0c61-a357-4d92-86c0-7c736f8a00e5#) {
  Text: "Addition is carried out {0}"(NytrilStyle.OpAttribute(attribute +));
  Code: [attribute Number, attribute Sum];
};

 //======================================================================

