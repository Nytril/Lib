Power = 4^2;

readonly LessonExample Content.RaisePowerEx = new(#bf51547c-3d5a-4a63-b4d7-7c114286a461#) {
  Text: "A value can be raised to a power {0}"(NytrilStyle.OpAttribute(attribute ^));
