  TextGroup: true;
  8912345.67;
};

readonly LessonExample Content.IntegerGroupCultureEx = new(#f25136df-2214-4c31-875f-e3c47a059fd4#, "Culture Settings") {
  Text: Span {"Use the "; NytrilStyle.PropName(attribute FormatProperties.TextCulture); " property to ensure the formatting is correct for the intended readership. "};
  Code: [attribute IntegerGroupCulture];
  Sel: new(1, 2, 11);
  Options: NoShort;
};

