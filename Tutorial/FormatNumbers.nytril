};

//=====================================================================

SignificantDigits = Block {
  TextSignificant: true;
  TextDigits: 3;          // 3 significant figures
  4325.1245;
  5.4193;
  0.0006427;
  1.215e10;
  1.2e-10;
};

readonly LessonExample Content.SignificantDigitsEx = new(#71cae461-39b6-4fb3-bf62-b44f6893892f#, "Significant Figures") {
  Text: Span {"Set "; NytrilStyle.PropName(attribute FormatProperties.TextSignificant); " to true, to make TextDigits refer to 'significant' figures, rather than decimal digits. "};
  Code: [attribute SignificantDigits];
  Sel: new(1, 0, 40);
};

