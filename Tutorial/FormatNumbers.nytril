readonly AlignedPar = Paragraph(null, [new(5%, Decimal)]);

AlignedPars = Block {
  AlignedPar {Tab; 1.2   };
  AlignedPar {Tab; 123.99};
  AlignedPar {Tab; 0.5544};
};

readonly LessonExample Content.AlignedParagraphEx = new(#a8fe5556-6490-41cd-8a4f-c47a2d521109#, "Decimal Tab Stops") {
  Text: "You can use a custom tab stop in a paragraph to align numbers on decimal point. ";
  Code: [attribute AlignedPar, attribute AlignedPars];
  Sel: new(0, 47, 7);
  Options: NoShort;
};

