IntegerBinary = Span {
  TextRadix: 2;
  127;
};

readonly LessonExample Content.IntegerBinaryEx = new(#b864e2c4-306d-4104-a87a-51eab691c5a0#, "Binary Format") {
  Text: Span {"To format a number in binary, use 2 as the "; NytrilStyle.PropName(attribute FormatProperties.TextRadix); DotSpace};
  Code: [attribute IntegerBinary];
  Sel: new(1, 2, 12);
  Options: NoShort;
};

//=====================================================================

IntegerHexadecimal4 = Block {
  TextRadix: 16;
  TextNumPadding: 4;
  4;
  27;
  12245;
};

readonly LessonExample Content.IntegerHexadecimal4Ex = new(#ca35c357-b2ab-4609-87ad-44d4aa3c2b33#, "Number Zero-Padding") {
  Text: Span {"Use the "; NytrilStyle.PropName(attribute FormatProperties.TextNumPadding); " property to set the minimum width of a number. This is handy for text sorting and creating tables with aligned numbers. "};
  Code: [attribute IntegerHexadecimal4];
  Sel: new(2, 2, 17);
  Options: NoShort;
};

