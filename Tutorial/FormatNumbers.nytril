  Text: Span {"Notice that the "; NytrilStyle.PropName(attribute FormatProperties.TextSignificant); " property controls the total number of significant figures with scientific notation. "};
  Code: [attribute ScientificNotationSig];
  Sel: new(2, 0, 40);
  Options: NoShort;
};

