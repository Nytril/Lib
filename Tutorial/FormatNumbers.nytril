using Format;

namespace Chapters.Formatting.Sections.FormatNumbers;

readonly TutorialLesson Lesson = new(#09a38d79-dde4-4de4-b7cd-ab94c76e050a#, "Number Formatting", "FormatNumbers", "num", "youtu.be/eiBMFdcH5Y0") {
  Description: Span {
    "Use a large selection of different number formatting properties to add data to your documents. ";
  };
};

//=====================================================================

IntegerLiteral = Span {
  42;
};

readonly LessonExample Content.IntegerLiteralEx = new(#9ef4a301-41f6-4524-aeea-6f9e7adf0fd7#, "int Literals") {
  Text: "To show an integer, simply include the literal number as one of the elements inside a span. ";
  Code: [attribute IntegerLiteral];
  Sel: new(1, 2, 2);
};

//=====================================================================

X(i) = i * i + 3;

IntegerVariable = Span {
  "The output of X(5) is "; X(5);
};

readonly LessonExample Content.IntegerVariableEx = new(#199fba86-53d1-455d-a0d5-91d3e6b6546c#, "Functions and Variables with int Values") {
  Text: "Functions that return integers or variables containing integers, like the function X shown here, will be formatted the same way. ";
  Code: [attribute X, attribute IntegerVariable];
  Sel: new(0, 0, 1);
};

