IntegerHexadecimal = Span {
  TextRadix: 16;
  129579;
};

readonly LessonExample Content.IntegerHexadecimalEx = new(#3bfc9e3d-b944-468c-a3c1-c29370048e7e#, "Hexadecimal Format") {
  Text: Span {"To format an integer in hexadecimal, change the "; NytrilStyle.PropName(attribute FormatProperties.TextRadix); " to 16. "};
  Code: [attribute IntegerHexadecimal];
  Sel: new(1, 2, 13);
};

//=====================================================================

IntegerHexadecimalUpper = Span {
  TextRadix: 16;
  TextCase: AllUpper;
  671277;
};

readonly LessonExample Content.IntegerHexadecimalUpperEx = new(#c08506b6-523c-413b-baa0-7ef624d13b60#, "Uppercase Hex Format") {
  Text: Span {"To have the hex digits shown in upper-case, change the "; NytrilStyle.PropName(attribute FormatProperties.TextCase); " property to AllUpper. "};
  Code: [attribute IntegerHexadecimalUpper];
  Sel: new(2, 2, 13);
  Options: NoShort;
};

