//======================================================================

class ValueClass {
  var int Value;

  Constructor(int value) {
    Value = value;
  }

  override GetLayoutSpan = Value;
}

readonly ValueClass[] Structures = [
  new(3),
  new(5),
  new(2),
  new(0),
  new(1),
];

int CompareStructure(ValueClass a, ValueClass b) = a.Value.Compare(b.Value);

readonly SortedStructures = Structures.ToSortedArray(false, @CompareStructure);

ShowStructureArray = Paragraph {
  Separator: ", ";
  SortedStructures;
};

readonly LessonExample Content.SortWithFunctionEx = new(#e1560903-8ed2-44e0-af24-bba29b0a87fd#) {
  Text : "Use a comparison function to sort complex structures";
  Code : [attribute Structures, attribute ShowStructureArray];
};

//======================================================================

x           = Symbol("x");
y           = Symbol("y");
a           = Symbol("a");
MathObjects = [2, 1 over 3, Symbolic.PI, Symbolic.Sqrt(x^2 + y^2) / a];

readonly LessonExample Content.ArrayContainsAllEx = new(#58b6dc6a-7279-472c-9582-8a021b8db22d#) {
  Text      : "An array can contain data of all types, including variables and formulas";
  CodeArray : [attribute MathObjects];
};

//======================================================================

GrabBag = ["A simple sentence", Numbers, MathObjects];

readonly LessonExample Content.ArrayOfArraysEx = new(#89094aec-1765-4b6c-a3f4-93fbe3352b4b#) {
  Text      : "An array can include other arrays";
  CodeArray : [attribute GrabBag];
};

//======================================================================

LargeArray = Numbers + MathObjects;

readonly LessonExample Content.ArrayBigEx = new(#d4a6f41f-4c72-4fc6-baec-780006c8fdae#) {
  Text      : "The contents of two arrays can be joined together to make a larger array {0}"(NytrilStyle.OpAttribute(attribute +));
  CodeArray : [attribute LargeArray];
};

//======================================================================

PlusOne = each MathObjects + 1;

readonly LessonExample Content.EachPlus1Ex = new(#6c44bdd6-23bd-4fee-8abe-61db699eca8b#) {
  Text      : "You can create another array which contains the result of the operation performed on each item in the array {0}"(NytrilStyle.OpAttribute(attribute each));
  CodeArray : [attribute PlusOne];
};

//======================================================================

EachCompound = (each ((each MathObjects) * a)) ^2;

readonly LessonExample Content.EachSquareEx = new(#c709cfe3-85ea-4d82-b504-2718e7b637ed#) {
  Text      : "This works for all operators and can be daisy-chained to apply to more than one operation";
  CodeArray : [attribute EachCompound];
};

//======================================================================

CubeFunction(value) = value^3;
EachCubed           = HBox {TextEquation: true; Separator: CommaSpace; CubeFunction(each MathObjects);};

readonly LessonExample Content.EachCubeEx = new(#39c01f98-90da-4b66-aba4-10be83b8f089#) {
  Text      : "Function arguments can also be expanded {0}"(NytrilStyle.OpAttribute(attribute each));
  CodeArray : [attribute CubeFunction, attribute EachCubed];
};

