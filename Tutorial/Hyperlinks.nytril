//======================================================================

class CustomAction: Action {
  var Text;
  Constructor(text) {
    super.Constructor(Actions.Execute);
    Text = text;
  }

  override EventResponse Execute {
    System.TextToClipboard(Text);
    return EventResponses.MessageTip("Text copied to the clipboard");
  }
}

CustomLink = Span {
  Icons.copy; Space; "Copy Text";
  TipAction: new CustomAction("Custom Text");
};

readonly LessonExample Content.CustomLinkEx = new(#e68b399a-4396-49c6-ab78-5608d4ce5084#, "Custom Actions") {
  Text: "Create a complex custom action by inheriting the {0} class and overriding the Execute function. "(NytrilStyle.Class(attribute Action));
  Code: [attribute CustomAction, attribute CustomLink];
  Sel: new(7, 2, 30);
  Tip: [LessonTip(6, 0.75, "Text copied to the clipboard", 4 degrees, 5)];
  Options: NoShort;
};

