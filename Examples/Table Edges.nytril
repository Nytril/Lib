Tables.Table28 = Table(new Border(1pt, 1pt, null, null), null, [new Column(0.5", BorderR(1pt))] * 5) {
  Row(BorderB(1pt)) {
    [Cell { "hi" }]*5
  };
  Row(BorderB(1pt)) {
    Cell(null, 2) {
      "2 cols";
    };
    Cell(null, 1, 3) {
      "3 rows";
    };
    Cell(null, 2, 2) {
      "2 rows";
      "2 cols";
