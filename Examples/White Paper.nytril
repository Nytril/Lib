readonly ResultsSection PaperSections.Results = new;

class ResultsSection: Content {
  Constructor {
    super.Constructor("Results");
  }

  override GetBody(ContentStyle style) = Block {
    style.AddTable(TableFigures.HandicapTable, Top | Bottom);
    style.Par {
      "As you can see in "; style.TableReference(TableFigures.HandicapTable);
      " the proof of the pudding is in the eating"; Cite {References.AGoodWalk}; DotSpace;
      LoremIpsum(550); DotSpace;
    };

    style.AddFigure(TableFigures.HandicapChart, Top | Bottom);
    style.Par {
      "The chart in "; style.FigureReference(TableFigures.HandicapChart); " clearly shows the data. ";
      LoremIpsum(240); DotSpace;
    };
  };
}

