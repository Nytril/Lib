//===============================================================

class HomePage: SitePage {
  Constructor {
    super.Constructor(Main.Site, #421b4671-291c-4b8c-aaaa-067bac7f1728#, "White Paper", PaperContent.Reference.Subtitle);

    Tiles = [
      new DocTile(Main.Documents.PaperIntro, Icons.tour, "Introduction"),
      new DocTile(Main.Documents.PaperLinks2, Icons.assessment, "PNAS Formatting"),
      new DocTile(Main.Documents.PaperJLE2, Icons.analytics, "OUP Formatting")
    ];
  }

  override GetHeader = Block {
    Paragraph {
      TextHeight: 40pt;
      NytrilStyle.SiteIcon(Icons.article);
      Space;
      Name;
    };
    Paragraph {
      SpaceAfter: 30;
      TextHeight: 20pt;
      Description;
    };
  };
}

