using Format, Measures, LinkTypes;

include "CookingUnits";
include "Styles";

//====================================================================

class Portion {
  var             Amount;
  var AmountClass Unit;

  Constructor (amount, AmountClass unit) {
    Amount = amount;
    Unit   = unit;
  }
}

//====================================================================

class PortionUse {
  var Portion   Portion;
  var Food Food;
  var           Text;

  Constructor(Portion portion, Food food, extra=null) {
    Portion = portion;
    Food    = food;
    Text    = extra;
  }
}

//====================================================================

PortionNone = {
  Amount: 0;
};

PortionUse Ingredient(amount, AmountClass unit, text, tag) = new(new(amount, unit), tag, text);

Instruction(text, food=null) = {
  Food: food;
  Text: text
};

//====================================================================

Half      = 1 over 2;
Third     = 1 over 3;
TwoThirds = 2 over 3;
Quarter   = 1 over 4;

readonly namespace<Food> Foods {
  CorianderSeeds  = new("Coriander seeds");
  GroundCoriander = new("Ground coriander");
  CuminSeeds      = new("Cumin seeds");
  Amchoor         = new("Amchoor");
  AnardanaPowder  = new("Anardana powder");
  Ajwain          = new("Ajwain");
  Chutney         = new("Chutney");
  OrangeJuice     = new("Orange Juice");
  Orange          = new("Orange");
  Lime            = new("Lime");
  CharredLime     = new("Charred Lime halves");
  GarlicCloves    = new("Garlic cloves");
  SoySauce        = new("Soy Sauce");
  Kimchi          = new("Kimchi");
  Scallions       = new("Scallions");
  Anchovy         = new("Anchovies");
  Parmesan        = new("Parmesan");
  Lemon           = new("Lemon");
  Bread           = new("Bread");
}
//====================================================================

readonly Organization Companies.BonAppetit = new(#c687bc12-23fb-4d3e-9fd6-50ec8cc7c88d#, "Bon Appetit");

readonly Person Authors.ChrisMorocco = new(#2f4f1313-8f31-486a-8ff0-fc43c0d9c215#, "Chris", null, "Morocco") {
