using Format, Math, IO;
//=======================================================================

readonly LinkType TimeParentLink = new(TimeFrame, TimeFrame, "Child", "Parent");

class TimeFrame: Fact {
  enum SegmentTypes {
    Supereon,
    Eon,
    Era,
    Period,
    Epoch,
    Age,
  }

  field string       Name;
  field double       Start,
                     Stop;
  field SegmentTypes Segment;
  var TimeFrame      Parent;
  var Color          BackColor;

  Constructor(Guid id, SegmentTypes segment, name, start, stop, TimeFrame parent, Color color) {
    super.Constructor(id);

    Parent    = parent;
    Name      = name;
    Start     = start;
    Stop      = stop;
    Segment   = segment;
    BackColor = color;

    if (parent is valid)
      System.Assert(parent.Segment + 1 == segment);
    TimeParentLink.Connect(parent, this);
  }

  static CE(x) = 0.001 * (2000 - x);

  void Gather(set) {
    Parent?.Gather(set);
    set.Add(this);
  }

  static TimeFrame[] GetTreeList(TimeFrame[] list) {
    var set = new HashSet<TimeFrame>(256);
    foreach (var item in list)
      item.Gather(set);
    return set.ToArray;
  }

  UpperTime = Span {
    if (Parent is valid) {
      Parent.UpperTime;
      if (Parent.Name.Length > 0)
        "-";
    }
    Span {
      TextBackground: BackColor;
      Name;
    }
  };

  override GetLayoutTip = Canvas(null, null, PadTB(3pt)) {
    var t = (Start + Stop) * 0.5;
    GeoTimelineClass timeline = new(2", 1.5") {
      Start: Min(Start + t * 0.1, TimeFrames.Precambrian.Start);
      Stop: Max(0, Stop - t * 0.1);
      Time: t;
    };
    timeline.GeoTimeline(Start, Stop, Supereon, Segment)
  };

}

//=======================================================================

int CompareTime(TimeFrame s1, TimeFrame s2) = s1.Start.Compare(s2.Start);

readonly TimeFrame[] GeoTimes       = TimeFrames.ToArray;
readonly TimeFrame[] SortedGeoTimes = GeoTimes.ToSortedArray(true, @CompareTime);
readonly TimeFrame[] GeoList        = TimeFrame.GetTreeList(GeoTimes);

//=======================================================================

