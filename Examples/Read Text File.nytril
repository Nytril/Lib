using Format, IO;

Main.Documents.MyDocument = new MyDocument;

class MyDocument: DocumentEntry {
  Constructor {
    super.Constructor(#ad080fa6-1765-48f7-862e-dc043ac95a16#, "Read Text File");
  }

  override GetDocument = Document {
    Paragraph {
      IO.ReadString(res "text file.txt");
    }
  };
}

