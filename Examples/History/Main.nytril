readonly namespace Main.Documents {
  HomePage            HomePage     = new;
  HistorySummary      Summary      = new;
  HistoryPresentation Presentation = new;

  StyleDocument Paper = new(#97194437-dac5-4861-ae05-f1ea9933b0e0#, "Paper", new PaperContent, PaperStyle);
  StyleDocument Book  = new(#51fb21c5-63f0-4eea-88a8-0e49e0973ae8#, "Book", new BookContent, new BookStyle);
