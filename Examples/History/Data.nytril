readonly DocReference PaperReference = new(#7038de1c-1d87-4edc-8eb8-a2f2f841e189#, Article) {
  Title: "History of the Early United States";
  Subtitle: "The first four presidents";
  AuthorLink to [People.David_McCullum, People.Isabel_Allen];
};

class HistoryContentClass: AuthoredContent {
  Constructor(DocReference reference) {
    super.Constructor(reference.Title, reference);
    Correspondant = People.David_McCullum;
    Keywords = ["United States", "History"];
  }
}

//=====================================================================

class PaperContent: HistoryContentClass {
  Constructor {
    super.Constructor(PaperReference);

    AddContent(new IntroductionClass);
    AddContent(new PersonSection(References.GeorgeWashingtonPortrait));
    AddContent(new PersonSection(References.JohnAdamsPortrait));
    AddContent(new PersonSection(References.ThomasJeffersonPortrait));
    AddContent(new PersonSection(References.JohnQuincyAdamsPortrait));
  }
}

//=====================================================================

readonly DocReference BookReference = new(#b60b7e59-904c-4d4b-8013-def4dc7dddd7#, Book) {
  Title: "History of the United States";
  Subtitle: "The early years";
  AuthorLink to People.David_McCullum;
};

class BookContent: HistoryContentClass {
  Constructor {
    super.Constructor(BookReference);

    AddContent(new PersonChapter(References.GeorgeWashingtonPortrait));
    AddContent(new PersonChapter(References.JohnAdamsPortrait));
    AddContent(new PersonChapter(References.ThomasJeffersonPortrait));
    AddContent(new PersonChapter(References.JohnQuincyAdamsPortrait));
  }
}

//=====================================================================

class PersonTip: Action {
  var Person Person;

  Constructor(Person person) {
    super.Constructor(Actions.RunQuery, person);
    Person = person;
  }

  override GetLayoutTip = Block {
    Person;
    (Person.FindFirstFact(PortraitLink) as DocReference)?.Image;
  };

  override GetQuery = MatchAny(Person) {
    Person;
  };
}

//=====================================================================

namespace History {
  readonly Subject[] Presidents {
    var presidents = System.GetLocalRealm.Query(MatchAny(Person) {MatchAny(PublicOffices.USPresident)}) as Subject[];
    var tenures    = (new OfficeTenure(each presidents, PublicOffices.USPresident)).ToSortedArray(false);
    return (each tenures).Subject;
  }

  ShowRelations(ContentStyle style, Person person) = Block {
    var unions = person.FindFacts(CoupleLink) as Couple[];
    foreach (var union in unions) {
      var other = union.Partner1;
      if (other == person)
        other = union.Partner2;

      Table(null, PadLR(10pt), [Column.Fit(5")]) {
        SpaceBefore: 10pt;
        Row {
          VAlign: Top;
          ShowPortrait(other, 0.75");
          style.Par {
            ShowDate(null, union.Married);
            ": married to ";
            other;
            if (union.Divorced is valid) {
              " divorced on ";
              union.Divorced;
            }
          };
        };

        var children = union.FindFacts(ParentsLink) as Subject[];
        if (children is valid) {
          foreach (var child in children) {
            Row {
              ShowPortrait(child, 0.75");
              style.Par {
                ShowDate(null, child.Born);
                ": ";
                child;
                " was born";
              };
            };
          }
        }
      };
    }
  };

  ShowPortrait(Person person, height=1") = HBox(null, height, new Edge(0, 3pt)) {
    HAlign: Center;
    VAlign: Top;

    var p = person.FindFirstFact(PortraitLink) as DocReference;
    if (p is valid) {
      HBox {
        VAlign: Bottom;
        Canvas(null, null, new Edge(2pt, 0, Colors.LightGray)) {
          BorderRadius: 10pt;
          BorderClip: true;
          FitBox(p.Image, null, height - 10pt);
          Tip: p;
        };
        var r = p.FindFirstFact(DocReference) as DocReference;
        if (r is valid)
          Paragraph {Cite {r}};
      };
    }
    else
      Span {Icons.portrait; TextHeight: 66pt; TextColor: Colors.LightGray};
  };

  ShowPerson(Subject person) = Block {
    Paragraph(BorderB(0.5pt), [2.5", 4.8"]) {
      person;
      Tab;
      ShowDates("Born ", FindOccurrenceDate(person, BornLink), "\tDied ", FindOccurrenceDate(person, DiedLink));
    };

    var comments = person.FindFacts(Comment) as Comment[];
    if (comments is valid) {
      Table(null, null, [1", Column.Expand]) {
        Row {
          VAlign: Top;

          ShowPortrait(person);
          Cell {
            ParAlignment: Justify;
            (each comments).TextReference;
          };
        };
      };
    }

    var offices = person.FindFacts(PublicOffice) as PublicOffice[];
    if (offices is valid) {
      Paragraph {
        LeftIndent: 10pt;
        Bold;
        "Offices:"
      };
      ListBlock {
        var officetenures = (new OfficeTenure(person, each offices)).ToSortedArray(false);
        (each officetenures).Show;
      };
    }
  };

  ShowEvent(ContentStyle style, Event event) = Block {
    Paragraph(BorderB(0.5pt), [3", 5"]) {
      Span {
        Bold;
        event.Description;
      };
      Tab;
      ShowDate(null, event.Date);
    };
    event.ShowComments(style, 12pt);
  };
}

//=====================================================================

