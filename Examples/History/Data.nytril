//======================================================================

URL WikiLink(url) = new("https://en.wikipedia.org/wiki/" + url);
URL WikiFile(url) = new("https://en.wikipedia.org/wiki/File:" + url);

DocReference WikiReference(id, name, title) = new(id, ReferenceTypes.InternetSite) {
  Title: title;
  Key: "Wikipedia: " title;
  Link to WikiLink(name);
};

