//=====================================================================

class TimelineEvent {
  var DateTime Date;
  var          Text;

  Constructor(DateTime d, text) {
    Date = d;
    Text = text;
  }

  override int Compare(TimelineEvent e) {
    return Date.Compare(e.Date);
  }
}

//=====================================================================

class TimelineClass: Content {
  var Person Person;

  Constructor(ContentStyle style, Person person) {
    super.Constructor("Life events of " + style.GetFullName(person), person.FactId);
    Person = person;
  }

  override GetCaption(ContentStyle style) = Span {
    "Events in the life of " + style.GetFullName(Person);
    DotSpace;
  };

  override GetBody(ContentStyle style) = ShowEventTable(Person);
}

//=====================================================================

class IntroductionClass: Content {
  Constructor{
    super.Constructor("Introduction");
  }

  override GetBody(ContentStyle style) = Block {
    style.Par {
      revu "History is a tale told by the winners. ";
      LoremIpsum(50);
    };

    // Random sized fake text
    foreach (var i in 100..200 step 60) {
      style.Par {
        LoremIpsum(i);
      };
    }
  };
}

//=====================================================================

class PersonIntro: Content {
  readonly var Person          Person;
  readonly var PortraitContent Portrait;

  Constructor(DocReference reference) {
    super.Constructor(null, reference.FactId);
    Person   = reference.FindFirstFact(PortraitLink) as Person;
    Portrait = new PortraitContent(reference);
    Name     = Person.FactId;
    Title    = ContentStyle.GetFullName(Person);
  }

  override GetBody(ContentStyle style) = Block {
    bool first = true;
    foreach (var comment in Person.FindFacts(Comment) as Comment[]) {
      style.Par {
        comment.TextReference;
      };

      if (first)
        style.AddFigure(Portrait, FigureOptions.Top | FigureOptions.Bottom);

      first = false;
    }
  };
}

//=====================================================================

class PersonEvents: Content {
  readonly var Person Person;

  Constructor(Person person) {
    super.Constructor("Events", person.FactId);
    Person = person;
  }

  override GetBody(ContentStyle style) = Block {
    var table = new TimelineClass(style, Person);
    style.Par {
      style.TableReference(table);
      " shows a list of the major events in the life of ";
      style.GetFullName(Person); DotSpace;
    };
    style.AddTable(table, FigureOptions.Here);

    History.ShowRelations(style, Person);
  };
}

//=====================================================================

class PersonChapter: PersonIntro {
  Constructor(DocReference reference) {
    super.Constructor(reference);
    AddContent(new PersonEvents(Person));
  }

  override GetBody(ContentStyle style) = Block {
    style.TitlePar {
      SpaceBefore: 1";
      TextHeight: 32pt;
      Title;
      DocFields.Anchor(Person.FactId);
    };

    style.AddFigure(Portrait, FigureOptions.Here);

    var comment = Person.FindFirstFact(Comment) as Comment;
    if (comment is valid) {
      style.Par {
        comment.TextReference;
      };
    }
  };
}

//=====================================================================

class PersonSection: Content {
  Constructor(DocReference reference) {
    super.Constructor(null);
    var intro = new PersonIntro(reference);
    Title       = intro.Title;
    intro.Title = "Overview";
    AddContent(intro);
    AddContent(new PersonEvents(intro.Person));
  }
}

