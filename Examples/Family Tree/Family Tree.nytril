using Format, LinkTypes;

include "Basic Facts";

//==============================================================================================================

readonly namespace Metrics {
  CurrentDate    = DateTime.Now;
  TreeText       = 5.8pt;
  LevelIndent    = 0.25";
  IconColor      = Colors.Black;
  IconIndirect   = Colors.DarkGray;
  LineColor      = new Color(62, 94, 136);
  BoxLine        = LineColor;
  BoxBack        = 95%;
  LocketColor    = (94%)..(80%);
  PortraitColor  = Colors.Gold..Colors.Brown;
  DateIndent     = 1.35";
  PortraitHeight = 1.4";
  PortraitAngle  = 5 degrees;

  Thickness MainMargin = new(0.75", 0.75", 0.75", 0.75");
  Thickness TreeMargin = new(0.5", 0.125", 0.5", 0.5");
  Size Tip             = new(5", 6");
  Size PersonPicture   = new(1.5");
}

//=====================================================================

readonly LinkType ParentsLink  = new(Couple, Person, "Parents", "Child");
readonly LinkType BornLink     = new(Person, null, "Born");
readonly LinkType MarriedLink  = new(Couple, null, "Married");
readonly LinkType FormerlyLink = new(Person, FamilyName, "Formerly");
readonly LinkType NicknameLink = new(Person, NickName, "Nickname");

readonly FamilyMember[] PeopleList  = Information.People.ToArray;
readonly Couple[]       CoupleList  = Information.Couples.ToArray;
readonly Story[]        StoryList   = Information.Stories.ToArray;

int SortFunc(Event x, Event y) = x.Date.Compare(y.Date);

readonly Event[] SortedEvents {
  EventList events = new(128);
  foreach (var person in PeopleList) {
    if (person.Born is valid)
      events.Add(new BornEvent(person, person.Born));
    if (person.Died is valid)
      events.Add(new DiedEvent(person, person.Died));
  }
  foreach (var parents in CoupleList) {
    if (parents.Married is valid)
      events.Add(new WeddingEvent(parents));
  }
  foreach (var story in StoryList) {
    if (story.Date is valid)
      events.Add(new StoryEvent(story));
  }
  return events.ToSortedArray(false, @SortFunc);
}

//===============================================================================================================

ShowPlace(place) = Span {
  Separator: CommaSpace;
  place.Name;
  var state = place.FindFirstFact(State);
  if (state is valid)
    state.Name;
  else {
    var country = place.FindFirstFact(Country);
    if (country is valid)
      country.Name;
  }
};

Hyperlink(Fact fact) = {
  Tip: fact;
  Action: new Action(Actions.ToAnchor, fact.FactId);
};

PortraitFrame(Fact fact, Photograph portrait, height, angle, c1, c2, t, link=false) {
  var t2    = t*2;
  var pic   = FitBox(portrait.Photo, ExtentWidth, height - t2);
  var width = pic.Width + t2;
  height = pic.Height + t2;

  ColorStop[] stops  = [new(0, c1), new(1, c2)];
  var color  = new LinearGradient(0, 0, 1, 0, stops);
  var vcolor = new LinearGradient(0, 0, 0, 1, stops);

  return Canvas(width, height) {
    if (angle != 0) {
      Transform: Transform.Rotate(angle) Transform.Skew(angle, angle);
      TransformFit: true;
    }

    pic {
      X: t;
      Y: t;
      if (link)
        Hyperlink(fact);
    };

    Shape(vcolor) {
      ClosedPath(0) {
        LineTo(width, 0);
        LineTo(width-t, t);
        LineTo(t, t);
      }
    };
    Shape(vcolor) {
      ClosedPath(width, height) {
        LineTo(0, height);
        LineTo(t, height-t);
        LineTo(width-t, height-t);
      }
    };
    Shape(color) {
      ClosedPath(width, 0) {
        LineTo(width, height);
        LineTo(width-t, height-t);
        LineTo(width-t, t);
      }
    };
    Shape(color) {
      ClosedPath(0) {
        LineTo(0, height);
        LineTo(t, height-t);
        LineTo(t, t);
      }
    };
  };
}

Divorced(DateTime date) = Divorced: date;

BornAt(DateTime date, place) = {
  Born: date;
  if (place is valid)
    BornLink to place;
};

MarriedAt(DateTime date, place) = {
  Married: date;
  if (place is valid)
    MarriedLink to place;
};

Formerly(name) = {
  FormerlyLink to new FamilyName(name);
};

Nick(name) = {
  NicknameLink to new NickName(name);
};

ListPeople(FamilyMember[] list) = Span {
  Span {
    LastSeparator: " and ";
    Separator: CommaSpace;
    (each list).ShowLink;
  };
};

OvalFrame(Photograph photo, height) = Canvas(null, null, new Edge(3pt, 0, Colors.LightGray)) {
  BorderRadius: 10pt;
  BorderClip: true;
  FitBox(photo.Photo, null, height);
};

void GatherPicture(List<Couple> list, Couple parents) {
  if (parents.Partner1.Portrait is valid and parents.Partner2.Portrait is valid)
    list.Add(parents);
}

