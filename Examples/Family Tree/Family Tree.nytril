}

//===============================================================================================================

class FamilyMember: Person {
  var Photograph Portrait;
  var DateTime   Born,
                 Died;
  var Couple     Parents;
  var            DeathDateUnknown;

  Constructor(Guid id, first, middle, last, Couple parents, portrait=null) {
    super.Constructor(id, first, middle, last);
    Parents = parents;
    if (portrait is valid) {
      Portrait = new(id, portrait);
      Link.Connect(this, Portrait);
    }
    if (parents is not null)
      ParentsLink.Connect(parents, this);
    Link.Connect(this, new FamilyName(last));
  }

  FirstName = GetNickname?.Name ?? First;

  ShowLink(text=null) = Span Hyperlink(this) {
    TextColor: Colors.Blue;
    text ?? FirstName;
  };

  ShowFullLink(former) = ShowFullName(former) Hyperlink(this);

  GetFormerly = FindFirstFact(FormerlyLink);
  GetNickname = FindFirstFact(NicknameLink);

  ShowFullName(former) = Span {
    Separator: Space;
    First;
    Middle;
    if (former) {
      var formerly = GetFormerly;
      if (formerly is valid) {
        formerly.Name;
        return;
      }
    }
    Last;
  };

  ShowListing = Span {
    GetIcon;
    Space;
    ShowFullLink(false);
    var formerly = GetFormerly;
    if (formerly is valid)
      " (neé {0})"(formerly.Name);

    if (Died is valid) {
      Span {
        TextColor: Colors.DarkGray;
        Styles.TextDate(", died ", Died);
      }
    }
  };

  ShowDates = Block {
    if (Born is valid) {
      if (DeathDateUnknown is valid) {
        Paragraph {
          "Unknown time of death";
        }
      }
      else if (Died is not valid and (Metrics.CurrentDate - Born).Years < 100) {
        Paragraph {
          var age   = Metrics.CurrentDate - Born;
          var years = Math.Floor(age.Years);
          if (years < 2) {
            if (years < 0.09)
              "{0} days old"(Math.Floor(age.Days));
            else
              "{0} months old"(Math.Floor(age.Years * 12.0));
          }
          else
            "{0} years old"(years);
        }
      }

      Paragraph {
        Styles.TextDate("Born ", Born);
        var place = FindFirstFact(BornLink);
        if (place is valid) {
          " in ";
          ShowPlace(place);
        }

        if (Died is valid) {
          LineBreak;
          Span {
            Styles.TextDate("Died ", Died);
            Styles.DiedAtAge(this);
          };
        }
      };
    }
  };

  ShowPersonalData = Block {
    var formerly = GetFormerly;
    if (formerly is valid) {
      Paragraph {
        Italic "neé ";
        ShowFullName(true);
      }
    }
    ShowDates;

    if (Parents is valid) {
      Paragraph {
        Bold;
        "Parents";
      };
      Paragraph {
        LeftIndent: 12pt;
        Parents.Partner1?.ShowFullLink(false);
        LineBreak;
        Parents.Partner2?.ShowFullLink(false);
      };
    }

    ShowChildren;

    var stories = FindFacts(Story) as Story[];
    if (stories is valid) {
      Span {
        Bold "Stories"; ColonSpace;
        Span {
          Separator: CommaSpace;
          foreach (var story in stories) {
            Span {Hyperlink(story) {each1}};
          }
        };
      };
    }
  };

  ShowChildren = Block {
    bool anyunions = false;
    foreach (var u in CoupleList) {
      FamilyMember p = null;
      if (u.Partner1 == this)
        p = u.Partner2;
      else if (u.Partner2 == this)
        p = u.Partner1;

      if (p is valid) {
        if (!anyunions) {
          Paragraph {
            Bold;
            "Unions";
          };
          anyunions = true;
        }

        Paragraph {
          LeftIndent: 16pt;
          FirstIndent: -8pt;

          p.ShowFullLink(false);

          var children = new List<FamilyMember>(16);
          foreach (var t in PeopleList) {
            if (t.Parents == u)
              children.Add(t);
          }

          if (children.Length > 0) {
            if (children.Length > 1)
              " with {0} children: "(children.Length);
            else
              " with one child: ";
            Span {
              Separator: CommaSpace;
              LastSeparator: " and ";
              (each children).ShowFullLink(false);
            }
          }
        }
      }
    }
  };

  ShowName = Paragraph {
    DocFields.Anchor(FactId);
    LeftIndent: Metrics.LevelIndent;
    FirstIndent: -Metrics.LevelIndent;
    TextHeight: 16pt;

    var icon = GetIcon;
    if (icon is valid) {
      icon;
      Space;
    }

    ShowFullName(false) {
      var nick = GetNickname;
      if (nick is valid) {
        Span {
          " - '";
          nick.Name;
          "'"
        };
      }
    };
  };

  ShowFullEvent(width) = Block {
    ShowName;
    if (Portrait is valid) {
      HBox {
        VAlign: Top;
        OvalFrame(Portrait, Metrics.PortraitHeight);
        Space;
        Frame(width - Metrics.PersonPicture.Width) {
          ShowPersonalData;
        }
      }
    }
    else Frame(width) {
      ShowPersonalData;
    }
  };

  override GetLayoutFact = Block {
    ShowFullEvent(3");
  };

  override GetLayoutTip = Frame(Metrics.Tip.Width - (Portrait is valid ? 0 : Metrics.PersonPicture.Width)) {
    ShowFullEvent(Metrics.Tip.Width);
  };

  override GetLayoutNode {
    if (Portrait is valid) {
      return FitBox(Portrait.Photo, 50pt, 50pt, new Edge(0.25pt, 0, Colors.LightGray)) {
        Tip: this;
        BorderRadius: 7pt;
        BorderClip: true;
      };
    }
    return super.GetLayoutNode;
  }
}

