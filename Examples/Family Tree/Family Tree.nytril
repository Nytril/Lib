class FamilyName: Fact {
  field string Name;

  Constructor(name) {
    super.Constructor(Guid.FromHash(name));
    Name = name;
  }

  override Icon GetIcon = Icons.diversity_3;
}

//===============================================================================================================

class NickName: Fact {
  field string Name;

  Constructor(name) {
    super.Constructor(Guid.FromHash(name));
    Name = name;
  }

  override Icon GetIcon = Icons.label;
}

//===============================================================================================================

abstract class Event {
  var DateTime Date;

  Constructor(date) {
    Date = date;
  }
}

typedef EventList List<Event>;

//===============================================================================================================

class BornEvent: Event {
  var FamilyMember Person;

  Constructor(FamilyMember person, date) {
    super.Constructor(date);
    Person = person;
  }

  override GetLayoutSpan = Span {
    Person.ShowFullLink(false);
    " was born";
  };

  override Icon GetIcon = Icons.child_friendly;
}

//===============================================================================================================

class DiedEvent: BornEvent {
  Constructor(FamilyMember person, date) {
    super.Constructor(person, date);
  }

  override GetLayoutSpan = Span {
    Person.ShowFullLink(false);
    " died";
  };

  override Icon GetIcon = Icons.door_back;
}

//===============================================================================================================

class WeddingEvent: Event {
