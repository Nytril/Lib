//===============================================================================================================

class Couple: Fact {
  field DateTime   Married;
  field DateTime   Divorced;
  var FamilyMember Partner1,
                   Partner2;

  Constructor(Guid id, FamilyMember partner1, FamilyMember partner2) {
    super.Constructor(id);
    System.Assert(partner1 is valid and partner2 is valid, "Expecting both partners");
    Partner1 = partner1;
    Partner2 = partner2;
    Link.Connect(this, partner1);
    Link.Connect(this, partner2);
  }

  override Icon GetIcon = Icons.people;

  Title = Span {
    Partner1.ShowFullName(false);
    " and ";
    Partner2.ShowFullName(false);
  };

  override GetLayoutFact = Title;

  override GetLayoutTip = Title;
}

//===============================================================================================================

class Story: Fact {
  field DateTime   Date;
  var Photograph   Photo;
  var FamilyMember ToldBy;
  var              Text,
                   Title;

  Constructor(Guid id, FamilyMember toldby, title, DateTime date=null, imagepath=null) {
    super.Constructor(id);
    Date   = date;
    ToldBy = toldby;
    Title  = title;
    if (imagepath is valid) {
      Photo = new(id, imagepath);
      Link.Connect(this, Photo);
    }
  }

  override Icon GetIcon = Icons.history_edu;

  override GetLayoutTip = Frame(100%) {
    ShowFullEvent(Metrics.Tip.Width);
  };

  ShowFullEvent(width, bool picture=true) = Paragraph {
    DocFields.Anchor(FactId);
    Frame(width) {
      Paragraph(null, [new TabStop(width, TabTypes.Right)]) {
        SpaceBefore: 16pt;
        ParBackground: 90%;
        Span {
          Bold;
          TextHeight: 14pt;
          Title;
        };
        if (Date is valid) {
          " - ";
          Styles.ShowDate(Date);
        }
        if (ToldBy is valid) {
          Tab;
          "by ";
          ToldBy.ShowFullLink(false)
        }
      };
      Paragraph(BorderLR(new(0.5, 12pt))) {
        ParAlignment: Justify;
        SpaceBefore: 6pt;
        SpaceAfter: 6pt;
        LeftIndent: 24pt;
        RightIndent: 24pt;
        Text;
      };
      if (picture) {
        Paragraph {
          ParAlignment: Center;
          if (Photo is valid) {
            var r = Math.Random(85..95);
            PortraitFrame(this, Photo, 3.55", 0, r%, (r*0.7)%, 8pt, false);
          }
        }
      }
    }
  };

  override GetLayoutFact = Block {
    ShowFullEvent(100%, false);
  };
}

//===============================================================================================================

class StoryEvent: Event {
  var Story Story;

  Constructor(Story story) {
    super.Constructor(story.Date);
    Story = story;
  }

  override GetLayoutSpan = Span {
    Hyperlink(Story);
    Story.Title;
  };

  override Icon GetIcon = Story.GetIcon;
}

//===============================================================================================================

readonly namespace Styles {
  Header1(text) = Paragraph {
    TextHeight: 18pt;
    SpaceAfter: 12pt;
    Bold;
    text
  };

  Header2(text) = Paragraph(BorderB(0.5)) {
    TextFamily: TextFamilies.TimesNewRoman;
    TextHeight: 16pt;
    SpaceBefore: 12pt;
    SpaceAfter: 6pt;
    Bold;
    text
  };

  ShowDate(d) = Span {
    if (d.Precision == DatePrecisions.Year)
      TextFormat: "yyyy";
    else if (d.Precision == DatePrecisions.Month)
      TextFormat: "MMMM yyyy";
    else
      TextFormat: "MMMM dd, yyyy";
    d;
  };

  TimelineDate(d) = Span {
    if (d.Precision == DatePrecisions.Year)
      TextFormat: "yyyy";
    else if (d.Precision == DatePrecisions.Month)
      TextFormat: "yyyy, MMMM";
    else
      TextFormat: "yyyy, MMMM dd";
    d;
  };

  TextDate(text, d) {
    if (d is valid) {
      return Span {
        text;
        Space;
        ShowDate(d);
      };
    }
    else
      return null;
  }

  DiedAtAge(FamilyMember person) = Span {
     ", at age {0}"(Math.Floor((person.Died - person.Born).Years))
  };

  LevelPar(level, border=true) = Paragraph(border ? BorderL(new(3pt, 3pt, 90%)) : null) {
    LeftIndent: level*Metrics.LevelIndent + 12pt;
    FirstIndent: -12pt;
  };

  Story = Paragraph {
    KeepWithNext: true;
  };
}
//============================================================================================================

FullPar = Paragraph {
  LeftIndent: Metrics.LevelIndent;
};

//============================================================================================================
// Timeline
//============================================================================================================

readonly namespace Timeline {
  RowHeight = 9pt;
  Edge      = 12pt;

  AddEvent(Event event, yearstart, yearend) {
    var frac = (event.Date.Year - yearstart) / (yearend - yearstart + 1);
    var x    = (ExtentWidth - Edge*2) * frac;
    if (frac > 0.5) {
      return Canvas(x, null) {
        Y: RowHeight * each0;
        HAlign: Right;
        Paragraph {
          event;
          Space;
          Span {event.GetIcon; TextColor: Metrics.IconColor};
        }
      };
    }
    else {
      return Canvas {
        X: x;
        Y: RowHeight * each0;
        Paragraph {
          Span {event.GetIcon; TextColor: Metrics.IconColor};
          Space;
          event;
        }
      };
    }
  }

  ShowBlock(Event[] events) {
    var yearstart = (Math.Floor(events.FirstElement.Date.Year) div 10) * 10;    // Round down to the nearest 10 years
    var yearend   = (Math.Floor(events.LastElement.Date.Year + 9) div 10) * 10; // Round up to the nearest 10 years

    return Paragraph {
      SpaceAfter: 10pt;
      VBox {
        VBox {
          ChartAxis(100%) {
            Start: yearstart;
            Stop: yearend;
          };
          Canvas(ExtentWidth - Edge*2, null, 0.25pt) {
            X: Edge;
            TextHeight: 7pt;
            AddEvent(each events, yearstart, yearend);
          }
        };
      }
    };
  }

  AddRows(Event event) = Paragraph {
    LeftIndent: Metrics.DateIndent;
    FirstIndent: -Metrics.DateIndent;
    Styles.TimelineDate(event.Date);
    Tab;
    Tab;
    event.GetIcon {TextColor: Metrics.IconColor};
    Space;
    event;
  };

  Show = Block {
    DocSection("Timeline");
    var rows = Math.Floor(((ExtentHeight - 1") toscale Units.pixels) / (RowHeight toscale Units.pixels));

    ShowBlock(each (SortedEvents / rows));
//    Styles.Header2("Timeline Details");
//    AddRows(each SortedEvents);
  };
}

//============================================================================================================

HeaderFormat = Paragraph(BorderB(0.25pt)) {
  TextHeight: 10pt;
  TextFamily: TextFamilies.TimesNewRoman;
};

DocSection(title) = SectionNextPage {
  Header: MarginBlock(0.5") {
    HeaderFormat {
      ParAlignment: ParAlignments.Right;
      title
    };
  };
  Footer: MarginBlock(0.5") {
    Paragraph {
      ParAlignment: Center;
      DocFields.PageNumber;
    };
  };
};

//============================================================================================================

class FamilyDocument: DocumentEntry {
  var FamilyLineClass[] FamilyLines;

  Constructor(Guid docid, title, FamilyLineClass[] lines) {
    super.Constructor(docid, title);
    FamilyLines = lines;
    Title       = Name;
    Description = "Collect and display family history events and people";
  }

  override GetDocument = Document(Metrics.MainMargin) {
    AlbumTitlePage(Name);

    foreach (var line in FamilyLines) {
      SectionNextPage(Metrics.TreeMargin);
      ShowTree(line);
    }

    Timeline.Show;

    if (StoryList.Length > 0) {
      DocSection("Stories");
      Block {
        Styles.Header2(Name);
        (each StoryList).ShowFullEvent(ExtentWidth);
      };
    }

    ShowFamilyMembers("Family Members");
  };

  static ShowPortrait(Couple couple) = HBox {
    var hinge = 14pt;
    VAlign: Top;
    PortraitFrame(couple.Partner1, couple.Partner1.Portrait, Metrics.PortraitHeight, -Metrics.PortraitAngle, 94%, 80%, 4pt, true);
    Canvas(2pt, Metrics.PortraitHeight - hinge*2) {
      Margin: PadTB(hinge);
      Background: (90%)..(70%);
    };
    PortraitFrame(couple.Partner2, couple.Partner2.Portrait, Metrics.PortraitHeight, Metrics.PortraitAngle, 94%, 80%, 4pt, true);
  };

  ShowPortraitLine(Couple[] unions) = Paragraph {
    HBox {
      Separator: Space*3;
      ShowPortrait(each unions);
    }
  };

  Leaf(branch=1) = new Node(null, branch) {
    Marker: Markers.Circle;
  };

  IconTree = new Node(null, 0) {
    new Node(null, 0) {
      new Node(null, 4);
      new Node(null, 2) {
        new Node(null, 2);
        new Node(null, 1) {
          Leaf;
          Leaf;
        }
      }
    };
    new Node(null, 3) {
      new Node(null, 1) {
        Leaf;
        Leaf;
      };
      Leaf(2);
    };
  };

  AlbumTitlePage(title) = Block {
    ParAlignment: Center;
    Paragraph {
      SpaceBefore: 1";
      TextHeight: 36pt;
      title;
    };
    Paragraph {
     TreeBox(null, 80pt) {
        Placement: Placements.Bottom;
        Default: new Node(null) {
          Marker: Markers.Square(Colors.Blue);
          Stroke: new Stroke(2pt, Metrics.LineColor);
          Curvature: 20%;
          Bevel: 20%;
          NodeGap: 20pt;
        };
        Root: IconTree;
      };
    };
    Paragraph {
      SpaceAfter: 24pt;
      TextHeight: 16pt;
      Styles.ShowDate(Metrics.CurrentDate);
    };

    var pictures = new List<Couple>(256);
    GatherPicture(pictures, each CoupleList);
    var triplets = pictures.ToSortedArray(false, @SortUnionFunc) / 3;
    ShowPortraitLine(each triplets);
  };

  static DateTime PictureDate(Couple couple) {
    if (couple.Married is valid)
      return couple.Married;
    if (couple.Partner1.Born is valid)
      return couple.Partner1.Born;
    if (couple.Partner2.Born is valid)
      return couple.Partner2.Born;
    return #1700#;
  }

  static int SortUnionFunc(Couple x, Couple y) = PictureDate(x).Compare(PictureDate(y));

  static TreePerson(Couple parents, FamilyMember person) = Span {
    Span {
      TextColor: parents == person.Parents ? Metrics.IconColor : Metrics.IconIndirect;
      person.GetIcon;
    };
    Space;
    Span Hyperlink(person) {
      person.FirstName;
    };
  };

  static Node MakeTreeNodes(Couple parents, Couple parent) = new {
    var elr = new Edge(0.3pt, 3pt, Metrics.BoxLine);
    var etb = new Edge(0.3pt, 0, Metrics.BoxLine);
    Marker: VBox(null, null, new(elr, etb, elr, etb)) {
      BorderRadius: 2pt;
      Background: Metrics.BoxBack;
      TreePerson(parent, parents.Partner1);
      TreePerson(parent, parents.Partner2);
    };

    foreach (var child in PeopleList) {
      if (child.Parents == parents) {
        var unions = CoupleList.FindSlice(u => u.Partner1 == child || u.Partner2 == child);
        if (unions.Length > 0) {
          foreach (var u in unions)
            MakeTreeNodes(u, parents);
        }
        else {
          new Node {
            Name: child.FirstName;
            Label: TreePerson(parents, child);
          };
        }
      }
    }
  };

  ShowTree(FamilyLineClass line) = Block {
    Styles.Header1("The descendants of " line.Root.Title);
    TreeBox(ExtentWidth, null) {
      TextHeight: line.TextHeight;

      Default: new Node(null) {
        NodeGap: line.NodeGap;
        Bevel: 5%;
        Curvature: 5%;
        Stroke: new Stroke(0.25pt, Metrics.LineColor);
      };

      Root: MakeTreeNodes(line.Root, null);
    };
  };

  static int NameSort(FamilyMember p1, FamilyMember p2) {
    var last = p1.Last.Compare(p2.Last);
    if (last == 0)
      return p1.First.Compare(p2.First);
    return -last;
  }

  ShowFamilyMembers(title) = Block {
    DocSection(title);
    Styles.Header2(title);
    var width = ExtentWidth * 0.5;

    Table(null, null, [width]*2) {
      var groups = PeopleList.ToSortedArray(true, @NameSort) / 2;
      foreach (var g in groups) {
        Row(PadT(20pt)) {
          foreach (var p in g)
            p.ShowFullEvent(width);
        }
      }
    };
  };
}
//======================================================================

class FamilyLineClass {
  var Couple Root;
  var       TextHeight,
            NodeGap;

  Constructor(Couple root, textheight, gap) {
    Root       = root;
    TextHeight = textheight;
    NodeGap    = gap;
  }
}
//============================================================================================================


