class GitResourcesSection: Content {
  Constructor() {
    super.Constructor("Resources");
  }

  override GetLayout(TechDesign design) = Block {
    design.Heading3 {
      Title;
    };

    design.HyperlinkParagraph {
      Repositories;
    };
  };
}
