using Format, HelpConcepts;

class SourceControlConcept: AuthoredContent {
  Constructor {
    super.Constructor("Connecting Nytril IDE & Repo to Git");

    Watermark = "DRAFT";

    AddAuthor(People.ColbertAuthor);
    AddAuthor(People.McCreightAuthor);

    AddContent(GitPurpose);
    AddContent(GitRequirements);
    AddContent(GitConnectSteps);
    AddContent(GitConnected);
    AddContent(GitAuthentication);
    AddContent(GitResources);
  }
}
// ============================================================================

readonly GitPurposeSection GitPurpose = new;

class GitPurposeSection: Content {
  Constructor() {
    super.Constructor("Purpose");
  }

  override GetLayout(TechDesign design) = Block {
    design.Heading2 {
      Title;
    };

    design.SpacedParagraph {
      "This document describes how to connect a Git repository to the Nytril IDE for version tracking and collaboration.";
    };
  };
}
// ============================================================================

readonly GitRequirementsSection GitRequirements = new;
class GitRequirementsSection: Content {
  Constructor() {
    super.Constructor("Requirements");
  }

  override GetLayout(TechDesign design) = Block {
    design.Heading2 {
      Title;
    };

    design.SpacedParagraph {
      "Nytril checks for a .git folder in the root of the Nytril repository. The Git menu depends on whether that folder exists and whether Git credentials have been entered. ";
      "If a Git repository has already been cloned or Git has been set up in that folder, enter credentials for the existing repository. Otherwise, use Clone from Git.";
    };

    design.TightParagraph {
      "Before connecting Git, ensure the following:";
    };

    design.NumberedList {
      "The user has permission to access the Git repository.";
      "The user has a Git personal access token.";
      "If cloning a repository, its repository address or clone URL is available.";
    };
  };
}
// ============================================================================

readonly GitConnectStepsSection GitConnectSteps = new;
class GitConnectStepsSection: Content {
  Constructor() {
    super.Constructor("Connect Git");
  }

  override GetLayout(TechDesign design) = Block {
    design.Heading2 {
      SpaceBefore: 20px;
      Title;
    };

    design.Heading3 {
      "Git already exists";
    };

    Table(null, null, [new Column(70%), new Column(20), Column.Expand] ) {
      Row {
        Cell {
          design.SpacedParagraph {
            "If the root of the Nytril repository contains a .git folder but Git credentials have not been entered, Nytril displays the menu shown in "; design.FigureReference(GitExistsMenuFig); DotSpace;
            "Commands such as Commit, Push, and Pull are disabled until credentials have been entered.";
          };

           design.SpacedParagraph {
              "Select "; design.SpanHighlight { "Git => Git Credentials for Current Repo" }; " and enter the Git credentials for the repository. Once this is complete, the full Git menu is available, as shown in "; design.FigureReference(GitConnectedMenuFig); DotSpace;
            };
        };
        Cell;
        Cell {
          design.AddFigure(GitExistsMenuFig, Here);
          //design.FigureCaption(GitExistsMenuFig);
        };
      };
    };

    Table(null, null, [new Column(30%), new Column(20), Column.Expand] ) {
      Row {
        Cell {
          design.AddFigure(NoGitMenuFig, Here);
        };
        Cell;
        Cell {
          design.Heading3 {
            SpaceBefore: 0;
            "Git does not exist";
          };

          design.SpacedParagraph {
            "If the root of the Nytril repository does not contain a .git folder, the Git menu offers only Clone from Git, as shown in "; design.FigureReference(NoGitMenuFig); DotSpace;
          };

          design.SpacedParagraph {
            "Select "; design.SpanHighlight { "Git => Clone from Git" }; " to open the connection dialog shown in "; design.FigureReference(GitConnectDialogFig); DotSpace;
          };
        };
      };
    };

    design.AddFigure(GitConnectDialogFig, Here, ExtentWidth, null, false);
    design.FigureCaption(GitConnectDialogFig);

    design.NumberedList {
      "Browse to the Nytril code repository and select its root folder.";
      "Enter the repository address in the Repository URL field.";
      "Provide the sign-in credentials.";
      "Enter a branch (optional).";
      "Select OK and allow Nytril to validate Git repository access.";
    };
  };
}
// ============================================================================

readonly GitConnectedSection GitConnected = new;
class GitConnectedSection: Content {
  Constructor() {
    super.Constructor("Git Is Ready");
  }

  override GetLayout(TechDesign design) = Block {
    Table(PadT(30), null, [new Column(70%), new Column(20), Column.Expand] ) {
      Row {
        Cell {
          design.Heading2 {
            Title;
          };

          design.SpacedParagraph {
            "When the .git folder exists and Git credentials have been entered, Nytril displays the full Git menu shown in "; design.FigureReference(GitConnectedMenuFig); DotSpace;
            "If the repository is already in this state, no further Git setup is required.";
          };

          design.SpacedParagraph {
            "The menu provides Commit, Push, Pull, and Stash commands, along with Changes, History, and Switch Branch. ";
            "To update the repository credentials, select "; design.SpanHighlight { "Git => Git Credentials for Current Repo" }; DotSpace;
          };
        };
        Cell;
        Cell {
          design.AddFigure(GitConnectedMenuFig, Here);
        };
      };
    };
  };
}
// ============================================================================

readonly GitAuthenticationSection GitAuthentication = new;

class GitAuthenticationSection: Content {
  Constructor() {
    super.Constructor("Authentication");
  }

  override GetLayout(TechDesign design) = Block {
    design.Heading2 {
      Title;
    };

    design.SpacedParagraph {
      "Git repositories often require authentication before Nytril can connect, fetch, push, or pull changes. ";
      "Nytril uses a personal access token to authorize Git access. ";
    };

    design.SpacedParagraph {
      "If the connection fails, verify the repository location, then confirm that the Git account has permission to read from or write to the repository. ";
    };

  };
}
