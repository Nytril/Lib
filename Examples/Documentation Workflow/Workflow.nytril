readonly QuickRefSection QuickRef = new;
class QuickRefSection: Content {
  Constructor() {
    super.Constructor(null);
  }

  override GetLayout(TechDesign design) = Block {
    design.Heading3 {
      "Quick Reference";
    };

    design.QuickRefTable {
      design.QuickRefHeaderRow {
        "PHASE I";
        "PHASE II";
        "PHASE III";
      };
      Row {
        design.QuickRefCell {
          design.QuickRefItem(AudienceEnvironmentStep.AnchorTitle , AudienceEnvironmentStep.AnchorText  );
          design.QuickRefItem(OutputStrategyStep.AnchorTitle      , OutputStrategyStep.AnchorText       );
          design.QuickRefItem(IdContentAndDataStep.AnchorTitle    , IdContentAndDataStep.AnchorText     );
        };
        design.QuickRefCell {
          design.QuickRefItem(RepoAndSourceStep.AnchorTitle       , RepoAndSourceStep.AnchorText        );
          design.QuickRefItem(CreateProjectStep.AnchorTitle       , CreateProjectStep.AnchorText        );
          design.QuickRefItem(LocalizationStep.AnchorTitle        , LocalizationStep.AnchorText         );
          design.QuickRefItem(DesignFrameworkStep.AnchorTitle     , DesignFrameworkStep.AnchorText      );
          design.QuickRefItem(DocumentArchitectureStep.AnchorTitle, DocumentArchitectureStep.AnchorText );
          design.QuickRefItem(ImplementLayoutStep.AnchorTitle     , ImplementLayoutStep.AnchorText      );
          design.QuickRefItem(InsertContentStep.AnchorTitle       , InsertContentStep.AnchorText        );
        };
        design.QuickRefCell {
          design.QuickRefItem(TranslationsStep.AnchorTitle        , TranslationsStep.AnchorText         );
          design.QuickRefItem(ValidateAndReviewStep.AnchorTitle   , ValidateAndReviewStep.AnchorText    );
          design.QuickRefItem(PublishStep.AnchorTitle             , PublishStep.AnchorText              );
        };
      };
    };
  };
}

