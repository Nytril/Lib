readonly Localization LocalizationStep = new;
class Localization: StepStyler {
  Constructor() {
    super.Constructor("Configure Localization");
    StepConcepts = [ ConfigsConcept, MeasuresConcept ];
  }

  override GetBody(TechDesign design) = Block {
    design.TightParagraph {
      "If you intend to translate the primary language into other languages, or if you intend to produce documents into more than one unit system or paper system, set up the configuration environment to produce the desired variations.";
    };

    design.TightParagraph {
      "Key points from the "; I{"Configurations concept"};
    };

    design.NumberedList {
      "The Lang file contains the configurations.";
      "You can modify or create configurations arrangements for your project. ";
      "The project must include a reference to the Lang file (i.e., \"include \"Lang\"\").";
    };

    Paragraph;
    design.TightParagraph {
      "If your project will produce both Imperial and Metric variations, review the Measures concept to learn how to properly refer to measures throughout your code. ";
    };
  };

  override GetDescription(TechDesign design) = design.CalloutFrame {
    design.CalloutParagraph {
      "If your project is missing the Lang file, refer to the Configurations concept to learn more about setting up configurations manually.";
    };
  };
}

