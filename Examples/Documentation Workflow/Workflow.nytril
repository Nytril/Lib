readonly RepoAndSource RepoAndSourceStep = new;
class RepoAndSource: StepStyler {
  Constructor() {
    super.Constructor("Establish a Repository and Source Control");
    StepConcepts = [ ConfigsConcept, Repositories, SourceControl ];
  }

  override GetBody(TechDesign design) = Block {
    design.TightParagraph {
      "Determine whether to use the default repository, an existing repository, or a new repository. Connect source control.";
    };

    design.TightParagraph {
      "If using and existing repository with established source control, "; B{"skip this step"} ". ";
    };

    design.TightParagraph {
      "Otherwise, create a new repository and select the required languages to include. ";
      "If only using one language, it is best to still select that single language since that will cause Nytril to scaffold the Configuration system and enable advanced language features. ";
    };

    design.TightParagraph {
      "If you use source control, be sure to connect it to the Nytril code repository. ";
      "If you use Git, you can connect it to Nytril for use inside the IDE (see Source Control concept).";
    };
  };

  override GetDescription(TechDesign design) = design.CalloutFrame {
    design.CalloutParagraph {
      "If a new repository is necessary, you can create a new project during that process. ";
      "In which case, you can skip the next step. ";
    };
  };
}

