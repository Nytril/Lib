readonly PurposeSection Purpose = new;
class PurposeSection: Content {
  Constructor() {
    super.Constructor(null);
  }

  override GetLayout(TechDesign design) = Block {
    design.Heading3 {
      "Purpose";
    };

    design.NormalParagraph {
      "This document covers creating technical documents in Nytril, from preparation through publishing. ";
      "The steps guide engineers and professionals who design repeatable technical documentation for any purpose. ";
      "Technical documents that require ongoing updates, frequent version changes, language translations, or unit conversions fit well with Nytril and this process.";
    };
  };
}

