  }

  override GetBody(TechDesign design) = Block {
    design.TightParagraph {
      "Set up the document architecture to match production requirements.";
    };

    design.TightParagraph {
      "If your purpose is to produce a single document, regalrdless of the variations, then create a Nytril project for a single document. ";
      "If your goal is multiple documents, then set the project up to produce multiple documents. ";
    };
  };

  override GetDescription(TechDesign design) = design.CalloutFrame {
