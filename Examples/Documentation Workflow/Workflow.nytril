// =======================================================

readonly AudienceEnvironment AudienceEnvironmentStep = new;
class AudienceEnvironment: StepStyler {
  Constructor() {
    super.Constructor("Define Audience Environment");
    StepConcepts = [ ConfigsConcept, Repositories ];
  }

  override GetBody(TechDesign design) = Block {
    design.TightParagraph {
      "Define target languages and unit standards before making structural decisions.";
    };

    design.TightParagraph {
      "Documents that require multiple languages, unit systems (imperial and metric), or paper systems require configurations. ";
      "Nytril can scaffold configurations during repository creation, which is why this decision belongs early in the workflow. ";
      "You can create or adjust configurations later if this information is not yet available.";
    };

    design.TightParagraph {
      "A key factor in this step is deciding whether to use existing configurations or create fresh ones. ";
      "Using common language files across projects is a substantive advantage for an organization. ";
      "It reduces the need to continuously restate common terms or phrases and can reduce translation load. ";
    };
  };

  override GetDescription(TechDesign design) = design.CalloutFrame {
    design.CalloutParagraph {
      "Not every project can benefit from using common configurations, a fresh start may be a better stategy. ";
      "Nytril allows for full control over how you deploy and use configuration metrics and you can configure them at any time. ";
    };
  };
}

