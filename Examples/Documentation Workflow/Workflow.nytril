readonly DesignFramework DesignFrameworkStep = new;
class DesignFramework: StepStyler {
  Constructor() {
    super.Constructor("Design Document Framework");
  }

  override GetBody(TechDesign design) = Block {
    design.TightParagraph {
      "Define layout, visual hierarchy, and structural components before implementation."
    };

    design.TightParagraph {
      "Design the document layout including headers, footers, typography systems, theme, and page structure. ";
      "A good practice is to establish reusable layout patterns for simplified coding and code maintenance. ";
    };

