    };

    design.TightParagraph {
      "Your project may require structured data from an external source such as product specifications, configuration tables, or other content. ";
      "Identify these sources early, define how to access them, and gather connection strings, keys, or credentials for use within Nytril. ";
    };
  };

  override GetDescription(TechDesign design) = null;
}
