readonly ImplementLayout ImplementLayoutStep = new;
class ImplementLayout: StepStyler {
  Constructor() {
    super.Constructor("Implement Layout");
    PrimaryAction = new ActionObj(Actions.ToLink, "Fundamentals Videos", "https://www.youtube.com/playlist?list=PLvme8jGUQBRyHhHE29HcOwQCca_yaRX30");
    StepConcepts  = [DesignTemplates, HeadersAndFooters];
  }

  override GetBody(TechDesign design) = Block {
    design.TightParagraph {
      "The bulk of your work will take place between this step and the next. ";
      "Expect to cycle between these two steps until the development is complete.";
    };

    design.TightParagraph {
      "If your intent is to use Nytril-provided design templates or to develop your own styling system, refer to the Design Template concept and set up your project accordingly. ";
    };

    design.TightParagraph {
      "Set the document’s margins, size, and other properties using parameters of the Document formatter. ";
      "If you use a provided design template, refer to the documentation on how to set up the document for that system.";
    };

    design.TightParagraph {
      "Design the Headers and footers. ";
    };

    design.TightParagraph {
      "You are now ready to start adding formatted content. ";
    };
  };

  override GetDescription(TechDesign design) = null;
}
