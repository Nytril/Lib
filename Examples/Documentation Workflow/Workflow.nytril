readonly InsertContent InsertContentStep = new;
class InsertContent: StepStyler {
  Constructor() {
    super.Constructor("Insert Content");
    Body        = "Insert dynamic and structured content into the defined layout framework.";

    Description = "The bulk of the effort is in this step. This is where the content is placed into the document structure."
                  "Blocks of text that are being pasted in, can be auto inserted using Ctrl-Shift-V, where the text will be automatically placed into the language file, and a variable inserted into code."
                  "Integrate the necessary structured data, reusable content blocks, and any other necessary information into the document. "
                  "The conclusion of this step should result in fully functional documentation.";
  }

  override GetBody(TechDesign design) = Block {
    design.TightParagraph {
      "Insert dynamic and structured content into the defined layout framework.";
    };

    design.TightParagraph {
      "This is where the document starts coming together. ";
    };

    design.TightParagraph {
      "Begin adding content. ";
      "If using the design system, follow the methods shown in the related documentation. ";
      "Using Nytril formatters, begin laying out the content into the document. ";
      "Work iteratively with the prior step, until the process is complete. ";
    };

    design.TightParagraph {
      "If adding structured data from a data source, revise the appropriate formatter to include it. ";
      "Press "; design.Emphasis{"F5"} " after changes to see the result in the document. ";
    };
  };

  override GetDescription(TechDesign design) = design.CalloutFrame {
    design.CalloutParagraph {
      "Later in this document is a discussion on converting text strings into Lang variables, as is necessary for translations. ";
      "You can insert text directly into Lang variables using the keystroke Ctrl-Shift-L, wherein Nytril places your named variable at the string position and moves the text into the appropriate language file.";
    };
  };
}
