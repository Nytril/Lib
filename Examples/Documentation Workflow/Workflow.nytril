readonly Phase1Sec Phase1 = new;
class Phase1Sec: Content {
  Constructor {
    super.Constructor("Phase I");

    AddContent(AudienceEnvironmentStep);
    AddContent(OutputStrategyStep);
    AddContent(IdContentAndDataStep);
    AddContent(DesignFrameworkStep);
  }

  override GetLayout(TechDesign design) = Block {
    design.Heading4 {
      Title;
    };

    design.Heading2 {
