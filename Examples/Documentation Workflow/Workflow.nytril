using Format, HelpConcepts;

// ==================================================================================================================

class TechDocWorkflowContent: AuthoredContent {
  var int StepNumber;
  const DocTitle = "Technical Documentation Engineering Workflow";

  Constructor {
    super.Constructor("Technical Documentation Engineering Workflow");

    Watermark = "DRAFT";

    AddAuthor(People.ColbertAuthor);
    AddAuthor(People.McCreightAuthor);

    AddContent(QuickRef);
    AddContent(Purpose);
    AddContent(Phase1);
    AddContent(Phase2);
    AddContent(Phase3);
  }
}
// ==================================================================================================================

class StepStyler: Content {
  var           Body,
                Description,
                StepConcepts;
  var ActionObj PrimaryAction;
  var bool      PageBreakBefore,
                PageBreakAfter;


  Constructor(string title) {
    super.Constructor(title);
    NeedsNumbering  = true;
    NeedsAnchor     = true;
    PrimaryAction   = null;
    PageBreakBefore = false;
    PageBreakAfter  = false;
  }

  virtual GetBody(TechDesign design) = design.NormalParagraph { Body };

  virtual GetDescription(TechDesign design) = design.CalloutFrame { design.CalloutParagraph { Description } };

  override GetLayout(TechDesign design) = {
    if (PageBreakBefore)
      PageBreak;

    design.IndentedBlock {
      design.NumberedHeading(SectionLevel, Title, AnchorText) {
        if (PageBreakBefore)
          SpaceBefore: 0;
      };

      GetBody(design);

      if(PrimaryAction is valid) {
        design.PrimaryActionParagraph {
            design.ActionSpan(PrimaryAction);
        };
      }

      GetDescription(design);

      if (StepConcepts is valid) {
        design.SpecialHeading1 { "Concepts" };
        design.SpecialFrame1 {
          each(StepConcepts);
        };
      }
      else
        design.SpecialFrame1;
    };

    if (PageBreakAfter)
      PageBreak;
  };
}
// ==================================================================================================================

readonly QuickRefSection QuickRef = new;
class QuickRefSection: Content {
  Constructor() {
    super.Constructor(null);
  }

  override GetLayout(TechDesign design) = Block {
    design.Heading3 {
      "Quick Reference";
    };

    design.QuickRefTable {
      design.QuickRefHeaderRow {
        "PHASE I";
        "PHASE II";
        "PHASE III";
      };
      Row {
        design.QuickRefCell {
          design.QuickRefItem(AudienceEnvironmentStep.AnchorTitle , AudienceEnvironmentStep.AnchorText  );
          design.QuickRefItem(OutputStrategyStep.AnchorTitle      , OutputStrategyStep.AnchorText       );
          design.QuickRefItem(IdContentAndDataStep.AnchorTitle    , IdContentAndDataStep.AnchorText     );
          design.QuickRefItem(DesignFrameworkStep.AnchorTitle     , DesignFrameworkStep.AnchorText      );
        };
        design.QuickRefCell {
          design.QuickRefItem(RepoAndSourceStep.AnchorTitle       , RepoAndSourceStep.AnchorText        );
          design.QuickRefItem(CreateProjectStep.AnchorTitle       , CreateProjectStep.AnchorText        );
          design.QuickRefItem(LocalizationStep.AnchorTitle        , LocalizationStep.AnchorText         );
          design.QuickRefItem(ImplementLayoutStep.AnchorTitle     , ImplementLayoutStep.AnchorText      );
          design.QuickRefItem(InsertContentStep.AnchorTitle       , InsertContentStep.AnchorText        );
        };
        design.QuickRefCell {
          design.QuickRefItem(TranslationsStep.AnchorTitle        , TranslationsStep.AnchorText         );
          design.QuickRefItem(ValidateAndReviewStep.AnchorTitle   , ValidateAndReviewStep.AnchorText    );
          design.QuickRefItem(PublishStep.AnchorTitle             , PublishStep.AnchorText              );
        };
      };
    };
  };
}
// =======================================================

readonly PurposeSection Purpose = new;
class PurposeSection: Content {
  Constructor() {
    super.Constructor("Purpose");
  }

  override GetLayout(TechDesign design) = Block {
    design.Heading2 {
      Title;
    };

    design.SpacedParagraph {
      "This document covers creating technical documents in Nytril, from preparation through publishing. ";
      "The steps guide engineers and professionals who design repeatable technical documentation for any purpose. ";
      "Technical documents that require ongoing updates, frequent version changes, language translations, or unit conversions fit well with Nytril and this process.";
    };
  };
}
