readonly RepoAndSource RepoAndSourceStep = new;
class RepoAndSource: StepStyler {
  Constructor() {
    super.Constructor("Establish a Repository and Source Control");
    StepConcepts = [ ConfigsConcept, Repositories, SourceControl ];
  }

  override GetBody(TechDesign design) = Block {
    design.TightParagraph {
      "Determine whether to use the default repository, an existing repository, or a new repository. Connect source control to the chosen repository.";
    };

    design.TightParagraph {
      "If using an existing repository, skip repository creation and confirm that source control is connected, if applicable. ";
    };

    design.TightParagraph {
      "Otherwise, create a new repository and select the required languages to include. ";
      "If only using one language, it is best to select that single language since that will cause Nytril to scaffold the Configuration system and enable advanced language features. ";
    };

    design.TightParagraph {
      "If you use source control, be sure to connect it to the chosen repository. ";
      "If using Git, you can connect it to Nytril for use inside the IDE (see Source Control concept).";
    };
  };

  override GetDescription(TechDesign design) = design.CalloutFrame {
    design.CalloutParagraph {
      "If a new repository is necessary, a project can be created during repository setup. ";
      "If the project is created at this stage, skip the next step. ";
    };
  };
}
// =======================================================

readonly CreateProject CreateProjectStep = new;
class CreateProject: StepStyler {
  Constructor() {
    super.Constructor("Create the Project");
    PrimaryAction = new ActionObj(Actions.ToLink, "New Project Video", "https://youtu.be/HgsddkTq_EI");
  }

  override GetBody(TechDesign design) = Block {
    design.TightParagraph {
      "Create a new project in Nytril under the intended repository.";
    };

    design.TightParagraph {
      "If you already created the project in the prior step, "; design.Emphasis{"skip this step"} ". ";
    };

    design.TightParagraph {
      "Be sure to select the repository using the "; design.Emphasis{"Repo"} " menu option before creating the project. ";
      "Doing so ensures Nytril creates the project under the intended repository.";
    };

    design.TightParagraph {
      "If your purpose is to produce a single document, even if the document will be produced in more than one configuration, then create a Nytril project for a single document. ";
      "If your objective is to produce multiple documents, then select the option to scaffold a multi-document project. ";
    };
  };

  override GetDescription(TechDesign design) = design.CalloutFrame {
    design.CalloutParagraph {
      "A project created during repository setup starts with a single-document scaffold. ";
      "Developers can revise it later to support multiple documents. ";
      "If the project is created during repository setup, skip step 6";
    };
  };
}
