readonly Translations TranslationsStep = new;
class Translations: StepStyler {
  Constructor() {
    super.Constructor("Translations - Optional");
    StepConcepts = [TranslationsConcept];
  }

  override GetBody(TechDesign design) = Block {
    design.TightParagraph {
      "This step is optional, use this process if you intend to translate the entered text into another language. ";
    };

    design.TightParagraph {
      "Refer to the Translations concept for more detailed information on translating text. ";
    };

    design.TightParagraph {
      "In Summary, the process involves: ";
    };

    design.NumberedList {
      Span {"Moving strings into the language file using Ctrl-Shift-V or the "; B{"Text to Lang Symbol"} " feature. " };
      Span {"Right clicking on that language file and selecting "; design.SpanHighlight{"Advanced => Translate Language Strings"} ". " };
      "Use the \"revu\" keyword on translated text and follow the dialog to translate the text. ";
      "Validating the translations and removing the revu keywords ";
      "Fixing any resulting display issues.";
    };
  };

  override GetDescription(TechDesign design) = design.CalloutFrame {
    design.CalloutParagraph {
      "After translating text, select the alternate language option in the Document menu, then open the document. ";
      "If you opted to use the \"revu\" keyword, translated text will be purple until reviewed. ";
    };
  };
}

