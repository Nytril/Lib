using Format, HelpConcepts;

// ==================================================================================================================

class TechDocWorkflowContent: AuthoredContent {
  var int StepNumber;
  const DocTitle = "Technical Documentation Engineering Workflow";

  Constructor {
    super.Constructor("Technical Documentation Engineering Workflow");

    Watermark = "DRAFT";

    AddAuthor(People.ColbertAuthor);
    AddAuthor(People.McCreightAuthor);

    AddContent(QuickRef);
    AddContent(Purpose);
    AddContent(Phase1);
    AddContent(Phase2);
    AddContent(Phase3);
  }
}

// ==================================================================================================================

class StepStyler: Content {
  var           Body,
                Description,
                StepConcepts;
  var ActionObj PrimaryAction;
  var bool      PageBreakBefore,
                PageBreakAfter;


  Constructor(string title) {
    super.Constructor(title);
    NeedsNumbering  = true;
    NeedsAnchor     = true;
    PrimaryAction   = null;
    PageBreakBefore = false;
    PageBreakAfter  = false;
  }

  virtual GetBody(TechDesign design) = design.NormalParagraph { Body };

  virtual GetDescription(TechDesign design) = design.CalloutFrame { design.CalloutParagraph { Description } };

  override GetLayout(TechDesign design) = {
    if (PageBreakBefore)
      PageBreak;

    design.IndentedBlock {
      design.NumberedHeading(SectionLevel, Title, AnchorText) {
        if (PageBreakBefore)
          SpaceBefore: 0;
      };

      GetBody(design);

      if(PrimaryAction is valid) {
        design.PrimaryActionParagraph {
            design.ActionSpan(PrimaryAction);
        };
      }

      GetDescription(design);

      if (StepConcepts is valid) {
        design.SpecialHeading1 { "Concepts" };
        design.SpecialFrame1 {
          each(StepConcepts);
        };
      }
      else
        design.SpecialFrame1;
    };

    if (PageBreakAfter)
      PageBreak;
  };
}

