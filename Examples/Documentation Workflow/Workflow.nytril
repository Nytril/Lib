readonly AudienceEnvironment AudienceEnvironmentStep = new;
class AudienceEnvironment: StepStyler {
  Constructor() {
    super.Constructor("Define Audience Environment");
    StepConcepts = [ ConfigsConcept, Repositories ];
  }

  override GetBody(TechDesign design) = Block {
    design.TightParagraph {
      "Define target languages and unit standards before making structural decisions.";
    };

    design.TightParagraph {
      "Documents that require multiple languages, unit systems (imperial and metric), or paper systems require configurations. ";
      "Nytril can scaffold configurations during repository creation, which is why this decision belongs early in the workflow. ";
      "You can create or adjust configurations later if this information is not yet available.";
    };

    design.TightParagraph {
      "A key factor in this step is deciding whether to use existing configurations or create fresh ones. ";
      "Using common language files across projects is a substantive advantage for an organization. ";
      "It reduces the need to continuously restate common terms or phrases and can reduce translation load. ";
    };
  };

  override GetDescription(TechDesign design) = design.CalloutFrame {
    design.CalloutParagraph {
      "Not every project benefits from shared configurations. ";
      "A fresh start may be a better strategy. ";
      "Nytril allows for full control over how you deploy and use configuration metrics and you can configure them at any time. ";
    };
  };
}
// =======================================================

readonly OutputStrategy OutputStrategyStep = new;
class OutputStrategy: StepStyler {
  Constructor() {
    super.Constructor("Define Output Strategy");
    StepConcepts = [ ConfigsConcept, Publishing ];
  }

  override GetBody(TechDesign design) = Block {
    design.TightParagraph {
      "Choose electronic delivery, print publishing, or hybrid output models."
    };

    design.TightParagraph {
      KeepTogether: true;
      "Nytril's built-in output methods include publishing and exporting, two concepts explained in more detail in the Publishing concept. ";
      "Of course, you can write your own methods to output content. ";
    };

    design.TightParagraph {
      "Understanding the intended method of distribution helps in scaffolding the project, though one can always configure these options later. ";
      "For instance, using Nytril's hosting environment for a rich and interactive user experience requires the creation of a "; design.Emphasis{"Site"}; " in the code (see the Publishing concept). ";
      "All other forms of output, other than writing your own output files, require no special setup. ";
    };
  };

  override GetDescription(TechDesign design) = design.CalloutFrame {
    design.CalloutParagraph {
      "As discussed in step 1, the output may require modification for local considerations, such as the paper-size system and the units of measure. ";
      "Producing these output variations requires changes to the configurations in the "; design.Emphasis{"Lang"} " file. ";
    };
  };
}
