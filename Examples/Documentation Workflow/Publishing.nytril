readonly OnlinePublishFigure  OnlinePublishFig = new;
class  OnlinePublishFigure: Content {
  readonly var double Width;
  Constructor() {
    super.Constructor("Online Publish Options");
    Width = 621 * 0.75;
  }

  override GetCaption(TechDesign design) = Title;

  override GetLayout(TechDesign design) = FitBox(new Image(res "OnlinePublishOptions.png"), Width, null, 2);
}