readonly MainSiteFigure  MainSiteFig = new;
class  MainSiteFigure: Content {
  Constructor() {
    super.Constructor("Adding Site and Realm");
  }

  override GetCaption(TechDesign design) = Title;

  override GetLayout(TechDesign design) = design.CodeParagraph {
    TextHeight: 8px;
    var line = SourceSelection(attribute Main.Site).Line;
    SourceSelectionLines(res "Main.nytril", line, line + 6);
  };
}

