class  FullPublishFigure: Content {
  Constructor() {
    super.Constructor("Online Publish Options");
  }

  override GetCaption(TechDesign design) = Title;

  override GetLayout(TechDesign design) = FitBox(new Image(res "FullPublishDialog.png"), ExtentWidth - 4, null, 2);
}

