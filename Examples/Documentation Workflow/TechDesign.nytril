using Format;

include "DesignPalette";
include "TechDesignToolbar";
include "TechDesignReqs";

/* ======================================================================================
   Tech Design Template

   This template provides for information to be arranged in a combination of phases,
   titled sections, subtitled content, and badge-numbered sections.

   This template includes a toolbar for selecting the overridden designs and available color pallets.
   To use the toolbar, insert "readonly ShowDesignControls    = true;" near the top of your main file.

   This design template includes all the basic formatters including these assignments and /or functionality:

   Header1            PHASE
   Header2            Section Title
   Header3            SubTitle
   Header4            Header1 with no spacing
   NumberedHeading    Numbered Section            Number badge, Indented, Bold, Anchored, Space Before.
   NormalParagraph    Body Text                   LibertinusSans, 11pt.

   Numbered sections are autonumbered.
   Figures are auto captioned and autonumbered.
   Figure References contain tip popups.

   Callouts and Code Blocks.
   Quick reference table.

   All styles and settings are virtual and thus can be and are overridden in the inhereting
   TechDesigns. See the TechDesigns file for more.

   ======================================================================================
*/

class TechDesign {
  var string          Name;
  var Thickness       Margins;
  var int             SectionIndentation,
                      SectionIndex;
  var DesignPalette   Palette;

  Constructor(string name, Thickness margins) {
    Name                = name;
    Margins             = margins;
    SectionIndentation  = 42;
  }

  private AddBody(Content content) {
    return content.GetLayout(this);
  }

  virtual AddMainTitle(AuthoredContent content) = MainTitle {
    content.Title
  };

  virtual GetContentTip(Content content) = Frame(6") {
    content.GetCaption(this) ?? content.Title;
    Paragraph;
    AddBody(content);
  };

  virtual AddFigure(Content content, FigureOptions options, width = ExtentWidth, height = null, showCaption = true) = Figure(width, height, content, options) {
    var caption  = content.GetCaption(this) ?? content.Title;
    var table   = options.HasFlag(FigureOptions.Table);
    if (caption is valid) {
      var cap = Frame {
        Paragraph {
          Span {
            Bold;
            table ? "Table" : "Figure";
            Tex.nbsp;
            if (table)
              DocFields.TableSequence(content);
            else
              DocFields.FigureSequence(content);
            DotSpace;
          };
          caption;
        };
      };

      if (showCaption)
        Caption: cap;
    }

    PushExtentSize(new(width, ExtentHeight));
    Paragraph {
      DocFields.Anchor(content.Name);
      Frame(width) {
        AddBody(content);
      };
    };
    PopExtent;
  };

  virtual SetTextStyle = {
    TextFamily: TextFamilies.LibertinusSerif;
    TextHeight: 10pt;
    TextColor: Palette.Dark1
  };

  virtual SetDocumentOptions(AuthoredContent content) = {
    if (!ShowDesignControls)
      Watermark: content.Watermark;
    SetTextStyle;
  };

  virtual ShowChild(Content content) = Block {
    AddBody(content);

    foreach (var c in content.Children)
      ShowChild(c);
  };

  virtual ShowContent(AuthoredContent content) = Block {
    var topNumber = 1;

    foreach (var c in content.Children)
      topNumber = c.AssignStructuredContent(1, topNumber, Empty, Dot);

    foreach (var c in content.Children)
      ShowChild(c);
  };

  virtual GetStyledDocument(AuthoredContent content) {
    if (ShowDesignControls && !System.IsPublishing) {
      return DesignToolbar.GetToolbarDocument(0.25") {
        SectionNextPage(Margins, null, null, null, null, new(8.5", 11")) {
          Footer: GetFooter(content);
        };

        SetDocumentOptions(content);
        GetDocBody(content);
      };
    }
    else {
      return Document(Margins) {
        SetDocumentOptions(content);
        Footer: GetFooter(content);
        GetDocBody(content);
      };
    }
  }

  private GetDocBody(AuthoredContent content) = Block {
    AddMainTitle(content);

    ShowContent(content);
  };

  virtual GetFooter(AuthoredContent content) = FooterBlock {
    FooterParagraph {
      "Created in Nytril";
    };
    FooterParagraph {
      Tex.copyright 2026 " Nytril LLC";
    };
  };

  // -----------------------------
  // Default Styles - Alphabetical
  // -----------------------------
  virtual ActionSpan(ActionObj action) = Span { action.Name; Action: new Action(action.Type, action.Link); };

  virtual CalloutFrame                = Frame(ExtentWidth - SectionIndentation, null, BorderAll(new(1, 4, Palette.Accent4))) {
    Margin: new Thickness(0, 12, 0, 5);
    Background: Palette.Lighten(Palette.Light2, 80);
    BorderRadius: 3;
  };

  virtual CalloutParagraph            = NormalParagraph   { TextColor: Palette.Dark2; TextHeight: 8pt; SpaceAfter: 6px; };
  virtual CodeParagraph               = NormalParagraph   { ParBackground: Palette.Dark1; TextHeight: 11px; };

  virtual FigureCaption(Content figure) = Paragraph {
    Span {FigureReference(figure) DotSpace; Bold};
    figure.Title;
    SpaceAfter: 14px;
  };

  FigureReference(Content content) = Span {
    "Figure ";
    DocFields.FigureReference(content);
    TipAction: new ContentTipAction(content, this);
  };

  virtual FooterBlock                 = MarginBlock       (0.5");
  virtual FooterParagraph             = Paragraph         { ParAlignment: Center; TextHeight: 12px; TextColor: Palette.Lighten(Palette.Dark1, 75); };
  virtual Heading1                    = Paragraph         { Bold; TextHeight: 18pt; SpaceBefore: 36; };
  virtual Heading2                    = Paragraph         { Bold; TextHeight: 16pt;                  };
  virtual Heading3                    = Paragraph         { Bold; TextHeight: 14pt;                  };
  virtual Heading4                    = Heading1          { SpaceBefore: 0;                          };
  virtual HyperlinkParagraph          = Paragraph         { Underline; TextColor: Palette.Hyperlink  };
  virtual IndentedBlock               = Block             { LeftIndent: SectionIndentation;          };
  virtual InLineLink                  = Span              { Underline; TextColor: Palette.Dark2      };
  virtual MainTitle                   = Paragraph         { TextFamily: TextFamilies.LibertinusSerif; Bold; TextHeight: 19pt; };
  virtual NormalParagraph             = Paragraph         { TextFamily: TextFamilies.LibertinusSerif; TextHeight: 11pt; };

  virtual NumberedHeading(level, title, anchorText) = Paragraph {
    SpaceBefore: 28;
    SpaceAfter: 6px;
    LeftIndent: SectionIndentation;
    NumberedHeadingBadge { level };
    Tab;
    NumberedHeadingTitle { title };
    DocFields.Anchor(anchorText);
  };

  virtual NumberedHeadingBadge = HBox(null, null, new Border(new Edge(1, 10, Palette.Dark2), new(0, 1), new(0, 10), new(1, 1, Palette.Dark2))) {
    HAlign:       Center;
    Background:   Palette.Lighten(Palette.Light2, 80);
    TextColor:    Palette.Dark2;
    TextHeight:   13pt;
    BorderRadius: 4;
  };

  virtual NumberedHeadingTitle                 = Span            { TextFamily: TextFamilies.LibertinusSans; Bold; TextHeight: 14pt;                          };
  virtual NumberedList                         = ListBlock       ( @Enumerators.NumberDot                                                                    );
  virtual PrimaryActionParagraph               = Paragraph       { ParAlignment: Right; TextColor: Palette.Accent1; Underline;                               };
  virtual QuickRefCell                         = Cell            { LineHeight: 18px; TextColor: Palette.Hyperlink; TextHeight: 12px; TextLetterSpace: -0.15  };
  virtual QuickRefHeaderRow                    = Row             ( null, null, 25, LineRules.Exact) { TextHeight: 17px;                                      };
  virtual QuickRefItem(anchorName, anchorText) = Span            { anchorName; Action: new Action(Actions.ToAnchor, anchorText);                             };
  virtual QuickRefTable                        = Table           ( null, null, [Column.Expand, Column.Expand, Column.Expand]                                 );

  virtual RealtiveHBox = HBox {
    HRelative: Page;
    VRelative: Page;
    Wrapping: BehindText;
    X: 0;
    Y: 0;
    HAlign: Right;
  };

  virtual SpacedParagraph                      = NormalParagraph { SpaceAfter: 24px;                                                                         };
  virtual SpanHighlight                        = Span            { TextColor: Palette.Accent5                                                                  };
  virtual SpecialHeading1                      = Paragraph       { TextColor: Palette.Accent2; TextHeight: 10pt;                                             };
  virtual SpecialFrame1                        = Frame           { Margin: new Thickness(14, 0, 0, 0); TextHeight: 8pt; TextColor: Palette.Accent2;          };

  TableReference(Content content) = Span {
    "Table ";
    DocFields.TableReference(content);
    TipAction: new ContentTipAction(content, this);
  };

  virtual TightParagraph = NormalParagraph { SpaceAfter: 6px; };
}
