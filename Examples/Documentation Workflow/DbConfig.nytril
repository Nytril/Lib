readonly  DbQueryFigure  DbQueryFig = new;
class  DbQueryFigure: Content {
  Constructor() {
    super.Constructor("Simple Database Query");
  }

  private void SampleConn {
    var connection = new DB.DbConnection("");

    var results = connection.RunQuery("Select * from People");
  }

  override GetLayout(TechDesign design)  = design.CodeParagraph {
    SourceSelectionLines(null, 36, 37);
  };

  override GetCaption(TechDesign design) = Span { "Basic Database Connection" };
}
