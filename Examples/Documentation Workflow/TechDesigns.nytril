using Format;
include "TechDesign";

/* ======================================================================================
   Tech Design Variation 1

   (Heading1)           PHASE                 Accent1 color, All Caps, Bold, 18pt.
   (Heading2)           Title                 Bold, 16pt.
   (Heading3)           SubTitle              LibertinusSans, Bold, 14pt.
   (Heading4)           PHASE                 Heading1 with no spacing.

   ======================================================================================
*/
readonly TechDesign1 TechDesignVar1 = new;
class TechDesign1: TechDesign {
  Constructor {
    super.Constructor("Tech Design Variation 1", 1");

    SectionIndentation = 42;
  }

  override Heading1 = Paragraph {
    TextHeight: 18pt;
    SpaceBefore: 36;
    TextColor: Palette.Accent1;
    TextCase: AllUpper;
    Bold;
  };

  override Heading2 = Paragraph {
    TextHeight: 16pt;
    TextWeight: TextWeights.Medium;
    Bold;
  };

  override Heading3 = Paragraph {
    TextFamily: TextFamilies.LibertinusSans;
    SpaceBefore: 24;
    SpaceAfter: 6;
    Bold;
    TextHeight: 14pt;
  };

  override NumberedHeadingBadge = HBox(null, null, new Border(new Edge(1, 10, Palette.Dark2), new(0, 1), new(0, 10), new(1, 1, Palette.Dark2))) {
    HAlign:       Center;
    TextFamily:   TextFamilies.Calibri;
    Background:   Palette.Dark2;
    TextColor:    Palette.Light1;
    TextHeight:   13pt;
    BorderRadius: 4;
  };
}


/* ======================================================================================
   Tech Design Variation 2

   (Heading1)           PHASE                 Dark1 color, Accent1 Background, All Caps, Bold, 18pt.
   (Heading2)           Title                 Accent1 darkened color, Bold, 16pt.
   (Heading3)           SubTitle              LibertinusSans, Bold, 14pt.
   (Heading4)           PHASE                 Heading1 with no spacing.

   ======================================================================================
*/

readonly TechDesign2 TechDesignVar2 = new;
class TechDesign2: TechDesign {
  Constructor {
    super.Constructor("Tech Design Variation 2", 1");

    SectionIndentation   = 42;
  }

  override Heading1 = Paragraph {
    TextHeight: 18pt;
    SpaceBefore: 36;
    TextColor: Palette.Dark1;
    TextCase: AllUpper;
    ParBackground: Palette.Accent1;
    Bold;
  };

  override Heading2 = Paragraph {
    TextHeight: 16pt;
    TextWeight: TextWeights.Medium;
    TextColor: Palette.Darken(Palette.Accent1, 50);
    Bold;
  };

  override Heading3 = Paragraph {
    TextFamily: TextFamilies.LibertinusSans;
    SpaceBefore: 24;
    SpaceAfter: 6;
    Bold;
    TextHeight: 14pt;
  };

  override NumberedHeadingBadge = HBox(null, null, new Border(new Edge(1, 10, Palette.Dark2), new(0, 1), new(0, 10), new(1, 1, Palette.Dark2))) {
    HAlign:       Center;
    TextFamily:   TextFamilies.Calibri;
    Background:   Palette.Accent1;
    TextColor:    Palette.Light1;
    TextHeight:   13pt;
    BorderRadius: 4;
  };
}


/* ======================================================================================
   Tech Design Variation 3

   (MainTitle)          Doc Title             Centered, Top Bottom borders

   (Heading1)           PHASE                 Accent1 color darkened, Centered, All Caps, Bold, 18pt.
   (Heading2)           Title                 Centered, Bold, 16pt.
   (Heading3)           SubTitle              LibertinusSans, Centered, Bold, 14pt.
   (Heading4)           PHASE                 Heading1 with no spacing.

   ======================================================================================
*/

readonly TechDesign3 TechDesignVar3 = new;
class TechDesign3: TechDesign {
  Constructor {
    super.Constructor("Tech Design Variation 3", 1");

    SectionIndentation   = 42;
  }

  override MainTitle = Paragraph(new Border(0, new Edge(1, 20, Palette.Accent3), 0, new(1, 20, Palette.Accent3))) {
    TextFamily: TextFamilies.LibertinusSerif;
    Bold;
    TextHeight: 16pt;
    ParAlignment: Center;
    TextCase: AllUpper;
  };

  override Heading1 = Paragraph {
    TextHeight: 18pt;
    SpaceBefore: 36;
    TextColor: Palette.Darken(Palette.Accent1, 50);
    TextCase: AllUpper;
    Bold;
    ParAlignment: Center;
  };

  override Heading2 = Paragraph {
    TextHeight: 16pt;
    TextWeight: TextWeights.Medium;
    TextColor: Palette.Dark1;
    Bold;
    ParAlignment: Center;
  };

  override Heading3 = Paragraph {
    TextFamily: TextFamilies.LibertinusSans;
    SpaceBefore: 24;
    SpaceAfter: 6;
    Bold;
    TextHeight: 14pt;
    TextCase: AllUpper;
    ParAlignment: Center;
  };

  override NumberedHeadingBadge = HBox(null, null, new Border(new Edge(1, 10, Palette.Dark2), new(0, 1), new(0, 10), new(1, 1, Palette.Dark2))) {
    HAlign:       Center;
    TextFamily:   TextFamilies.Calibri;
    Background:   Palette.Darken(Palette.Accent1, 50);
    TextColor:    Palette.Light1;
    TextHeight:   13pt;
    BorderRadius: 4;
  };
}

// ======================================================================================
//  Tech Design Variation 4
//
//  This design is similar to design 3, but with left justified section headers.
// ======================================================================================

readonly TechDesign4 TechDesignVar4 = new;
class TechDesign4: TechDesign {
  Constructor {
    super.Constructor("Tech Design Variation 4", 1");

    SectionIndentation   = 42;
  }

  override MainTitle = Paragraph(new Border(0, new Edge(1, 20, Palette.Accent3), 0, new(1, 20, Palette.Accent3))) {
    TextFamily: TextFamilies.LibertinusSerif;
    Bold;
    TextHeight: 16pt;
    ParAlignment: Center;
    TextCase: AllUpper;
  };

  override Heading1 = Paragraph {
    TextHeight: 18pt;
    SpaceBefore: 36;
    TextColor: Palette.Darken(Palette.Accent1, 50);
    TextCase: AllUpper;
    Bold;
    ParAlignment: Left;
  };

  override Heading2 = Paragraph {
    TextHeight: 16pt;
    TextWeight: TextWeights.Medium;
    TextColor: Palette.Dark1;
    Bold;
    ParAlignment: Left;
  };

  override Heading3 = Paragraph {
    TextFamily: TextFamilies.LibertinusSans;
    SpaceBefore: 24;
    SpaceAfter: 6;
    Bold;
    TextHeight: 14pt;
    TextCase: AllUpper;
    ParAlignment: Left;
  };

  override NumberedHeadingBadge = HBox(null, null, new Border(new Edge(1, 10, Palette.Dark2), new(0, 1), new(0, 10), new(1, 1, Palette.Dark2))) {
    HAlign:       Center;
    TextFamily:   TextFamilies.Calibri;
    Background:   Palette.Darken(Palette.Accent1, 50);
    TextColor:    Palette.Light1;
    TextHeight:   13pt;
    BorderRadius: 4;
  };
}