class TranslationsHelpConcept: AuthoredContent {
  Constructor {
    super.Constructor("Translations");

    Watermark = "DRAFT";

    AddAuthor(People.ColbertAuthor);
    AddAuthor(People.McCreightAuthor);

    AddContent(TransPurpose);
    AddContent(TransSummary);
    AddContent(TransTextOrg);
    AddContent(TransExecute);
    AddContent(TransReview);
    AddContent(TransPublish);
  }
}
//======================================================================

readonly TransPurposeSection TransPurpose = new;
class TransPurposeSection: Content {
  Constructor() {
    super.Constructor("Purpose");
  }

  override GetLayout(TechDesign design) = Block {
    design.Heading2 {
      Title;
    };

    design.SpacedParagraph {
      "This document describes the strategy of text management for the purpose of translating the text into additional languages. ";
      "It will also describe the process of translating text and reviewing the translations. ";
      "An understanding and implementation of Nytril Configurations is required. ";
      "There must be at least two configurations with each being a different language to translate text. ";
    };

    design.SpecialHeading1 { "Concepts" };
    design.SpecialFrame1 {
      ConfigsConcept;
    };
  };
}
//======================================================================

readonly TransSummarySection TransSummary = new;
class TransSummarySection: Content {
  Constructor() {
    super.Constructor("Summary");
  }

  override GetLayout(TechDesign design) = Block {
    design.Heading2 {
      SpaceBefore: 20px;
      Title;
    };

    design.SpacedParagraph {
      "The translation process involves first organizing all text into a single primary language file. ";
      "Next, running a translation on that file generating the translated text into an additional language file. ";
      "Reviewning the translated text, and lastly, opening the document in the new language and verifying the layout. ";
    };

    design.SpacedParagraph {
      "Nytril has special tools to make certain steps easier, those will be discussed in the relevant areas. ";
    };
  };
}
