readonly TransReviewFileSection TransReviewFileSect = new;
class TransReviewFileSection: Content {
  Constructor() {
    super.Constructor("Review Translated Strings");
  }

  override GetLayout(TechDesign design) = Block {
    design.Heading2 {
      Title;
    };

    design.SpacedParagraph {
      "Navigate to the language file of the target language, in this case the target language is French, so that file is \"French.nytril.\" ";
      "This file also exists as an include in the Lang file configurations. ";
      "Open the file. ";
    };

    design.SpacedParagraph {
      "As shown in "; design.FigureReference(TransResultsFig); ", Nytril generates a copy of the source language file contents keeping the variable names the same, but translating the strings. ";
      "If including the "; design.SpanHighlight{"revu"}; " keyword was selected, then the results will appear as they do here in "; design.FigureReference(TransResultsFig); " where the results are purple. ";
      "Excluding the revu keyword will result in a normal colored response.";
    };

    design.SpacedParagraph {
      "Nytril provides an informational comment that this file should not be editted. ";
      "That warning means that new variables and text strings should be added to this file. ";
      "Editing this file is proper and necessary for the review process. ";
    };
  };
}
//======================================================================
readonly TransReviewDocSection TransReviewDocSect = new;
class TransReviewDocSection: Content {
  Constructor() {
    super.Constructor("Review Translated Document");
  }

  override GetLayout(TechDesign design) = Block {
    design.Heading2 {
      Title;
    };

    design.Heading3 {
      "Opening Documents and Review Considerations";
    };

    design.SpacedParagraph {
      "It is now time to review the document in the translated language where it can be easily compared to the original language version. ";
      "First, check the "; design.SpanHighlight{"Document"} " menu, ensure that the original language is selected, then open the document if it is not already open. ";
      "Next, go back to the "; design.SpanHighlight{"Document"} " menu and select the translated language, then open the document again. ";
    };

    design.SpacedParagraph {
      "Two document tabs will now be open, one in the source language and one in the translated language. ";
      "Select the translated language version. ";
      "If the \"revu\" keyword is set, the translated language strings are purple in document, as they are in the language file. ";
    };

    design.SpacedParagraph {
      "There are two key considerations for translation review. ";
      "One is to ensure the language was translated correctly, that requires someone fluent in the language. ";
      "The other is to ensure that the space now required for the text did not cause a display issue in the document. ";
    };

    design.SpacedParagraph {
      "If both cannot be done at the same time, it is best to the translation accuracy check first, as changes to the translations may also change the layout. ";
    };

    design.Heading3 {
      "Making Changes and Navigating";
    };

    design.SpacedParagraph {
      "There are two critical navigating features that will help considerable through the review process. ";
      design.SpanHighlight{"Ctrl-Shift-D"}; " and "; design.SpanHighlight{"Ctrl-Click"}; ".";
    };

    design.SpacedParagraph {
      design.SpanHighlight{"Ctrl-Shift-D"}; " - is the \"Find in Document\" feature. ";
      "It is used to navigate from a code-side string to the location in the document. ";
      "Place the curson on the string, press Ctrl-Shift-D, then location will be highlighted in the document. ";
    };

    design.SpacedParagraph {
      design.SpanHighlight{"Ctrl-Click"}; " - is the \"Find in Code\" feature. ";
      "It is used to navigate from a document-side item to the location in the code where it is declared. ";
      "This is for any displayed item, not just strings. ";
    };

    design.SpacedParagraph {
      "This allows a reviewer to read and review the text string in the language file, but also see them in context by pressing Ctrl-Shift-D. ";
      "Once the language has been validated, the reviewer simply removed the revu keywork and the colors return to normal, identifying that string as complete. ";
    };

    design.SpacedParagraph {
      "If the language reviewer is external and unable to review the file in place, the file can be sent to the reviewer and the replaced by the revised version. ";
      "In that case, using the revu keyword is still a good idea as a developer will need to confirm that the new strings format correctly in the document layout. ";
    };
  };
}
