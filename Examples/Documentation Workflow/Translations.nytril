readonly TransSignInSections TransSignIn = new;
class TransSignInSections: Content {
  Constructor() {
    super.Constructor("Sign In");
  }

  override GetLayout(TechDesign design) = Block {
    design.Heading2 {
      Title;
    };

    design.SpacedParagraph {
      "To use the text translation feature, Nytril needs access to the Internel and a signed in Nytril Professional account. ";
      "A Nytril professional account is required to use this feature. ";
      "Visit the Nytril website to sign up for a professional account (";
      design.HyperlinkSpan {
        "Nytril.com";
        Action: new Action(Actions.ToLink, "https://www.nytril.com");
      };
      ").";
    };
  };
}
//======================================================================

readonly TransPerformTransSection TransPerformTransSect = new;
class TransPerformTransSection: Content {
  Constructor() {
    super.Constructor("Translate the Text");
  }

  override GetLayout(TechDesign design) = Block {
    design.Heading2 {
      Title;
    };

    design.SpacedParagraph {
      "Navigate to the primary language file. ";
      "This can easily be done by finding \"include Lang\" in the Main file and pressing F12 on Lang. ";
      "In the Lang file, Press F12 on the includes statement primary language name, i.e. English. ";
      "That will open the English Language file. ";
    };

    design.SpacedParagraph {
      "Inside the primary language file, right-click and select "; design.SpanHighlight{"Advanced"}; " from the context menu. ";
      "You will find the menu option for translating strings in the Advanced sub-context menu, as shown in "; design.FigureReference(TransMenuFig); ".";
    };

    design.SpacedParagraph {
      "After selecting the "; design.Emphasis{"Translate Language Strings"}; " option, in the dialog ("; design.FigureReference(TransMenuFig); ") select only the languages you wish to translate into. ";
      "If you wish to use the review feature, check the box to add the \"revu\" marker. ";
      "Click "; design.Emphasis{"Translate"}; ".";
    };

    design.SpacedParagraph {
      "Nytril will report the number of characters translated in the bottom toolbar of the app, and the dialog will disappear. ";
      "You are now ready to review the translations. ";
    };

    design.AddFigure(TransMenuFig, Here);
  };
}
