//======================================================================

readonly TransTextStrategySections TransTextStrategy = new;
class TransTextStrategySections: Content {
  Constructor() {
    super.Constructor("Text Strategy");
  }

  override GetLayout(TechDesign design) = Block {
    design.Heading2 {
      Title;
    };

    design.SpacedParagraph {
      "Knowing ahead of time that the goal is to translate text is beneficial, but not critical. ";
      "The key reason for this is that it is better to hold off on certain types of text normalization that may break sentences or construct sentences programatically. ";
      "A MadLibs type document is not great for translations. ";
      "Some text normalization or construction may be required, but do so with the knowledge that the text will need to be translated, where the meaning / tense / plurality / grammatical gender / usage must still work after the translation.";
    };

    design.SpacedParagraph {
      "Since translating text requires moving text into a single file, for which there are tools to aid in that process, it is a good practice to hold off on that abstration until the project is ready for translation. ";
      "It is simply easier to review text and build the document with the text in place. ";
    };

    TransTextToLangSect.GetLayout(design);
  };
}
//======================================================================

readonly TransTextToLangSection TransTextToLangSect = new;
class TransTextToLangSection: Content {
  Constructor() {
    super.Constructor("Moving Text To Language File");
  }

  override GetLayout(TechDesign design) = Block {
    design.Heading3 {
      Title;
    };

    design.SpacedParagraph {
      "When ready, text can be moved into the active language file. ";
      "To confirm the active language file, open the "; design.SpanHighlight{"Documents"}; " menu and locate the selected configuration. ";
      "The language of that configuration will be the active language file. ";
    };

    design.SpacedParagraph {
      "Navigate to the top of a document with text content. ";
      "Place the cursor anywhere on that first string. ";
      "Select "; design.Emphasis{"Ctrl-Shift-L"}; ". ";
      "A dialog, as shown in figure "; design.FigureReference(TransTextToLangFig); ", will appear. ";
    };

    design.SpacedParagraph {
      "The dialog will automatically create a unique varible name for the text. ";
      "Nytril will have looked for an exact match or a close match to other strings in the language file. ";
      "The purpose of that is to avoid entering duplicate text and to find text that is similarly stated where it may be best to state it in one way. ";
    };

    design.SpacedParagraph {
      "Finally, the dialog allows you to search for exising symbols given the chance that you want to use an existing string rather than the one being generated. ";
    };

    design.SpacedParagraph {
      "The common choice is to just select the provided variable name and select "; design.Emphasis{"Add Symbol"}; ".";
    };

    design.SpacedParagraph {
      "Nytril will move the string to the language file inserting it in alphabetical order by the variable name, and automatically replace the text in code with the variable name. ";
      "The dialog remains open while Nytril finds the next string in the file, creates a variable name and displays it for review. ";
      "Continue to review each variable name, selecting "; design.Emphasis{"Add Symbol"}; " until there are no more strings to add. ";
      "See these figures to review the progression: "; design.FigureReference(TransCodeBeforeFig); CommaSpace; design.FigureReference(TransLangResultsFig); CommaSpace; design.FigureReference(TransCodeResultsFig); ".";
    };

    design.SpacedParagraph {
      "If a string is skipped, the dialog will move on to the next string. ";
    };

    design.AddFigure(TransTextToLangFig, Here);
    design.AddFigure(TransCodeBeforeFig, Here);
    design.AddFigure(TransLangResultsFig, Here);
    design.AddFigure(TransCodeResultsFig, Here);
  };
}
