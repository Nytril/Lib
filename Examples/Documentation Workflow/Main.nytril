//=============================================================================
readonly UserOptions UserOps = new;
class UserOptions: Fact {
  field int  DesignSlideIndex,
             PaletteSlideIndex;

  Constructor {
    super.Constructor(#52b2bf9c-b7d6-46fa-8f5e-b2c1daaf4811#);
    DesignSlideIndex  = PublishDesignDefault;
    PaletteSlideIndex = PublishPaletteDefault;
    if (!System.IsPublishing)
      ReadFromStorage;
  }
}

//=============================================================================

class StyledDocument: DocumentEntry {
  var TechDesign       Design;
  var AuthoredContent  Content;

  Constructor(Guid id, string name, AuthoredContent content) {
    super.Constructor(id, name);

    Content            = content;
    Title              = content.Title;
    Design             = GetDesign(UserOps.DesignSlideIndex, AllDesigns);
    Design.Palette     = GetPalette(UserOps.PaletteSlideIndex, AllPalettes);
    ContentType        = ContentTypes.Article;
  }

  override GetDocument = Design.GetStyledDocument(Content);

  TechDesign GetDesign(int index, Array designs) {
    if (index > designs.Length)
      return designs[designs.Length - 1];
    return designs[index];
  }

  DesignPalette GetPalette(int index, DesignPalette[] palettes) {
    if (index > palettes.Length)
      return palettes[palettes.Length - 1];
    return palettes[index];
  }
}

