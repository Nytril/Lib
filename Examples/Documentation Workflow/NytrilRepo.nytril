using Format, HelpConcepts;

class RepoAndSourceControl: AuthoredContent {
  Constructor {
    super.Constructor("Nytril Repository");

    Watermark = "DRAFT";

    AddAuthor(People.ColbertAuthor);
    AddAuthor(People.McCreightAuthor);

    AddContent(RepoAndSourcePurpose);
    AddContent(RepoAndSourceAbout);
    AddContent(RepoAndSourceOpen);
    AddContent(RepoAndSourceCreate);
    AddContent(RepoAndSourceSelected);
    AddContent(RepoResources);
  }
}
//=========================================================================

readonly RepoAndSourcePurposeSection RepoAndSourcePurpose = new;
class RepoAndSourcePurposeSection: Content {
  Constructor() {
    super.Constructor("Purpose");
  }

  override GetLayout(TechDesign design) = Block {
    design.Heading3 {
      Title;
    };

    design.NormalParagraph {
      "This document explains Nytril repositories, their shared resources, and how to create or open a repository.";
    };
  };
}
//=========================================================================

readonly RepoAndSourceAboutSection RepoAndSourceAbout = new;
class RepoAndSourceAboutSection: Content {
  Constructor() {
    super.Constructor("Nytril Repository");
  }

  override GetLayout(TechDesign design) = Block {
    design.Heading3 {
      Title;
    };

    design.SpacedParagraph {
        "A repository in Nytril is a required structural component for all documents. ";
        "Nytril maintains a default repository for projects created without selecting or creating another repository. ";
        "The current repository appears under "; design.Emphasis{"Repo"}; " in the main menu bar. ";
        "Nytril creates new projects in the selected repository.";
      };

    design.SpacedParagraph {
      "A repository corresponds to a folder on the hard drive. ";
      "This folder contains project files and shared resources. ";
      "By default, language files, if used, reside in the repository root, where they can be shared across projects. ";
      "This avoids duplicating common text.";
    };

    design.SpacedParagraph {
      "A repository stores one or more Nytril projects and their shared resources. ";
      "Projects can also use resources located outside the repository. ";
      "Depending on how source control is configured, those external resources may not be tracked.";
    };

    design.SpacedParagraph {
      "A source control system, such as Git, normally targets the repository root. ";
    };
  };
}
//=========================================================================

readonly RepoAndSourceOpenSection RepoAndSourceOpen = new;
class RepoAndSourceOpenSection: Content {
  Constructor() {
    super.Constructor("Opening an Existing Repository");
  }

  override GetLayout(TechDesign design) = Block {
    design.Heading3 {
      Title;
    };

    design.SpacedParagraph {
      "If a Nytril project has been obtained from Git or another user, use the open repository feature to open the folder containing the project. ";
      "This is the recommended way to connect an existing repository and its project to Nytril. ";
      "Nytril selects the repository and loads the project.";
    };
  };
}
//=========================================================================

readonly RepoAndSourceCreateSection RepoAndSourceCreate = new;
class RepoAndSourceCreateSection: Content {
  Constructor() {
    super.Constructor("Creating a Repository");
  }

  override GetLayout(TechDesign design) = Block {
    design.Heading3 {
      Title;
    };

    design.SpacedParagraph {
      "Consider whether the project requires a new repository or benefits from an existing repository with established configurations such as language, units, or paper size. ";
      "Existing repositories may already include source control and shared resources, making them a better starting point.";
    };

    design.SpacedParagraph {
      "In the New Repo dialog, enter the Repository Name and specify the Local folder. ";
      "A repository cannot be created without a project. The First Project list determines whether Nytril creates a new project or opens an existing project.";
    };

    design.AddFigure(RepoLangFig, Here, ExtentWidth, null, false);
    design.FigureCaption(RepoLangFig);

    design.SpacedParagraph {
      "Repository creation can initialize ";
      design.InLineLink { ConfigsConcept };
      ", allowing Nytril to scaffold the configuration system. ";
      "A single language configuration enables advanced language features that otherwise remain unavailable. ";
      "Repository setup supports skipping language options and adding them later.";
    };

    design.SpacedParagraph {
      "When languages are selected during repository creation, Nytril creates any selected language files that do not already exist. ";
      "Existing individual language files, such as English.nytril, are never overwritten by this operation.  ";

    };

    design.SpacedParagraph {
      "If Lang.nytril already exists, Nytril prompts whether to overwrite it. ";
      "Overwriting replaces its previous contents with the current language selections. ";
      "If it is not overwritten, Lang.nytril remains unchanged; any new language files are still created but are not added to it. ";
    };

    design.SpacedParagraph {
      "Choose one of the First Project options shown in "; design.FigureReference(RepoFirstProjectFig); DotSpace;
    };

    design.AddFigure(RepoFirstProjectFig, Here, ExtentWidth, null, false);
    design.FigureCaption(RepoFirstProjectFig);

    design.Heading3 {
      "Create a New Project";
    };

    design.SpacedParagraph {
      "Select Create a New Project to create the repository with a new initial project. ";
      "Select OK, then enter a project name in the new project dialog. ";
      "The project path defaults to the repository. ";
      "Nytril creates the repository and the project within it, then generates any required configuration files in the repository root. ";
      "Nytril adds the include statements needed to reference any generated configuration files.";
    };

    design.Heading3 {
      "Open an Existing Project";
    };

    design.SpacedParagraph {
      "To use an existing project, set Local folder to the folder containing that project and select Open an Existing Project under First Project. ";
      "Select OK, then select the existing project to open. ";
      "This connects the repository and project to Nytril in the same way as opening an existing repository. ";
      "For a project obtained from Git or another user, opening the repository directly is the recommended approach; this option provides an alternative through the New Repo dialog.";
    };
  };
}
//=========================================================================

readonly RepoAndSourceSelectedSection RepoAndSourceSelected = new;
class RepoAndSourceSelectedSection: Content {
  Constructor() {
    super.Constructor("After Creating or Opening a Repository");
  }

  override GetLayout(TechDesign design) = Block {
    design.Heading3 {
      Title;
    };

    design.SpacedParagraph {
      "Whether the repository is created or opened, Nytril selects it and loads the project. ";
      "The repository appears in the Repo menu. When that repository is selected, its project appears in the Project menu.";
    };
  };
}
