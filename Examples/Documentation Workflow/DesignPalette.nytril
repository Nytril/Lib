using Format;

include "DesignPaletteSamples";

DesignPalette[] AllPalettes {
  var a = DesignPalettes.ToArray;
  return a;
}

class DesignPalette {
  readonly var string Name;
           var Color  Dark1;
           var Color  Light1;
           var Color  Dark2;
           var Color  Light2;
           var Color  Accent1;
           var Color  Accent2;
           var Color  Accent3;
           var Color  Accent4;
           var Color  Accent5;
           var Color  Accent6;
           var Color  Hyperlink          = #0563C1#;
           var Color  FollowedHyperlink  = #954F72#;

  Constructor(name) {
    Name = name;
  }

  override GetLayoutTip = Block {
    SamplesVBox;
  };

  private ColorSampleBox(string name, Color color) = VBox {
    HAlign: Left;
    Margin: PadR(20);
    name;
    Shape(color, 0.5) {
      PolygonPath(new(0, 20), 4, -45 degrees);
    };
  };

  virtual SamplesVBox = VBox {
    TextCase:FirstUpper;
    TextHeight: 9;
    GetColorSampleBoxes;
  };

  virtual SamplesHBox = HBox(ExtentWidth) {
    TextCase:FirstUpper;
    TextHeight: 9;
    VAlign: Center;
    GetColorSampleBoxes;
  };

  private GetColorSampleBoxes = {
    ColorSampleBox(nameof(Dark1),   Dark1  );
    ColorSampleBox(nameof(Light1),  Light1 );
    ColorSampleBox(nameof(Dark2),   Dark2  );
    ColorSampleBox(nameof(Light2),  Light2 );
    ColorSampleBox(nameof(Accent1), Accent1);
    ColorSampleBox(nameof(Accent2), Accent2);
    ColorSampleBox(nameof(Accent3), Accent3);
    ColorSampleBox(nameof(Accent4), Accent4);
    ColorSampleBox(nameof(Accent5), Accent5);
    ColorSampleBox(nameof(Accent6), Accent6);
    ColorSampleBox(nameof(Hyperlink), Hyperlink);
    ColorSampleBox(nameof(FollowedHyperlink), FollowedHyperlink);
  };

  static Color Lighten(Color c, double percent) {
    var lightness = c.L + (1.0 - c.L) * (percent / 100.0);
    if (lightness > 1.0)
      lightness = 1.0;

    return Color.FromHSLA(c.H, c.S, lightness);
  }

  static Color Darken(Color c, double percent) {
    var lightness = c.L * (1.0 - (percent / 100.0));
    if (lightness < 0.0)
      lightness = 0.0;

    return Color.FromHSLA(c.H, c.S, lightness);
  }
}

