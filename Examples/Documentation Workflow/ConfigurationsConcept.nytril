using Format, HelpConcepts;

class ConfigurationsConcept: AuthoredContent {
  Constructor {
    super.Constructor("Understanding Project Configurations Settings");

    Watermark = "DRAFT";

    AddAuthor(People.ColbertAuthor);
    AddAuthor(People.McCreightAuthor);

    AddContent(ConfigurationPurpose);
    AddContent(ConfigurationAbout);
    AddContent(ConfigurationTranslations);
    AddContent(ConfigurationOptions);
    AddContent(ConfigurationFromRepo);
    AddContent(ConfigurationCreate);
    AddContent(ConfigurationManual);
    AddContent(ConfigurationSwitching);
    AddContent(ConfigurationApiRef);
    AddContent(ConfigResources);
  }
}

// ============================================================================

readonly  ConfigurationPurposeSection  ConfigurationPurpose = new;
class  ConfigurationPurposeSection: Content {
  Constructor() {
    super.Constructor(null);
  }

  override GetLayout(TechDesign design) = Block {
    design.Heading3 {
      "Purpose";
    };

    design.NormalParagraph {
      "This document discusses Nytril configurations including the purpose, initial setup, application, and use.";
    };
  };
}

// ============================================================================

readonly  ConfigurationAboutSection  ConfigurationAbout = new;
class  ConfigurationAboutSection: Content {
  Constructor() {
    super.Constructor(null);
  }

  override GetLayout(TechDesign design) = Block {
    design.Heading3 {
      "Nytril Configurations";
    };

    design.SpacedParagraph {
      "Configurations create various versions of the same document using different properties such as style, language, paper size, and measurement units. ";
      "The configuration metrics apply to all documents universally. ";
      "Configurations work directly with Nytril-IDE-document viewers and the publishing feature. ";
      "In either case, source code will produce one or more documents given the metrics in the configurations. ";
      "Projects published to the Nytril hosting site will produce the document in all its proposed forms allowing the web server to return the appropriate variation of the document depending on the users' personal preference. ";
    };
  };
}

// ============================================================================

readonly  ConfigurationTranslationsSection  ConfigurationTranslations = new;
class  ConfigurationTranslationsSection: Content {
  Constructor() {
    super.Constructor(null);
  }

  override GetLayout(TechDesign design) = Block {
    design.Heading3 {
      "Translations";
    };

    design.SpacedParagraph {
      "Configurations drive language translation and access to built-in language features. ";
      "At least one configuration activates Nytril’s built-in language tools. ";
      "During translation, Nytril writes translated text to the target language file specified in the configuration. ";
      "Each language configuration requires a corresponding language file.";
    };
  };
}

// ============================================================================

readonly  ConfigurationOptionsSection  ConfigurationOptions = new;
class  ConfigurationOptionsSection: Content {
  Constructor() {
    super.Constructor(null);
  }

  override GetLayout(TechDesign design) = Block {
    design.Heading3 {
      "Options";
    };

    design.AddFigure(OneConfigFig, Here);
    var oneConfigRef = design.FigureReference(OneConfigFig);

    design.SpacedParagraph {
      oneConfigRef " depicts a project with one configuration. ";
      "The settings in " oneConfigRef " will cause Nytril to produce each document once using the configuration options: English language, US paper size, and Imperial units. ";
      "Note that for the language, the configuration must specify the language (ex. \"Languages.English\"), but there must also be an included language file (\"include \"English\"\") to serve the language variables. ";
      "Additional configurations produce additional document variations; one config = one version, two configs = two versions, and so forth. ";
    };

    design.AddFigure(TwoConfigsFig, Here);
    var twoConfigsRef = design.FigureReference(TwoConfigsFig);

    design.SpacedParagraph {
      "The implementation in " twoConfigsRef " will produce two versions of each document. ";
      "Both in English and US paper size, but one with Imperial Units and one with Metric. ";
    };

    design.SpacedParagraph {
      "The "; design.Emphasis{"Lang"}; " file contains the configuration data. ";
      "The project Main file normally includes the Lang file, such as "; design.SpanHighlight { "\"include \"Lang\"\". " };
      "If the project does not include a Lang file, then Nytril produces documents using its default configuration. ";
      "Please review the remaining sections of this document for information on setting up the configuration environment. ";
    };
  };
}
// ============================================================================

readonly  OneConfigFigure  OneConfigFig = new;
class  OneConfigFigure: Content {
  Constructor() {
    super.Constructor("Basic Single Configuration");
  }

  override GetLayout(TechDesign design)  = design.CodeParagraph {
    SourceSelectionLines(res "Lang.nytril", 1, 7);
  };

  override GetCaption(TechDesign design) = Span { "Basic Single Configuration" };
}

