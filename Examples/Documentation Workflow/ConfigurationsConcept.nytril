using Format, HelpConcepts;

class ConfigurationsConcept: AuthoredContent {
  Constructor {
    super.Constructor("Understanding Project Configuration Settings");

    Watermark = "DRAFT";

    AddAuthor(People.ColbertAuthor);
    AddAuthor(People.McCreightAuthor);

    AddContent(ConfigurationPurpose);
    AddContent(ConfigurationUnderstanding);
    AddContent(ConfigurationFromRepo);
    AddContent(ConfigurationCreate);
    AddContent(ConfigurationSwitching);
    AddContent(ConfigurationApiRef);
    AddContent(ConfigResources);
  }
}
// ============================================================================

readonly ConfigurationPurposeSection ConfigurationPurpose = new;
class ConfigurationPurposeSection: Content {
  Constructor() {
    super.Constructor("Purpose");
  }

  override GetLayout(TechDesign design) = Block {
    design.Heading3 {
      Title;
    };

    design.NormalParagraph {
      "This document discusses Nytril configurations including the purpose, initial setup, application, and use.";
    };
  };
}
// ============================================================================

readonly ConfigurationUnderstandingSection ConfigurationUnderstanding = new;
class ConfigurationUnderstandingSection: Content {
  Constructor() {
    super.Constructor("Understanding Configurations");
  }

  override GetLayout(TechDesign design) = Block {
    design.Heading1 {
      Title;
    };

    ConfigurationAbout.GetLayout(design);
    ConfigurationTranslations.GetLayout(design);
    ConfigurationOptions.GetLayout(design);
  };
}
// ============================================================================


readonly ConfigurationAboutSection ConfigurationAbout = new;
class ConfigurationAboutSection: Content {
  Constructor() {
    super.Constructor("Nytril Configurations");
  }

  override GetLayout(TechDesign design) = Block {
    design.Heading2 {
      Title;
    };

    design.SpacedParagraph {
      "Configurations create various versions of the same document using different properties such as style, language, paper size, and measurement units. ";
      "The configuration metrics apply to all documents in the project. ";
      "Configurations apply to document viewing in the Nytril IDE and to publishing. ";
      "In either case, source code will produce one or more documents given the metrics in the configurations. ";
      "Projects published to the Nytril hosting site produce each document in all configured variations, allowing the web server to return the appropriate variation based on each user’s preferences. ";
    };
  };
}
// ============================================================================

readonly  ConfigurationTranslationsSection  ConfigurationTranslations = new;
class  ConfigurationTranslationsSection: Content {
  Constructor() {
    super.Constructor("Translations");
  }

  override GetLayout(TechDesign design) = Block {
    design.Heading3 {
      Title;
    };

    design.SpacedParagraph {
      "Configurations drive language translation and access to built-in language features. ";
      "Defining at least one configuration activates Nytril’s built-in language tools. ";
      "During translation, Nytril writes translated text to the target language file specified in the configuration. ";
      "Each language configuration requires a corresponding language file.";
    };
  };
}
// ============================================================================

readonly  ConfigurationOptionsSection  ConfigurationOptions = new;
class  ConfigurationOptionsSection: Content {
  Constructor() {
    super.Constructor("Options");
  }

  override GetLayout(TechDesign design) = Block {
    design.Heading3 {
      Title;
    };

    design.AddFigure(OneConfigFig, Here);
    var oneConfigRef = design.FigureReference(OneConfigFig);

    design.SpacedParagraph {
      oneConfigRef " depicts a project with one configuration. ";
      "The settings in " oneConfigRef " will cause Nytril to produce each document once using the configuration options: English language, US paper size, and Imperial units. ";
      "The configuration must specify the language, such as Languages.English, and the Lang file must include the corresponding language file, such as \"include \"English\".\" ";
      "The language file holds variables for translation or use throughout the project. ";
      "Additional configurations produce additional document variations; one config = one version, two configs = two versions, and so forth. ";
    };

    design.AddFigure(TwoConfigsFig, Here);
    var twoConfigsRef = design.FigureReference(TwoConfigsFig);

    design.SpacedParagraph {
      "The implementation in " twoConfigsRef " produces two versions of each document. ";
      "Both use English and US paper sizes; one uses imperial units, and the other uses metric units. ";
    };

    design.SpacedParagraph {
      "The "; design.Emphasis{"Lang"}; " file contains the configuration data. ";
      "The project Main file normally includes the Lang file, such as "; design.SpanHighlight { "\"include \"Lang\"\". " };
      "If the project does not include a Lang file, then Nytril produces documents using its default configuration. ";
      "Please review the remaining sections of this document for information on setting up the configuration environment. ";
    };
  };
}
// ============================================================================
// Existing Configuration
// ============================================================================

readonly ConfigurationFromRepoSection ConfigurationFromRepo = new;
class  ConfigurationFromRepoSection: Content {
  Constructor() {
    super.Constructor("Using Configuration from an Existing Repository");
  }

  override GetLayout(TechDesign design) = Block {
    design.Heading4 {
      Title;
    };

    Table(null, null, [new Column(62%), new Column(20), Column.Expand] ) {
      Row {
        Cell {
          design.SpacedParagraph {
            "Creating a project within an existing repository will not automatically apply the configurations to the new project. ";
            "To add the configuration settings, add ";
            design.SpanHighlight { "\"include \"Lang\";\" " };
            "to the main file of the new project. ";
            "This will cause the IDE to build documents using the configuration options and will activate the advanced language features. ";
          };
        };
        Cell;
        Cell {
          design.AddFigure(MainIncludesFig, Here);
        };
      };
    };

    design.SpacedParagraph {
      "This described process assumes the Lang file is at the root of the repository. ";
      "If it is in another location, add the relative path to the include statement. ";
    };
  };
}
