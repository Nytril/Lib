readonly  TwoConfigsFigure  TwoConfigsFig = new;
class  TwoConfigsFigure: Content {
  Constructor() {
    super.Constructor("Dual Units Configuration");
  }

  override GetLayout(TechDesign design)  = design.CodeParagraph {
    SourceSelectionLines(res "Lang.nytril");
  };

  override GetCaption(TechDesign design) = Title;
}

// ============================================================================

readonly  ConfigurationFromRepoSection  ConfigurationFromRepo = new;
class  ConfigurationFromRepoSection: Content {
  Constructor() {
    super.Constructor(null);
  }

  override GetLayout(TechDesign design) = Block {
    design.Heading3 {
      "Using Configuration from an Existing Repository";
    };

    Table(null, null, [new Column(62%), new Column(20), Column.Expand] ) {
      Row {
        Cell {
          design.SpacedParagraph {
            "Creating a project within an existing repository will not automatically apply the configurations to the new project. ";
            "To add the configuration settings, add ";
            design.SpanHighlight { "\"include \"Lang\";\" " };
            "to the main file of the new project. ";
            "This will cause the IDE to build documents using the configuration options and will activate the advance language features. ";
          };
        };
        Cell;
        Cell {
          design.AddFigure(MainIncludesFig, Here);
        };
      };
    };

    design.SpacedParagraph {
      "This described process assumes the Lang file is at the root of the repository. ";
      "If it is in another location, add the relative path to the include statement. ";
    };
  };
}

// ============================================================================

readonly MainIncludesFigure  MainIncludesFig = new;
class  MainIncludesFigure: Content {
  Constructor() {
    super.Constructor("Including \"Lang\" in Main");
  }

  override GetCaption(TechDesign design) = Title;

  override GetLayout(TechDesign design) = design.CodeParagraph {
    SourceSelectionLines(res "Main.nytril", 1, 8);
  };
}

// ============================================================================

readonly  ConfigurationCreateSection  ConfigurationCreate = new;
class  ConfigurationCreateSection: Content {
  Constructor() {
    super.Constructor(null);
  }

  override GetLayout(TechDesign design) = Block {
    design.Heading3 {
      "Adding Configurations when Creating a Repository";
    };

    design.SpacedParagraph {
      "For details in setting up a repository, see the ";
      design.InLineLink {
        Repositories
      };
      " help.";
    };

    design.SpacedParagraph {
      "Nytril can automatically scaffold the configuration system during repository creation. ";
      "Even if only using one language, it is still advantageous to establish the repository with a single language as that will activate Nytril's advanced language features. ";
    };

    var mainIncludesRef = design.FigureReference(MainIncludesFig);
    var twoConfigsRef   = design.FigureReference(TwoConfigsFig);
    design.SpacedParagraph {
      "After creating the repository, Nytril will add the Lang file to the initial project's main file, as shown in " mainIncludesRef ". ";
      "The Lang file will, as shown in " twoConfigsRef ", contain the \"include\" statements for each selected language. ";
      "Additional configuration options, such as paper size or units, can now be set by altering the existing configurations or adding new ones. ";
    };
  };
}

// ============================================================================

readonly  ConfigurationManualSection  ConfigurationManual = new;
class  ConfigurationManualSection: Content {
  Constructor() {
    super.Constructor(null);
  }

  override GetLayout(TechDesign design) = Block {
    design.Heading3 {
      "Manual Configuration Setup";
    };

    design.SpacedParagraph {
      "Nytril supports creating or modifying configuration systems as needed. ";
    };

    design.SpacedParagraph {
      "Create an empty text file named Lang.nytril in the repository root. ";
      "Do this using OS tools or within Nytril by selecting "; design.SpanHighlight { "File..New..File" }; ", then saving the file with the noted name. ";
    };

    design.SpacedParagraph {
      "Create an empty text file in the same location for each intended language. ";
      "Each filename must match a language listed in the Languages enumeration. ";
      "The Languages Enum is located at "; design.SpanHighlight { "Help => Runtime Library => Enum => Languages" }; ".";
    };

    var mainIncludesRef = design.FigureReference(MainIncludesFig);
    var twoConfigsRef   = design.FigureReference(TwoConfigsFig);
    design.SpacedParagraph {
      "Include the Lang file in the project Main as shown in " mainIncludesRef ". ";
    };

    design.SpacedParagraph {
      "Add the configurations and language-file \"includes\" to the Lang file as shown in " twoConfigsRef ". ";
    };

    design.SpacedParagraph {
      "Finally, building the solution activates the language features. ";
    };
  };
}

// ============================================================================

readonly  ConfigurationSwitchingContent  ConfigurationSwitching = new;
class  ConfigurationSwitchingContent: Content {
  Constructor() {
    super.Constructor(null);
  }

  override GetLayout(TechDesign design) = Block {
    design.Heading3 {
      "Viewing Documents in Various Configurations";
    };

    design.SpacedParagraph {
      "The Documents menu switches the configuration at runtime and appears only when multiple configurations exist. ";
    };

    design.SpacedParagraph {
      "With more than one configuration in the Lang file, open the Documents menu and note the configuration names at the top of the menu. ";
      "Select a configuration. ";
    };

    design.SpacedParagraph {
      "Open documents reload using the selected configuration. ";
    };

    design.SpacedParagraph {
      "Newly opened documents use the selected configuration. ";
    };
  };
}

