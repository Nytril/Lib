using Format;

include "DbConfig";

class DataSourceConcept: AuthoredContent {
  Constructor {
    super.Constructor("Connecting Data Sources");

    Watermark = "DRAFT";

    AddAuthor(People.ColbertAuthor);
    AddAuthor(People.McCreightAuthor);

    AddContent(DataSourcePurpose);
    AddContent(DataSourceConnecting);
    AddContent(DataSourceQuery);
  }
}
// ============================================================================

readonly  DataSourcePurposeSection  DataSourcePurpose = new;
class  DataSourcePurposeSection: Content {
  Constructor() {
    super.Constructor("Purpose");
  }

  override GetLayout(TechDesign design) = Block {
    design.Heading2 {
      Title;
    };

    design.SpacedParagraph {
      "This document describes the process of connecting data sources to the Nytril IDE for use in a project. ";
      "Nytril can be connected to external data sources such as databases and can make external calls, such as calling an API method. ";
      "Nytril also has the ability to receive output from externally written code, such as a C# program. ";
      "This document describes the basic process of using these features. ";
    };
  };
}
// ============================================================================
// Connecting Data Sources
// ============================================================================

readonly  DataSourceConnectingSection  DataSourceConnecting = new;
class  DataSourceConnectingSection: Content {
  Constructor() {
    super.Constructor("Connecting Data Sources Feature");
  }

  override GetLayout(TechDesign design) = Block {
    design.Heading4 {
      Title;
    };

    DataSourceTypes.GetLayout(design);
    DataSourceConnect.GetLayout(design);
  };
}
// ============================================================================

readonly  DataSourceTypesSection  DataSourceTypes = new;
class  DataSourceTypesSection: Content {
  Constructor() {
    super.Constructor("Database types");
  }

  override GetLayout(TechDesign design) = Block {
    design.Heading2 {
      Title;
    };

    design.TightParagraph {
      "The DB namespace provides the following database types: ";
    };

    ListBlock {
      List<string> supportedDatabases = new(12);
      foreach (Attribute att in attribute(DB).Children) {
        if (att.AttributeType == AttributeTypes.Class &&
            att.Name != "DbConnection"                &&
            att.Name != "DbField"                     &&
            att.Name != "DbFieldValue"                &&
            att.Name != "DbRow")
          supportedDatabases.Add(att.Name);
      }

      supportedDatabases.Sort;
      each supportedDatabases;
    };

    design.TightParagraph {
      "Instantiate the appropriate database type using a file path or connection string, depending on the type. ";
    };
  };
}
// ============================================================================

readonly  DataSourceConnectSection  DataSourceConnect = new;
class  DataSourceConnectSection: Content {
  Constructor() {
    super.Constructor("Establishing a connection");
  }

  override GetLayout(TechDesign design) = Block {
    design.Heading2 {
      SpaceBefore: 20px;
      Title;
    };

    design.SpacedParagraph {
      "Connecting to a database source is simple. ";
      "Use the built-in DB namespace to access database connection methods. ";
      "All connection methods, assuming correct connection strings and credentials, return a DbConnection.";
    };

    design.AddFigure(DbConnFig, Here);

    DataSourceCreds.GetLayout(design);
  };
}
// ============================================================================

readonly  DataSourceCredsSection  DataSourceCreds = new;
class  DataSourceCredsSection: Content {
  Constructor() {
    super.Constructor("Securing credentials");
  }

  override GetLayout(TechDesign design) = Block {
    design.Heading3 {
      Title;
    };

    design.SpacedParagraph {
      "Each database connection method includes an optional parameter for credentials. ";
      "The parameter can be omitted as credentials may be supplied in the connection string. ";
      "If credentials are embedded in a connection string stored in source code, anyone with access to that code can read them, and they may be committed to source control. ";
    };

    design.SpacedParagraph {
      "To ameliorate that concern, Nytril includes a \"User Credentials\" feature that stores credentials securely. ";
      "The credential set is named and thereafter is referenced by that name. ";
      "The named credentials will not be included in source control and are not visible to other developers. ";
      "This is the recommended method for connecting to databases, APIs, or other external systems that require credentials. ";
    };
  };
}
// ============================================================================
// Query Data Source
// ============================================================================

readonly DataSourceQuerySection DataSourceQuery = new;
class DataSourceQuerySection: Content {
  Constructor() {
    super.Constructor("Querying the Connection");
  }

  override GetLayout(TechDesign design) = Block {
    design.Heading4 {
      Title;
    };

    design.SpacedParagraph {
      "Once a DbConnection has been established, the database can be queried using the RunQuery method. ";
      "The only parameter for the method is the query command.  ";
      "Pass the query command to RunQuery. ";
      "The method returns an array of DbRows containing the query results.";
    };

    design.AddFigure(DbQueryFig, Here);
  };
}
// ============================================================================
