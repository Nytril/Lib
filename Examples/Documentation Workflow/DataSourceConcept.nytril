readonly DataSourceExcelSection DataSourceExcel = new;
class DataSourceExcelSection: Content {
  Constructor() {
    super.Constructor("Connecting to an Excel File");
  }

  override GetLayout(TechDesign design) = Block {
    design.Heading4 {
      Title;
    };

    design.SpacedParagraph {
      "Use DB.ExcelDb to read an Excel workbook through the same DB library used for database connections. The example references Address List.xlsx as a project resource and queries the Sheet1 worksheet.";
    };

    design.AddFigure(DataSourceExcelFig, Here);

    design.SpacedParagraph {
      "The query uses [Sheet1$] as the worksheet name. RunQuery returns DbRows, and the example reads the Name field from each row. Replace the workbook, worksheet, and field names with those used by your data.";
    };
  };
}
// ============================================================================

readonly DataSourceApiSection DataSourceApi = new;
class DataSourceApiSection: Content {
  Constructor() {
    super.Constructor("Calling an API and Retrieving External Resources");
  }

  override GetLayout(TechDesign design) = Block {
    design.Heading4 {
      Title;
    };

    design.SpacedParagraph {
      "The Net namespace provides HttpGet, HttpPost, HttpPut, and HttpDelete request classes. HttpRequest is the base request class, and HttpResponse represents a response. This example uses HttpGet to request JSON data from a news API.";
    };

    design.SpacedParagraph {
      "For this example, store the API token as the password in a User Credentials entry named Finnhub. AddCredential uses that named credential for the X-Finnhub-Token request header. The credential name and header depend on the service being called.";
    };

    design.AddFigure(DataSourceApiFig, Here);

    design.SpacedParagraph {
      "QueryParameter adds the category parameter, and CacheTimeSpan sets a five-minute cache duration. Send sends the request. After checking that a response is available and IsSuccessStatusCode is true, the example reads ContentJSON and uses each story headline in a paragraph.";
    };

    design.SpacedParagraph {
      "An HTTP request can also retrieve an external resource such as an image. In the following example, imageUrl is the URL of the image to retrieve. ContentBlob supplies the response data to Image.";
    };

    design.AddFigure(DataSourceImageFig, Here);
  };
}
// ============================================================================

readonly DataSourceLibrarySection DataSourceLibrary = new;
class DataSourceLibrarySection: Content {
  Constructor() {
    super.Constructor("Using a C# Library");
  }

  override GetLayout(TechDesign design) = Block {
    design.Heading4 {
      Title;
    };

    design.SpacedParagraph {
      "Developers can use a custom C# library for processing and bring the results into Nytril document content. The importlib declaration identifies the compiled library and gives it a name used to access its classes and methods.";
    };

    design.AddFigure(DataSourceLibraryFig, Here);

    design.SpacedParagraph {
      "In this example, Extra is the imported library name. The call to Extra.UtilityClass.GetPrimeNumbers returns values that Nytril displays in a paragraph. Replace the library path, class, and method with those of your compiled library. The library must be available at the specified path.";
    };
  };
}
