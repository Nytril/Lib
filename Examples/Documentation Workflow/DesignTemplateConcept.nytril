using Format, HelpConcepts;

//==================================================================================
// Samples - Used to show code, so if moved check the document.
//==================================================================================

readonly SampleFigure  SampleFig = new;

class  SampleFigure: Content {
  Constructor() {
    super.Constructor("Sample figure.");
  }

  override GetCaption(TechDesign design) = Title;

  override GetLayout(TechDesign design) = HBox { "Sample figure contents" };
}

NotImplemented(TechDesign design) = {

  design.AddFigure(SampleFig, Here);          //Adds to other figure numbering
  design.AddFigure(SampleFig, Here | Table);  //Adds to table figure numbering

  "Refer to "; design.FigureReference(SampleFig); " for more information.";
};

SampleQuickRef(TechDesign design) = {
  design.Heading3 {
    "Quick Reference";
  };

  design.QuickRefTable {
    design.QuickRefHeaderRow {
      "PHASE I";
      "PHASE II";
      "PHASE III";
    };
    Row {
      design.QuickRefCell {
        design.QuickRefItem("Title1", "UniqueAnchor1");
      };
      design.QuickRefCell {
        design.QuickRefItem("Title2", "UniqueAnchor2");
      };
      design.QuickRefCell {
        design.QuickRefItem("Title3", "UniqueAnchor3");
      };
    };
  };
};
//==================================================================================
// End Sample Code
//==================================================================================
class DesignTemplateConcept: AuthoredContent {
  Constructor {
    super.Constructor("Style Design Concepts");

    Watermark = "DRAFT";

    AddAuthor(People.ColbertAuthor);
    AddAuthor(People.McCreightAuthor);

    AddContent(DesignTemplatePurpose);
    AddContent(DesignTemplateAbout);
    AddContent(DesignTemplateImplementation);
    AddContent(DesignTemplateFeatures);
  }
}
//==================================================================================

readonly DesignTemplatePurposeSection DesignTemplatePurpose = new;
class DesignTemplatePurposeSection: Content {
  Constructor {
    super.Constructor("Purpose");
  }

  override GetLayout(TechDesign design) = Block {
    design.Heading3 {
      Title;
    };

    design.SpacedParagraph {
      "Implementing styling templates is a fundamental part of maintaining an effective recurring documentation system. ";
      "This document describes how styling templates work, how to use a sample Styling template, and how to create your own.";
    };
  };
}
//==================================================================================

readonly DesignTemplateAboutSection DesignTemplateAbout = new;
class DesignTemplateAboutSection: Content {
  Constructor {
    super.Constructor("How Styling Templates Work");
  }

  override GetLayout(TechDesign design) = Block {
    design.Heading4 {
      Title;
    };

    design.SpacedParagraph {
      "Simply stated, a style method is reusable code that formats document content. ";
      "Such code can be as simple as a paragraph that sets text color, or as complicated as a table or chart that lays out content in a complex view. ";
    };

    design.SpacedParagraph {
      "A style template is a grouping of one or more style methods designed to work together in formatting document content. ";
      "In Nytril, such an arrangement could be designed in either a "; design.SpanHighlight { "namespace" }; " or a "; design.SpanHighlight { "class" }; ". ";
      "A robust system is best designed using a class architecture to take advantage of object oriented programming. ";
    };

    design.SpacedParagraph {
      "With a set of styling methods established, document content is then generated using those styling methods, rather than raw Nytril formatters. ";
      "You can imagine, then, that having two or more styling templates using methods with the same names would allow the entire document to be restyled by simply changing the style reference. ";
    };

    design.SpacedParagraph {
      "Styles in Nytril are very much like styles in Word. ";
      "If you take the time to assign styles to all the content, then formatting the content into another style is a simple task -- just change the style reference. ";
    };
  };
}
//==================================================================================
// Implement Template
//==================================================================================

readonly DesignTemplateImplementationSection DesignTemplateImplementation = new;
class DesignTemplateImplementationSection: Content {
  Constructor {
    super.Constructor("Implement Tech Design Template");
  }

  override GetLayout(TechDesign design) = Block {
    design.Heading4 {
      Title;
    };

    ImplementationPurp.GetLayout(design);
    ImplementSetup.GetLayout(design);
  };
}
//==================================================================================

readonly ImplementationPurpose ImplementationPurp = new;
class ImplementationPurpose: Content {
  Constructor {
    super.Constructor("Purpose");
  }

  override GetLayout(TechDesign design) = Block {
    design.Heading2 {
      Title;
    };

    design.SpacedParagraph {
      "The Tech Design styling template is a free simple set of styles that can be used to not only style documents, but also and more importantly as a template to establish a styling system for your organization. ";
      "This style template includes four variations of the base template type and comes with a toolbar design that allows the templates to be changed via a slider. ";

    };
    design.SpacedParagraph {
      "Nytril aims to keep these types of development concepts in the hands of developers, allowing full control and creative flexibility, rather than deploying built-in rigid systems. ";
      "This template provides a good starting point for an organizational styling template. ";
    };
  };
}
//==================================================================================

readonly ImplementationSetup ImplementSetup = new;
class ImplementationSetup: Content {
  Constructor {
    super.Constructor("Setup");
  }

  override GetLayout(TechDesign design) = Block {
    design.Heading2 {
      Title;
    };

    design.SpacedParagraph {
      "Setting up an existing Nytril provided style template system is easy. ";
      "The best way is the create a new probject using the provided \"Tech Design Template\". ";
      "Launching this template will copy all the necessary files into the folder where you create the project and will scaffold the project with a few sample styles. ";
    };

    design.SpacedParagraph {
      "Once created, use the slider at the top to witness how the syles change dynamically. ";
      "This toolbar (see "; design.FigureReference(TechDesignToolbarPicFig); ") is optional and can be turned off by setting \"ShowDesignControls\" to false in the \"TechDesign\" class. ";
    };

    design.SpacedParagraph {
      "The scaffolded project will have two documents available to view via the "; design.SpanHighlight{"Documents"}; " menu. ";
      "Note the document entitled, \""; design.Emphasis{"Design Palette Samples"} ",\" which contains a full list of all the available and customizable named color themes (see the Color Palette feature for more). ";
    };

    design.AddFigure(TechDesignToolbarPicFig, Here);
  };
}
