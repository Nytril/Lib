using Format, Units;

readonly MyDocument Main.Documents.MainDocument = new;

var BoxLength  = 6';
var BoxWidth   = 20';
var BoxDepth   = 4";
var BagVolume  = 1.5 feet^3;

class MyDocument: DocumentEntry {
  Constructor {
    super.Constructor(#00000000-1111-2222-3333-444444444444#, "Wood Chips");
  }

  Out(name, value) = Row {
    Bold name;
    value;
  };

  override GetDocument = Document {
    Paragraph {
      TextHeight: 14pt;
      "Calculate the number of wood chip bags needed for a plot";
    };
    Table(null, PadR(10), [Column.Fit(2")]) {
      LeftIndent: 8pt;
      Out("Length", BoxLength);
      Out("Width", BoxWidth);
      Out("Depth", BoxDepth);
      Out("Each Bag", BagVolume);

      var volume = (BoxLength * BoxWidth * BoxDepth) tounit feet^3;
      Out("Volume", volume);
      Out("Bags", Math.Ceiling(volume.DivideUnits(BagVolume tounit feet^3)));
    }
  };
}

