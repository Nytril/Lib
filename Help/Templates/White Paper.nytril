//===============================================================

class HomePage: SitePage {
  Constructor {
    super.Constructor(Main.Site, #02000000-1111-2222-3333-444444444444#, "Home", PaperContent.Reference.Subtitle);
    Description = "Create a report or a scientific white-paper";

    Tiles = [
      new DocTile(Main.Documents.Paper, Icons.assessment, "Paper"),
      new DocTile(Main.Documents.Intro, Icons.tour, "Introduction"),
    ];
  }

  override GetHeader = Block {
    Paragraph {
      TextHeight: 40pt;
      NytrilStyle.SiteIcon(Icons.article);
      Space;
      Name;
    };
    Paragraph {
      SpaceAfter: 30;
      TextHeight: 20pt;
      Description;
    };
  };
}

