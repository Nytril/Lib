class PaperContentClass: AuthoredContent {
  Constructor {
    super.Constructor("White Paper", MP26);

    Watermark             = "DRAFT";
    SignificanceStatement = PaperSections.Significance;
    Abstract              = PaperSections.Abstract;
    Acknowledgements      = PaperSections.Acknowledgements;

    Keywords = ["Frustation", "Anxiety", "Cost"];

    SetCorrespondant(People.WhiffMulligan);

    AddContent(PaperSections.Introduction);
    AddContent(PaperSections.Methods);
    AddContent(PaperSections.Results);
    AddContent(PaperSections.Conclusion);
  }
}

//======================================================================

class IntroPresentation: SlideShow {
  Constructor(Guid id) {
    super.Constructor(id, "Intro", new FancyDesign, new OUPStyle(Organizations.OxfordPress, None), [People.WhiffMulligan]);
    Title = PaperContent.Title;
  }

  override InitDocument = {
    Style.SansSerif;
    TextHeight: 16pt;
    Link to References;
  };

  override void CreateSlides {
    AddFigureSlide(PaperSections.Abstract);
    AddFigureSlide(PaperSections.Introduction);
    AddFigureSlide(PaperSections.Walking);
    AddFigureSlide(TableFigures.HandicapTable);
    AddFigureSlide(TableFigures.HandicapChart);
    AddFigureSlide(PaperSections.Conclusion);
    AddSlide(new EndSlide("Questions"));
    AddFigureSlide(PaperSections.Acknowledgements);
    AddSlide(new ReferenceSlide);
  }
}

