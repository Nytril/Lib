//======================================================================

class GolfScore {
  var int    Handicap;
  var double Average,
             FairwayHit;

  Constructor(int handicap, double ave, double hit) {
    Handicap   = handicap;
    Average    = ave;
    FairwayHit = hit;
  }
}

readonly GolfScore[] Scores = [
  new(0, 4.2, 50%),
  new(5, 4.5, 48%),
  new(10, 4.8, 45%),
  new(15, 5.1, 43%),
];

//======================================================================

readonly HandicapTable TableFigures.HandicapTable = new;

class HandicapTable: Content {
  Constructor {
    super.Constructor("Handicap Table");
  }

  override GetCaption(ContentStyle style) = Span {
    "Correlation between handicap and hit percentage.";
  };

  override GetBody(ContentStyle style) = Table(0.5, PadAll(2) + PadLR(4), [Column.Fit(2.5")]*3) {
    ParAlignment: Center;
    Row(BorderB(0.25)) {
      VAlign: Center;
      Background: Colors.Navy;
      TextColor: Colors.White;
      Bold;
      style.SansSerif;
      "Handicap"; "Average\nPar-4 Score"; "Fairway Hit %";
    };
    foreach (var score in Scores) {
      Row {
        if (each0 mod 2 == 1)
          Background: 95%;
        score.Handicap;
        score.Average;
        score.FairwayHit;
      };
    }
  };
}

//======================================================================

readonly HandicapChart TableFigures.HandicapChart = new;

class HandicapChart: Content {
  Constructor {
    super.Constructor("Handicap Chart");
  }

  override GetCaption(ContentStyle style) = Span {
    "Handicap versus average par-4 score.";
  };

  override GetBody(ContentStyle style) = Chart(100%, 2") {
    XLabel: "Handicap";
    XAxis: ChartAxis {
      (each (each (each Scores).Handicap)) as string;
    };

    ValueAxis: ChartAxis {
      MinorTics: true;
    };

    ValueLabel: HBox {
      Transform: Transform.Rotate(90 degrees);
      TransformFit: true;
      "Hit %";
    };

    ChartSeries {
      ChartType: Line;
      Marker: Markers.Circle(Colors.White, 3);

      foreach (var score in Scores)
        score.Average;
    }
  };
}

