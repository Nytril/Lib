include "Help";

using Format;

Description = DescriptionBlock {
  Paragraph {
    "The HBox aligns its children from left to right in order of occurance. ";
    "If there is a VAlign (or VAlignment for a child) and the HBox has a specified Height then the children will be aligned as directed. ";
  };
};

Example = HBox(null, null, new Edge(10, 0, 90%)) {
  "Text";
  Canvas(10, 20, 1);
  Canvas(20, 10, 2);
};

Example2 = HBox(null, 60, new Edge(3, 0, 90%)) {
  VAlign: Center;
  Span {TextHeight: 20pt; "Text"};
  Canvas(10, 20, 1);
  Canvas(20, 10, 2);
};

Main.Help = new HelpExample(attribute Format.HBox, 2);
