include "Help";

using Format;

Description = DescriptionBlock {
  Paragraph {
    "Documents are created by first defining a {0} object "(NytrilStyle.Class(attribute DocumentEntry));
    "which overrides the {0} function. "(NytrilStyle.PropName(attribute DocumentEntry.GetDocument));
  };
};

SampleCode = Document {
  "Hello World";
};

Example = Block {
  Empty;
  VBox(2", 2.3", 1) {
    HBox(null, null, PadLT(0.25")) {
      "Hello World";
    };
  };
};


Main.Help = new HelpExample(attribute Document, 0);
