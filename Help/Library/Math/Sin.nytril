include "Help";

using Format;

Range = 0..Math.PI2;

Description = DescriptionBlock {
  Chart(100%, 2") {
    ChartType: ChartTypes.Line;
    XAxis: ChartAxis {
      TextDigits: 2;
      Range step Math.PI/6;
    };
    ChartSeries {
      foreach (var x in Range step Math.PI/24)
        new DataPoint(x, Math.Sin(x));
    };
  };
};

ShowSin(x) = Span {
  TextDigits: 8;
  "The sine of {0} is {1}."(x, Math.Sin(x));
};

Example = Block {
  ShowSin(0);
  ShowSin(Math.PI / 3);
  ShowSin(Math.PI / 2);
};

Main.Help = new HelpExample(attribute(Math.Sin));


