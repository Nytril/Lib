include "Help";

using Format;

ShowMean(a) = Paragraph {
  "The median of ";
  Span {
    Separator: CommaSpace;
    LastSeparator: " and ";
    a;
  };
  " is ";
  Math.Median(a);
};

Example = Block {
  ShowMean([1, 2, 4, 6, 7, 8, 23]);
  ShowMean([2, 5, 5, 6, 12, 18]);
  ShowMean([-12, -5, 2, 18]);
};

Main.Help = new HelpExample(attribute(Math.Median));


