include "Help";

using Format;

Range = 0..100;

Description = DescriptionBlock {
  EquationPar {
    Symbol("y");
    Tex.Equals;
    Radical {Symbol("x")};
  };

  "x must be a positive number";

  Chart(100%, 2") {
    ChartType: ChartTypes.Line;
    XAxis: ChartAxis {
      TextDigits: 1;
      Range step Math.PI/6;
    };

    ValueAxis: ChartAxis {
      TextDigits: 0;
    };

    ChartSeries {
      foreach (var x in Range step Math.PI/128)
        new DataPoint(x, Math.Sqrt(x));
    };
  };
};

ShowSqrt(x) = Span {
  "The square root of {0} is {1}."(x, Math.Sqrt(x));
};

Example = Block {
  ShowSqrt(4);
  ShowSqrt(125);
};

Main.Help = new HelpExample(attribute(Math.Sqrt));


