include "Help";

using Format;

Description = EquationPar {
  var x = Symbol("x");
  var i = Symbol("i");
  var N = Symbol("n");

  Tex.sigma^2;
  Tex.Equals;
  Fraction {
    Nary {
      Upper: N;
      Lower: i;
      Operator: Tex.sum;
      (x sub i - Span {TextOverline: true; x})^2
    };
    N;
  };
};

ShowVariance(values) = ShowValues("variance", values) {
  Math.Variance(values);
};

Example = Block {
  ShowVariance([2, 3, 3, 4]);
  ShowVariance([2, 5, 6, 12]);
};

Main.Help = new HelpExample(attribute(Math.Variance));


