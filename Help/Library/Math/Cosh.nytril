include "Help";

using Format;

Range = -Math.PI2..Math.PI2;

Description = DescriptionBlock {
  EquationPar {
    var x = Symbol("x");
    Symbol("y");
    Tex.Equals;
    Fraction {
      Symbolic.E sup x + Symbolic.E sup -x;
      2;
    };
  };

  Chart(100%, 2") {
    ChartType: ChartTypes.Line;
    XAxis: ChartAxis {
      TextDigits: 1;
      Range step Math.PI/6;
    };

    ValueAxis: ChartAxis;

    ChartSeries {
      foreach (var x in Range step Math.PI/16)
        new DataPoint(x, Math.Cosh(x));
    };
  };
};

ShowCosh(x) = Span {
  TextDigits: 8;
  "The hyperbolic cosine of {0} is {1}."(x, Math.Cosh(x));
};

Example = Block {
  ShowCosh(0);
  ShowCosh(Math.PI / 3);
  ShowCosh(Math.PI / 2);
};

Main.Help = new HelpExample(attribute(Math.Cosh));


