include "Help";

using Format;

Range = -5..5;

Description = DescriptionBlock {
  Chart(100%, 2") {
    ChartType: ChartTypes.Line;
    XAxis: ChartAxis {
      Range step 1;
    };
    ValueAxis: ChartAxis;

    ChartSeries {
      foreach (var x in Range step 0.1)
        new DataPoint(x, Math.Atan(x));
    };
  };
};

ShowAtan(x) = Span {
  "The arc tangent of {0} is {1}."(x, Math.Atan(x));
};

Example = Block {
  ShowAtan(10);
  ShowAtan(0);
  ShowAtan(Math.PositiveInfinity);
  ShowAtan(Math.NegativeInfinity);
};

Main.Help = new HelpExample(attribute(Math.Atan));


