include "Help";

using Format;

Description = DescriptionBlock {
  "The width of the object can be specified in the following ways:";
};

readonly namespace Example {
  Header = MeasureText.UseMeasure;
  Body = VBox {
    Separation: 10;
    HBox(0.25", 4, 1);
    HBox(8mm, 4, 1);
    HBox(24pt, 4, 1);
  };
}

readonly namespace Example2 {
  Header = MeasureText.UseNumber;
  Body = HBox(96, 4, 1);
}

readonly namespace Example3 {
  Header = MeasureText.UsePercentWidth;
  Body = HBox(50%, 4, 1);
}

Main.Help = new HelpExample(null, 3, "width");

