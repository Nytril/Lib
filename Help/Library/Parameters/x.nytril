include "Help";

using Format;

Description = DescriptionBlock {
  "The x offset of an object can be specified in the following ways:";
};

MakeExample(x) = Canvas(1.5", 0.6", BorderLR(0.25)) {
  Separation: 10;
  HBox {
    VAlign: Center;
    X: x;
    HBox(4, 4) {
      BorderRadius: 2;
      Background: Colors.Red;
    };
    " X = ";
    x;
  };
};

readonly namespace Example {
  Header = MeasureText.UseNumber;
  Body = MakeExample(10);
}

readonly namespace Example2 {
  Header = MeasureText.UseMeasure;
  Body = MakeExample(0.25");
}

readonly namespace Example3 {
  Header = MeasureText.UsePercentWidth;
  Body = MakeExample(10%);
}

Main.Help = new HelpExample(null, 3, "x");

