  BatterRising = new(#80750a60-7dba-4026-8d36-296325d4aefd#, "Baked goods rising",
    [TartaricAcid.Aqueous, SodiumBiCarbonate.Aqueous],
    [SodiumTartrate, Water, CarbonDioxide]
   );
}

