using Format, Units, AtomicElements, ChemicalCompounds, LinkTypes;

enum MatterStates {
  var Abreviation;

  Constructor(name, ab) {
    super.Constructor(name);
    Abreviation = ab;
  }

  override GetLayoutNode = HBox(null, null, new Edge(0.5, 2)) {
    Background: Colors.LightBlue;
    BorderRadius: 1;
    TextColor: Colors.White;
    Label;
    Tip: this;
  };


  None("None", null),
  Solid("Solid", "s"),
  Liquid("Liquid", "l"),
  Gas("Gas", "g"),
  Plasma("Plasma", "p"),
  Aqueous("Aqueous", "aq"),
  Unknown("Unknown", "u"),
}

enum ElementOrigins {
  Primordial("Primordial"),
  FromDecay("From decay"),
  Synthetic("Synthetic"),
}

enum ElementBlocks {
  override GetLayoutNode = HBox(null, null, new Edge(0.5, 2)) {
    Background: Colors.SteelBlue;
    TextColor: Colors.White;
    Label;
    Tip: this;
  };

  Sblock("S-block"),
  Dblock("D-block"),
  Pblock("P-block"),
  Fblock("F-block"),
}

enum MatterTypes {
  var Color BackColor;

  Constructor(name, Color color) {
    super.Constructor(name);
    BackColor = color;
  }

  override GetLayoutNode = VBox(null, null, new Edge(0.5, 2)) {
    Background: BackColor;
    Label;
    Tip: this;
  };

  Unknown("Unknown", Colors.White),
  AlkaliMetal("Alkali metal", #FFC9C9#),
  AEMetal("Alkaline-earth metal", #D2D2FF#),
  TMetal("Transition metal", #B9DDFF#),
  PTMetal("Post-transition metal", #C5FFC5#),
  Halogen("Halogen", #FFFFB9#),
  Metalloid("Metalloid", #DEECB8#),
  NonMetal("Non-metal", #FFFFBB#),
  NobleGas("Noble gas", #FFE2B9#),
  Lanthanide("Lanthanide", #ADFFFF#),
  Actinide("Actinide", #C1FFEB#),
}

//==================================================================================================

class AtomicElement: Fact {
  field string         Name,
                       Symbol;
  field int            AtomicNumber,
                       Group,
                       Period;
  field ElementBlocks  Block;
  field MatterTypes    Type;
  field double         Density,
                       AtomicWeight,
                       HeatCapacity,
                       Negativity,
                       Abundance;
  field Measure        MeltingPoint,
                       BoilingPoint;
  field MatterStates   State;
  field ElementOrigins Origin;
  field string         EConfiguration,
                       Notes;
  field DateTime       Discovered;
  var int              SubGroup;
  var int[]            OxidationStates;

  Constructor(int z, sym, name, Guid id, MatterTypes type, DateTime disc, group, period, subgroup, ElementBlocks block, econfig, int[] oxidation, weight, density, melting, boiling, heat, neg, abundance, ElementOrigins origin, MatterStates state, string notes=null) {
    super.Constructor(id);
    Block           = block;
    Group           = group;
    SubGroup        = subgroup;
    Period          = period;
    EConfiguration  = econfig;
    Discovered      = disc;
    Type            = type;
    AtomicNumber    = z;
    Symbol          = sym;
    Name            = name;
    Notes           = notes;
    Density         = density;
    AtomicWeight    = weight;
    OxidationStates = oxidation;
    if (melting is valid)
      MeltingPoint = melting Kelvin;
    if (boiling is valid)
      BoilingPoint = boiling Kelvin;
    HeatCapacity    = heat;
    Negativity      = neg;
    Abundance       = abundance;
    State           = state;
    Origin          = origin;
  }

  override Icon GetIcon {
    return Icons.filter_vintage;
  }

  static operator Affinity(AtomicElement e, int number) {
    return new ElementNumber(e, number);
  }

  static operator Affinity(int number, AtomicElement e) {
    return new CompoundNumber(e.GetCompound(1), number);
  }

  Compound GetCompound(int number) = new(FactId, Name, [new(this, number)], State);

  Isotope(weight) = Nary {
    PreUpper: weight;
    PreLower: AtomicNumber;
    Operator: Span {TextHeight: 150%; GetLayoutSpan};
  };

  GetTile(width, height, Stroke stroke) = Canvas(width, height, new Edge(stroke.Size, width * 0.05, stroke.Fill)) {
    Shadow: new Edge(1, 0, Colors.DarkGray);
    Tip: this;
    TextFamily: TextFamilies.Arial;
    Background: Type.BackColor;

    var h = Math.Min(height * 0.4, width * 0.4);

    HBox {
      TextHeight: height * 0.08;
      Bold;
      HAlignment: Left;
      VAlignment: Top;
      TextHeight: h * 0.4;
      AtomicNumber;
    };
    HBox {
      HAlignment: Right;
      VAlignment: Top;
      TextHeight: h * 0.3;
      AtomicWeight;
    };
    HBox {
      HAlignment: Center;
      VAlignment: Center;
      TextHeight: h;
      Symbol;
    };
    VBox {
      HAlign: Center;
      HAlignment: Center;
      VAlignment: Bottom;
      Span {
        TextHeight: Math.Min(h * 0.3, width / Name.Length * 1.7);
        Name;
      };
      Span {
        var name = Type.Label;
        TextColor: #101010#;
        TextHeight: Math.Min(h * 0.3, width / name.Length * 1.65);
        name;
      }
    };
  };

  ShowOxidationStates = Span {
    Separator: Space;
    foreach (var s in OxidationStates) {
      if (s > 0)
        "+{0}"(s);
      else
        s;
    }
  };

  override GetLayoutSpan = Span {
    Symbol;
    Tip: this;
  };

  override GetLayoutNode = HBox(40, 40, new Edge(0.5, 2, 85%)) {
    Background: new RadialGradient(0.5, 0.5, 0.5, 0.5, 0.5, 0.5,
      [new(0, Colors.White),
       new(0.6, 85%),
       new(0.7, Colors.White),
       new(0.8, 85%),
       new(0.9, Colors.White),
       new(100%, 85%)]
    );

    BorderRadius: 20;
    HAlign: Center;
    VAlign: Center;
    TextHeight: 12pt;
    TextOffset: -10%;
    Bold; Symbol;
    Tip: this;
  };

  override GetLayoutTip = VBox(4 inch) {
    HAlign: Center;

    GetTile(2 inch, 2.25 inch, new Stroke(0.25, Colors.LightGray)) {
      BorderRadius: 8;
    };

    Frame {
      Margin: PadT(10);
      TextHeight: 14pt;
      Table(null, PadR(5), [Column.Fit(2 inch), Column.Fit(2 inch)]) {
        Row {
          Bold "Electron Configuration";
          EConfiguration;
        };
        Row {
          Bold "Oxidation States";
          ShowOxidationStates;
        };
        if (MeltingPoint is valid) {
          Row {
            Bold "Melting point";
            MeltingPoint;
          };
        }
        if (BoilingPoint is valid) {
          Row {
            Bold "Boiling point";
            BoilingPoint;
          };
        }
        if (Discovered is valid) {
          Row {
            Bold "Discovered";
            Discovered;
          };
        }
      };
      Paragraph;
      Paragraph {
        Bold "Name derivation: ";
        Notes;
      };
    }
  };
}

//==================================================================================================

PeriodicTable(width, height) = Canvas(width, height) {
  var outline = new Stroke(0.125, Colors.LightGray);
  var d       = height * 0.005;
  var top     = d * 4;
  var left    = d * 3;

  width -= left;
  var cw = (width - d * (17 - 1)) / 18;
  var ch = (height - top - d * 8) / 9;
  var dx = cw + d;
  var dy = ch + d;

  foreach (var e in AtomicElements) {
    var period   = e.Period;
    var group    = e.Group;
    var subgroup = e.SubGroup;

    if (period > 5 and subgroup is valid) {
      group  += subgroup + 1;
      period += 2;
    }

    var x = left + (group -1) * dx;
    var y = top + (period - 1) * dy;

    if (period <= 7 and group == 1) {
      HBox(left) {
        TextHeight: left;
        Y: y + ch*0.44;
        period;
      };
    }

    if ((period == 1 and (group == 1 || group == 18)) or (period == 2 and (group == 2 || (group >= 13 and group <= 17))) or (period == 4 and (group >= 3 and group <= 12))) {
      HBox(left) {
        TextHeight: left;
        Y: y - top;
        X: x + cw*0.4;
        group;
      };
    }

    if (e is not null) {
      e.GetTile(cw, ch, outline) {
        BorderRadius: d * 0.25;
        X: x;
        Y: y;
      }
    }
  }

  var x = left + 2 * dx;
  var y = top + 5 * dy;
  Shape(MatterTypes.Lanthanide.BackColor, outline) {
    ClosedPath(x, y) {
      var x1 = x + cw;
      var y1 = y + 2 * dy;
      LineTo(x1, y1);
      LineTo(x1, y1 + ch);
      LineTo(x, y + ch);
    }
  };

  y = top + 6 * dy;
  Shape(MatterTypes.Actinide.BackColor, outline) {
    ClosedPath(x, y) {
      var x1 = x + cw;
      var y1 = y + 2 * dy;
      LineTo(x1, y1);
      LineTo(x1, y1 + ch);
      LineTo(x, y + ch);
    }
  };
};

ElementPropertiesTable = Table(0.5pt, PadLR(2), [Column.Fit(2 inch)]) {
  TextHeight: 10pt;
  Row(BorderB(0.5)) {
    Bold;
    Empty;
    Empty;
    "Name";
    "Weight";
    "Oxidation States";
    "e" sup "-" " Configuration";
    "eNeg";
    Span {"Mp"; Tex.degree; "K"};
    Span {"Bp"; Tex.degree; "K"};
  };
  foreach (var e in AtomicElements) {
    Row {
      Background: e.Type.BackColor;
      e.AtomicNumber;
      e.Symbol;
      Span {e.Name; Tip: e};
      e.AtomicWeight;
      e.ShowOxidationStates;
      e.EConfiguration;
      e.Negativity;
      if (e.MeltingPoint is valid)
       e.MeltingPoint toscale Kelvin;
      if (e.BoilingPoint is valid)
       e.BoilingPoint toscale Kelvin;
    };
  }
};

//==================================================================================================

