//==================================================================================================

class ElementNumber {
  var AtomicElement Element;
  var int           Number;

  Constructor(AtomicElement e, int number=1) {
    System.Assert(e is valid);
    Element = e;
    Number  = number;
  }

  Show(bool hint) = Span {
    hint ? Element : Element.Symbol;
    if (Number > 1) {
      Span {
        TextAlignment: Subscript;
        Number;
      }
    }
  };

  static implicit operator ElementNumber(AtomicElement e) = new(e, 1);

  override GetLayoutSpan = Show(true);

  override GetLayoutTip = Show(true);
}

//==================================================================================================

class Compound: Fact {
  field string        Name,
                      CommonName;
  field MatterStates  State;
  var ElementNumber[] Components;

  Constructor(Guid id, name, ElementNumber[] components, MatterStates state, commonname=null) {
    super.Constructor(id);
    Name       = name;
    State      = state;
    CommonName = commonname;
    Components = components;
    Link.Connect(this, (each components).Element);
  }

  override Icon GetIcon {
    return Icons.polyline;
  }

  static operator Affinity(int number, Compound c) {
    return new CompoundNumber(c, number);
  }

  static operator Affinity(Compound c, int number) {
    System.Assert(false);
    return new CompoundNumber(c, number);
  }

  static implicit operator Compound(AtomicElement e) = e.GetCompound(1);

  CompoundNumber Aqueous = new(this, 1, MatterStates.Aqueous);
  CompoundNumber Gas     = new(this, 1, MatterStates.Gas);

  Formula = Span {
    TextEquation: true;
    Components;
  };

  Show(MatterStates state, bool hint) = Span {
    (each Components).Show(hint);
    if (state == MatterStates.None)
      state = State;
    if (state != MatterStates.None) {
      Span {
        TextAlignment:Subscript;
        "(";
        state.Abreviation;
        ")"
      };
    }
  };

  override GetLayoutSpan = Show(None, false);

  FullName = Span {
    Name;
    if (CommonName is valid)
      " - \"{0}\""(CommonName);
  };

  override GetLayoutTip = Block {
    Paragraph {
      TextHeight: 110%;
      Bold;
      FullName;
    };
    Formula;
  };

  override GetLayoutNode = VBox(null, null, new Edge(0.5, 3, Colors.DarkGreen)) {
    Background: #D0EED0#;
    BorderRadius: 5;
    HAlign: Center;
    Span {
      TextColor: 40%;
      CommonName ?? Name;
    };
    Formula;
    Tip: this;
  };

  override GetLayoutBlock = Block {
    Paragraph {
      FullName;
    };
    Paragraph {
      LeftIndent: 8pt;
      Formula;
    }
  };

  override GetLayoutFact = GetLayoutBlock;
}

//==================================================================================================

class CompoundNumber {
  var Compound     Compound;
  var int          Number;
  var MatterStates State;

  Constructor(Compound c, int number=1, MatterStates state=MatterStates.None) {
    Compound = c;
    Number   = number;
    State    = state == MatterStates.None ? c.State : state;
  }

  static operator Affinity(int number, CompoundNumber c) {
    return new CompoundNumber(c.Compound, number, c.State);
  }

  static implicit operator CompoundNumber(Compound c) {
    return new(c, 1, c.State);
  }

  static implicit operator CompoundNumber(AtomicElement e) {
    return new(e.GetCompound(1), 1, e.State);
  }

  override GetLayoutSpan = Span {
    if (Number > 1) {
      Number;
      Tex.hairspace;
    }
    Span {
      Compound.Show(State, false);
      Tip: this;
    };
  };

  override GetLayoutTip = Block {
    TextHeight: 16pt;
    Paragraph {
      TextHeight: 110%;
      Bold;
      Compound.FullName;
      " ({0})"(State);
    };
    Compound.Formula;
  };
}

//==================================================================================================

readonly LinkType ReagentLink  = new(ChemicalReaction, Compound, "Reagent");
readonly LinkType ReactionLink = new(ChemicalReaction, Compound, "Product");

class ChemicalReaction: Fact {
  enum ReactionTypes {
    override GetLayoutNode = VBox(null, null, new Edge(0.5, 2)) {
      Background: Colors.SandyBrown;
      BorderRadius: 1;
      TextColor: Colors.White;
      Name;
      Tip: this;
    };

    Directed,
    Bidirectional,
  }

  field string         Name;
  field ReactionTypes  ReactionType;
  var CompoundNumber[] Left,
                       Right;

  Constructor(Guid id, name, CompoundNumber[] left, CompoundNumber[] right, ReactionTypes type=ReactionTypes.Directed) {
    super.Constructor(id);
    Name         = name;
    ReactionType = type;
    Left         = GetCompounds(left, ReagentLink);
    Right        = GetCompounds(right, ReactionLink);
  }

  override Icon GetIcon {
    return Icons.science;
  }

  CompoundNumber[] GetCompounds(CompoundNumber[] list, LinkType link) {
    foreach (var v in list)
      link.Connect(this, v.Compound);
    return list;
  }

  override GetLayoutBlock = Block {
    Paragraph {
      KeepWithNext: true;
      SpaceBefore: 4pt;
      TextHeight: 120%;
      Bold;
      Name;
    };
    Paragraph {
      LeftIndent: 8pt;
      GetLayoutSpan;
    }
  };

  override GetLayoutNode = VBox(null, null, new Edge(0.5, 4, Colors.DarkGray)) {
    Background: Colors.Beige;
    BorderRadius: 5;
    Span {
      Icons.science; Space; Name;
    };
    Tip: this;
  };

  override GetLayoutSpan = Span {
    TextEquation: true;
    Span {
      Separator: Tex.Plus;
      Left;
    };
    var icon = ReactionType == ReactionTypes.Bidirectional ? Tex.rightleftarrows : Tex.rightarrow;
    Span {
      icon;
      Tip: Span {TextHeight: 16pt; "Reagents"; icon; "Products"};
    };
    Span {
      Separator: Tex.Plus;
      Right;
    };
  };

  override GetLayoutTip = GetLayoutBlock;

  override GetLayoutFact = GetLayoutBlock;
}

