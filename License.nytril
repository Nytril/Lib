using Format;

include "Lang";
include "NytrilStyle";

//======================================================================

abstract class LegalDocument: DocumentEntry {
  protected Constructor(Guid id, name) {
    super.Constructor(id, name);
  }

  abstract GetBody;

  override GetDocument = Document(0.75") {
    TextHeight: 11pt;
    SpaceAfter: 3pt;
    ParAlignment: Justify;
    GetBody;
  };

  LinkPar(url) = Paragraph {
    LeftIndent: 24pt;
    Span {
      TextColor: NytrilPalette.Hyperlink;
      new URL(url);
    };
  };

  MainSection(number, text) = Paragraph {
    Span {
      Bold;
      number;
      DotSpace;
      Span {
        TextCase: AllUpper;
        text;
      };
      DotSpace;
    }
  };

  SubSection(number, title) = Paragraph {
    Span {
      Bold;
      Enumerators.Alpha(number);
      DotSpace;
      title;
      DotSpace;
    };
  };

  SubSubSection(number, title) = Paragraph {
    LeftIndent: 32pt;
    Span {
      Bold;
      "(";
      Enumerators.Roman(number);
      ") ";
      title;
      DotSpace;
    };
  };

  OneBlock = Block {
    LeftIndent: 12pt;
  };

  Heading1 = Paragraph {
    SpaceBefore: 12pt;
    TextHeight: 14pt;
    LeftIndent: -16pt;
    TextFamily: TextFamilies.Calibri;
    Bold;
  };

  ListFormat = ListBlock {
    SpaceAfter: 4pt;
  };

  TitleFormat = Paragraph {
    SpaceAfter: 12pt;
    ParAlignment: Center;
    Bold;
    TextHeight: 16pt;
  };
}

//======================================================================

class DisclaimersDocument: LegalDocument {
  Constructor {
    super.Constructor(#224765f2-8818-45b8-bfd1-b0cec67ae9d7#, Lang.TradmarkLicense);
    Description = Lang.CopyrightsTrademarks;
  }

  override GetBody = Block {
    Heading1 {
      Lang.Trademarks;
    };

    Paragraph {
      "© "; DateTime.Now.Year;
      Space;
      Lang.NytrilCompanyName;
      DotSpace;
      Lang.AllRightsReserved;
      DotSpace;
    };

    Paragraph {
      SpaceAfter: 10pt;
      Lang.IsRegisteredTrademark("Nytril®", Lang.NytrilCompanyName);
      DotSpace;
    };

    Heading1 {
      Lang.Licenses;
    };

    Paragraph {
      "The Material Icon Font is licensed under the Apache License, Version 2.0 (the \"Apache License\"); ";
      "you may not use this file except in compliance with the Apache License. ";
      "This license is available at: ";
    };

    LinkPar("http://www.apache.org/licenses/LICENSE-2.0");

    Paragraph {
      "Unless required by applicable law or agreed to in writing, software distributed under the Apache License is distributed on an \"AS IS\" BASIS, WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied. ";
      "See the Apache License for the specific language governing permissions and limitations under the Apache License.";
    };

    Paragraph {
      "The Computer modern fonts are licensed under the SIL Open Font License, Version 1.1. ";
      "This license is available at: ";
    };
    LinkPar("http://scripts.sil.org/OFL");
    Paragraph {
      "Copyright (C) Authors of original metafont fonts: Donald Ervin Knuth (cm, concrete fonts) 1995, 1996, 1997 J\"org Knappen, 1990, 1992 Norbert Schwarz (ec fonts) 1992-2006 A.Khodulev, O.Lapko, A.Berdnikov, V.Volovich (lh fonts) 1997-2005 Claudio Beccari (cb greek fonts) 2002 FUKUI Rei (tipa fonts) 2003-2005 Han The Thanh (Vietnamese fonts) 1996-2005 Walter Schmidt (cmbright fonts). "
      "Copyright (C) 2003-2009, Andrey V. Panov (panov@canopus.iacp.dvo.ru), with Reserved Font Family Name “Computer Modern Unicode fonts”. ";
    };
  };
}

//======================================================================

class StandardsDocument: LegalDocument {
  Constructor {
    super.Constructor(#38d53e51-7a3c-449e-8637-3e18800b4d37#, Lang.ContentStandards);
    Description = Lang.ContentRules;
  }

  override GetBody = Block {
    TitleFormat {
      Name;
    };

    Heading1 {
     "Purpose";
    };
    Paragraph {
     "These guidelines help us ensure a welcoming environment for our visitors. ";
     "Content or users that violate the following guidelines may be removed from the Nytril platform. "
    };

    Heading1 {
     Lang.Copyright;
    };
    Paragraph {
     "Copyright is the law that protects original works and their creators. ";
     "Only publish material that you have created or that you have permission to re-publish. ";
     "Do not publish documents you did not create or that contain text or images that someone else owns the copyright to, without permission from the copyright holder. ";
     "Nytril software provides robust methods for citing the work of others, and authors should take advantage of these features in their publications. ";
    };

    Heading1 {
     "Realm Names";
    };
    Paragraph {
     "Top-level Realm names are a global moniker in the same sense as a top-level domain on the internet. ";
     "The name of your Realm is reserved on a first-come basis, but they are subject to review by Nytril LLC and by other users. ";
     "You may not use a top-level Realm name that conflicts with a trademark of another entity without permission. ";
     "If your Realm name is found to be in conflict, you will be required to change it without delay. ";
     "In order to avoid this potentialy confusing change, please conduct a trademark search before choosing a Realm name. ";
    };

    Heading1 {
     "Explicit Content";
    };
    Paragraph {
     "Content intended to be sexually gratifying or titliating is not allowed on Nytril. ";
     "Pornography, partial or full nudity, sexually explicit content, violent or graphic material and fetish content are not allowed. ";
     "This applies to text, photographs, real-world images, dramatized, illustrated and animated content. ";
     "If it could not appear in a mainstream newspaper or magazine, it should not be published here. ";
    };

    Heading1 {
     "Harassment";
    };
    Paragraph {
     "Text or images that threaten individuals or groups, call for violence or harm, or knowingly libel or defame others is prohibited. ";
     "If it is not protected by the First Amendment in the U.S., it is not allowed here. ";
    };

    Heading1 {
     "Harmful and Deceptive Content";
    };
    Paragraph {
      "The following types of content are prohibited: ";
      ListFormat {
        SpaceAfter : 0;
        "Descriptions of harmful or dangerous acts, challenges, and pranks. ";
        "Instructions to perform activities that are meant to kill or harm others. ";
        "Maliciously mistreatment of an animal by a human and/or causing the animal to experience distress outside of standard practices such as hunting or food preparation.";
        "Instructions to make explosive devices or compounds meant to cause harm. ";
        "Instructions on how to steal goods or get unauthorized access to content, goods, software, or services that require payment. ";
        "Demonstrating how to steal credentials or compromise personal data. ";
        "Instructions for how to get nonpublic personal identifying information from others by deceiving them. ";
      }
    };

    Heading1 {
     "In Summary";
    };
    Paragraph {
     "Nytril is a forum for the creation and display of original documents from businesses, students, scientists and individual content creators. ";
     "If you would not show your work in a classroom, a business meeting or a professional journal, you should not published it here. ";
    };
  };
}

//======================================================================

class PrivacyDocument: LegalDocument {
  Constructor {
    super.Constructor(#05c7a142-e081-4f3e-8c91-b65813fab33c#, Lang.PrivacyPolicy);
    Description = Lang.HandleInformation;
  }

  readonly DPO = NytrilStyle.EmailLink(Lang.DataProtectionOfficer, NytrilData.SupportEMail);
  readonly StripeSite = new URL("https://stripe.com/privacy");

  override GetBody = Block {
    TitleFormat {
      Name;
    };
    Paragraph {
     "Nytril values its relationship with you and is committed to the protection of your personal information. ";
     "This privacy notice will inform you as to how we collect, process and look after your personal data when you visit our website and tell you about your privacy rights and how the law protects you.";
    };
    Paragraph {
     "It is important that you read this privacy notice together with any other fair processing notice we may provide on specific occasions when we are collecting or processing personal data, so that you are fully aware of how and why we are using your data. ";
     "This privacy notice supplements any other notices and is not intended to override them.";
    };
    Paragraph {
     "Various national, provincial, state and federal laws govern the collection, use and disclosure by Nytril LLC and its affiliates of personal information used for a commercial activity.";
    };
    Paragraph {
     "In accordance with the EU General Data Protection Regulation (GDPR) we have appointed a data protection officer (DPO) who is responsible for overseeing questions in relation to this privacy notice. ";
     "If you have any questions about this privacy notice, including any requests to exercise your legal rights, please contact our "; DPO; DotSpace;
    };
    Heading1 {
     Lang.PrivacyCompliance;
    };
    Paragraph {
     "In order to comply with these laws, we will:";
    };

    ListFormat {
     "Collect only that personal information which is adequate, relevant and necessary for the purposes outlined below. ";
     "Only use your personal data when the law allows us to and in a fair and transparent manner. ";
     "Most commonly we will use your personal data in the following circumstances: ";
      ListBlock("-") {
        "To process payments for services you select. ";
        "Where it is necessary for our legitimate interests (or those of a third party) and your interests and fundamental rights do not override those interests. ";
        "Where we need to comply with a legal or regulatory obligation. ";
      };
    };

    ListFormat {
     "Where relevant and necessary, obtain consent for collecting, using, and disclosing personal information, except when inappropriate (e.g. in an emergency or when consent would compromise the availability or accuracy of the information). ";
     "We will obtain your consent in a form appropriate to the sensitivity of the information and allow you to modify or withdraw your consent. ";
     "Use and disclose personal information only for the specified purposes for which it was collected, as set out below. ";
     "On request, provide you with information about the existence, use and disclosure of your personal information and provide access to that information, if reasonable. ";
     "On request, we will rectify or erase information that is inaccurate, out of date or is no longer required for the purpose(s) for which it was collected. ";
     "Ensure that any personal information is accurate and up to date, as relevant for the collection and usage purposes; use appropriate technical and organizational measures to ensure that personal information is secure; and keep the information only as long as necessary for business and legal reasons. "
    };

    Heading1 {
     "Purposes for Collection, Use, and Disclosure";
    };

    Paragraph {
     "When we collect personal information from our clients, investors and other members of the public, it will be used and disclosed for the following purposes to:";
    };

    ListFormat {
     "Establish and maintain responsible commercial relations with you";
     "Understand your service and/or project needs";
     "Develop, enhance, market or provide products and services to you";
     "Manage and develop our business and operations";
     "Meet legal and regulatory requirements"
    };

    Heading1 {
     "Types of Personal Data we Collect";
    };

    Paragraph {
     "In order to fulfil the purposes set out above, we may collect the following types of personal information through this website:";
    };
    ListFormat {
     "Identity";
     "Contact details";
     "Website usage history";
    };

    Heading1 {
     Lang.AutomaticInfoCollection;
    };

    Paragraph {
     "When you visit the site, Nytril automatically collects information, including the Internet Protocol (IP) address used to connect your computer to the Internet, browser type and version, time zone setting, browser plug-in types and versions and operating system and platform. ";
     "For example, Nytril uses IP addresses to help deliver regionally-specific content based on where you access to the Nytril site. ";
     "In addition, we receive and store certain types of usage information whenever you interact with our site, including what pages you visit, frequency of visits and activities you perform on our site. ";
     "Nytril receives and records traffic data using Google Analytics including your IP address, Nytril cookies and the page you requested. ";
     "Nytril uses this data to help diagnose problems with its server and analyze trends. ";
     "We may also use any data we collect through the site to better understand and market to our customers or website visitors.";
    };

    Paragraph {
      "We use Stripe, Inc. (Stripe) for payments, analytics, and other business services. ";
      "Stripe may collect personal data including via cookies and similar technologies. ";
      "The personal data Stripe collects may include transactional data and identifying information about devices that connect to its services. ";
      "Stripe uses this information to operate and improve the services it provides to us, including for fraud detection, loss prevention, authentication, and analytics related to the performance of its services. ";
      "You can learn more about Stripe and read its privacy policy at "; StripeSite; ".";
    };

    Heading1 {
     "Do We Use Cookies?";
    };
    Paragraph {
     "Yes, cookies are small files of numbers and letters that we transfer to your computer’s hard drive. ";
     "Some cookies used on this site are essential and are needed to ensure that the site works correctly.";
    };
    Paragraph {
     "We also use some non-essential cookies, which allow us to collect data about the number of visitors and user interaction with the site and to understand and save preferences for future visits. ";
     "This enables us to offer better site experiences and tools in the future. ";
     "This information is collected in a way which does not identify website users and no attempt is made to find out the personal identities of any of our users.";
    };
    Paragraph {
     "By accessing and using our website you agree to our use of cookies and the collection of your personal information as described herein.";
    };
    Paragraph {
     "If you do not wish to use cookies, this feature can be disabled by changing the settings on your browser. ";
     "However, if you do disable cookies, certain parts of our site will be unavailable to you.";
    };
    Paragraph {
     "You may withdraw your consent at any time, subject to legal or contractual restrictions, by giving us reasonable notice.";
    };
    Paragraph {
     "If you have questions about the collection, use or disclosure of your personal information, you may contact Nytril LLC's "; DPO; DotSpace;
    };
    Heading1 {
     "Disclosures of your Personal Data";
    };

    Paragraph {
      "We do not share your personal data with any business or person outside of Nytril LLC except in the following cases:";
    };

    ListBlock {
      ListItem {
        "External Processing";
        "We may provide your personal data to our affiliates or third-party suppliers of general business services, including IT. ";
        "We require all third parties to respect the security of your personal data and to treat it in accordance with the law. ";
        "We do not allow our third-party service providers to use your personal data for their own purposes and only permit them to process your personal data for specified purposes and in accordance with our instructions.";
      };

      ListItem {
        "Merger, Acquisition, or Sales of Assets";
        "If a change happens to our business, then the new owners may use your personal data in the same way as set out in this privacy notice.";
      };

      ListItem {
        "Legal Reasons";
        "We may provide your personal data to parties outside Nytril LLC if we have a good-faith belief that such disclosure is reasonably necessary to:";
        ListBlock("-") {
          "Comply with or respond to a legal process, applicable law, regulation, or enforceable government request. We maintain records of all such requests. We will take reasonable efforts to ensure any legal requests for information are lawful, and will disclose only the information necessary to satisfy the request.";
          "Enforce our Content Standards, including detecting and investigating potential violations.";
          "Detect or prevent fraud, security, or other technical issues.";
          "Protect the rights, property or safety of Nytril LLC.";
          "Ensure the safety of our users, employees, or the public.";
        };
      }
    };

    Heading1 {
     "International Transfers";
    };
    Paragraph {
     "We share your personal data within Nytril. ";
     "If you are accessing this website from within the European Economic Area (EEA) this will involve transferring your data outside the EEA.";
    };
    Paragraph {
     "Some of our external third-party suppliers may be based outside the European Economic Area (EEA) so their processing of your personal data will involve a transfer of data outside the EEA.";
    };
    Paragraph {
     "Whenever we transfer your personal data out of the EEA, we ensure a similar degree of protection is afforded to it by ensuring at least one of the following safeguards is implemented:";
    };
    Paragraph {
     "We will only transfer your personal data to countries that have been deemed to provide an adequate level of protection for personal data by the European Commission. Where we use certain service providers, we may use specific contracts approved by the European Commission which give personal data the same protection it has in Europe. Where we use providers based in the US, we may transfer data to them if they are part of the Privacy Shield which requires them to provide similar protection to personal data shared between the Europe and the US. Please contact us if you want further information on the specific mechanism used by us when transferring your personal data out of the EEA.";
    };
    Heading1 {
     "Protection of Personal Information";
    };
    Paragraph {
     "Nytril will use appropriate technical and organizational security safeguards to protect your personal information against unauthorized access, use, disclosure, loss, modification or destruction. ";
     "Nytril's employees will continue to follow Nytril LLC.";
     "'s long-standing Confidentiality policy as well as other security policies and procedures.";
    };
    Heading1 {
     Lang.YourLegalRights;
    };
    Paragraph {
     "Under certain circumstances, you may have some or all of the following rights under data protection laws in relation to your personal data:";
    };
    ListBlock(@Enumerators.NumberDot) {
       "Request access to your personal data. ";
       "Request correction of your personal data. ";
       "Request erasure of your personal data. ";
       "Object to processing of your personal data. ";
       "Request restriction of processing your personal data. ";
       "Request transfer of your personal data. ";
       "Right to withdraw consent. ";
       "Delete personal data";
    };
    Paragraph {
     "Personal data can be permanently removed from this site by following all or some of these steps (depending on what information you would like to remove):";
    };
    Paragraph {
     "Through the website Cancel any ongoing subsriptions or services. To remove any voluntarily placed personal information from your account profile, access your account profile and select the \"Help people find you\" section. ";
     "Remove any or all of the previously provided information. To prevent any local storage of cookies, deselect the checkbox for \"Allow cookies for this browser\" in the \"Privacy\" section of your account profile. ";
     "Certain features of the site are not available without cookies. To remove all personal information from our servers, access your user profile, select \"Account,\" then click the \"Remove Account\" button. If you wish to exercise any of the rights set out above, please contact our "; DPO; DotSpace;
    };
    Paragraph {
     "You will not have to pay a fee to access your personal data (or to exercise any of the other rights). ";
     "However, we may charge a reasonable fee if your request is clearly unfounded, repetitive or excessive. ";
     "Alternatively, we may refuse to comply with your request in these circumstances.";
    };
    Paragraph {
     "We may need to request specific information from you to help us confirm your identity and ensure your right to access your personal data (or to exercise any of your other rights). ";
     "This is a security Measure to ensure that personal data is not disclosed to any person who has no right to receive it. ";
     "We may also contact you to ask you for further information in relation to your request to speed up our response.";
    };
    Paragraph {
     "We try to respond to all legitimate requests within one month. ";
     "Occasionally it may take us longer than a month if your request is particularly complex or you have made a number of requests. ";
     "In this case, we will notify you and keep you updated.";
    };
    Heading1 {
     "Handling Complaints";
    };
    Paragraph {
     "If you feel that Nytril is not complying with its Privacy policy or with private sector privacy laws, you may lodge a complaint with Nytril’s "; DPO; " who will investigate the complaint. ";
     "If the complaint is not resolved to your satisfaction, you may make a written request to the appropriate national, provincial, state or federal privacy or data protection officials or regulator asking them to investigate the complaint.";
    };
  };
}

//=============================================================================

class EULADocument: LegalDocument {
  Constructor {
    super.Constructor(#c2bc7028-6d2b-4c60-a658-f22c0a3e439d#, Lang.EULA);
    Description = Lang.ClickthroughLicense;
    NoCrawl     = true;
  }

  override GetBody = Block {
    TitleFormat {
      "NYTRIL SOFTWARE LICENSE TERMS";
    };
    Span {
      TextCase: AllUpper;
      Lang.NytrilDesktop;
    };
    "January, 2025";
    NytrilData.WebSite;
    Empty;

    Paragraph {
      SpaceAfter: 10pt;
      "These license terms are an agreement between you and NYTRIL. ";
      "They apply to Nytril desktop software, libraries, examples, and to any NYTRIL services, websites, or updates for the software. ";
      "If you comply with these license terms, you have the rights below."
    };

    MainSection(1, "Installation and use rights");
    OneBlock {
      SubSection(1, "Individual License") {
        "If you are a student or an individual working on your own applications, for any purpose, you may use the software to develop and test those applications. ";
        "If you are an employee of an organization or company, you may use the software for evaluation purposes for up to 30 days, after which, you must obtain a Pro Edition License. ";
      };

      SubSection(2, "Pro License") {
        "If you have purchased a Nytril Pro Edition License for yourself, or you are an employee of a company that has purchased a Pro Edition License for your use, you may use the Pro Edition software to develop and test applications and publish the resulting documents. ";
      };

      SubSection(3, "New Creators") {
        "If you are an active member of the New Creator Program, you may use the Pro Edition software to develop and test applications and publish the resulting documents to your assigned Realm. ";
      };

      SubSection(4, "Backup Copy") {
        "You may make one backup copy of the software, for reinstalling the software. ";
      };

      SubSection(5, "Online Services in the Software") {
        "Some features of the software make use of online services from nytril.com to provide you information about updates to the software or extensions, or to enable you to retrieve content, collaborate with others, or otherwise supplement your development experience. ";
        "As used throughout this agreement, the term \"software\" includes these online service features, and by using them, you consent to the transmission of information as described in Section 4, DATA.";
      };

      SubSection(6, "Demo Use") {
        "The uses permitted above include use of the software in demonstrating your applications. ";
      };

      SubSection(7, "Previews") {
        "NYTRIL may make available to you preview features or components to test or resolve technical issues. ";
        "Previews may be used consistent with your use rights to Nytril Community Edition. ";
        "Previews are experimental and may be substantially different from the commercially released version. ";
        "They may not operate correctly or work the way a final version will. ";
        "NYTRIL may change previews for the final, commercial version, if any. ";
        "NYTRIL is not obligated to provide maintenance, technical support, or updates to you for previews. ";
      };

      SubSection(8, "No liability for harm") {
        "The software is a powerful tool and can be programmed to cause damage to property including but not limited to files, databases, computers, and online systems. ";
        "NYTRIL is not responsible for any harm that is caused by programs created by you or another party. ";
      };
    };

    MainSection(2, "Terms for specific components");
    OneBlock {
      SubSection(1, "Libraries and Examples") {
        "The software contains source code Libraries and programming Examples. ";
        "You may copy, install, and deploy those items with your applications developed with the software. ";
        "NYTRIL updates Libraries and Examples with all software updates. ";
        "NYTRIL is not responsible for changes to your software that are needed to accommodate changes to the Libraries and Examples. ";
      };

      SubSection(2, "Fonts") {
        "While the software is running, you may use its fonts to display and print content. ";
        "You may only (i) embed fonts in content as permitted by the embedding restrictions in the fonts; and (ii) temporarily download them to a printer or other output device to print content. ";
      };
    };

    MainSection(3, "Distributable code") {
      "The software contains Library code that you may distribute in applications you develop as described in this Section. ";
      "The term \"distribution\" also means deployment of your applications for third parties to access over the Internet. ";
    };
    OneBlock {
      SubSection(1, "Right to Use and Distribute") {
        "The code and text files listed below are \"Distributable Code.\"";
      };
      SubSection(2, "Example Code and Libraries") {
        "You may copy, modify, and distribute the source code installed in the /Documents/Nytril folder.";
      };
      SubSection(3, "Distribution Restrictions") {
        "You may not distribute software marked \"Preview\", \"Pre-release\" or \"Beta\" or use NYTRIL's trademarks in your applications' names or in a way that suggests your applications come from or are endorsed by NYTRIL; or ";
        "modify or distribute the source code of any Distributable Code so that any part of it becomes subject to an Excluded License. ";
        "An \"Excluded License\" is one that requires, as a condition of use, modification, or distribution of code, that (i) it be disclosed or distributed in source code form; or (ii) others have the right to modify it. ";
      }
    };

    MainSection(4, "Data");
    OneBlock {
      SubSection(1, "Data Collection") {
        "While in use, the software may make online queries to suggest and facilitate software updates. ";
        "If it is provided suitable account information by the user, the software will allow user created documents to be published online. ";
        "During publication, the software will upload copies of user-designated documents, data and graphics files sufficient to allow the documents and data to be viewed and searched online. ";
        "The software may collect information about you and your preferences to facilitate account management and to provide services and improve our products and services. ";
        "Our privacy statement is located at https://www.nytril.com. ";
        "You can learn more about data collection and its use from the software documentation and our privacy statement. ";
        "Your use of the software operates as your consent to these practices. ";
      };

  //    SubSection(2, "Processing of Personal Data") {
  //      "To the extent Nytril is a processor or subprocessor of personal data in connection with the software, NYTRIL makes the commitments in the European Union General Data Protection Regulation Terms of the Nytril Products and Services Data Protection Addendum to all customers effective May 25, 2018, at https://docs.Nytril.com/legal/gdpr. ";
  //    };
    };

    MainSection(5, "Scope of license") {
      "The software is licensed, not sold. ";
      "These license terms only give you some rights to use the software. ";
      "NYTRIL reserves all other rights. ";
      "Unless applicable law gives you more rights despite this limitation, you may use the software only as expressly permitted in these license terms. ";
      "In doing so, you must comply with any technical limitations in the software that only allow you to use it in certain ways. ";
      "In addition, you may not: ";
    };
    OneBlock {
      ListBlock(@Enumerators.AlphaDot) {
        LeftIndent: 24pt;
        "Work around any technical limitations in the software;";
        "Reverse engineer, decompile or disassemble the software, or otherwise attempt to derive the source code for the software, except and only to the extent required by third party licensing terms governing use of certain open-source components that may be included with the software; ";
        ListBlock(@Enumerators.NumberParen) {
          LeftIndent: 36pt;
          "remove, minimize, block, or modify any notices of NYTRIL or its suppliers in the software; ";
          "use the software in any way that is against the law;  ";
          "share, publish, rent, or lease the software; ";
          "provide the software as a stand-alone offering or combine it with any of your applications for others to use, or transfer the software or this agreement to any third party. ";
        };
      };
    };

    MainSection(6, "Support") {
      "Because the software is \"as is,\" we may not provide support services for it. ";
    };

    MainSection(7, "Entire agreement") {
      "This agreement, and the terms for supplements, updates, Internet-based services, and support services, are the entire agreement for the software and support services. ";
    };

    MainSection(8, "Applicable law") {
      "If you acquired the software in the United States, Washington state law applies to interpretation of, and claims for breach of this agreement, and the laws of the state where you live apply to all other claims. ";
      "If you acquired the software in any other country, its laws apply. ";
    };

    MainSection(9, "Consumer rights; regional variations") {
      "These license terms describe certain legal rights. ";
      "You may have other rights, including consumer rights, under the laws of your state or country. ";
      "You may also have rights with respect to the party from which you acquired the software. ";
      "This agreement does not change those other rights if the laws of your state or country do not permit it to do so. ";
